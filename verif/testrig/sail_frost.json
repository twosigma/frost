// Sail RISC-V model settings for FROST, applied over sail_riscv_sim's default
// configuration with --config-override (tests/test_testrig.py). They describe
// FROST's implementation choices: its extensions, CSR write masks, xtval
// values, misaligned-access traps, and physical memory map, so that TestRIG
// reports only behavior the two disagree on. See verif/testrig/README.md.
{
  "base": {
    // FIOM must be writable whenever satp.MODE can leave Bare, as FROST's is.
    "writable_fiom": true,
    // Machine counters 3..10 have storage. Selectors are disabled in saved
    // traces, so microarchitectural event timing does not affect comparison.
    "writable_hpm_counters": {"len": 32, "value": "0x0000_07F8"},
    "mcounteren_writable_bits": {"len": 32, "value": "0x0000_07FF"},
    "scounteren_writable_bits": {"len": 32, "value": "0x0000_07FF"},
    "mcountinhibit": {"supported": true, "writable_bits": {"len": 32, "value": "0x0000_07FD"}},
    // riscv_pkg::MedelegMask and FROST's delegable interrupts: SSI, STI, SEI
    // and the Sscofpmf counter-overflow interrupt (13).
    "medeleg": {"delegatable_bits": {"len": 64, "value": "0x0000_0000_0000_B3FF"}},
    "mideleg": {"delegatable_bits": {"len": "xlen", "value": "0x0000_0000_0000_2222"}},
    // Without the vector unit, mstatus.VS is read-only zero; FS takes all four
    // states. The sail_frost_vlen*.json overlays turn the vector unit on.
    "mstatus": {"fs_legal_states": "ExtContext_FourState", "vs_legal_states": "ExtContext_Off"},
    // Sstvala: FROST writes the faulting instruction's bits to mtval/stval
    // for illegal instructions.
    "xtval_nonzero": {
      "illegal_instruction": true
    }
  },
  "memory": {
    // Sail starts a1 (x11) at this address, as a boot ROM would pass a device
    // tree; 0 makes every register start at zero, as on FROST after the reset
    // preamble.
    "dtb_address": {"len": 64, "value": "0x0"},
    // FROST compares whole 64-bit physical addresses, so a page-table PPN
    // or an untranslated address beyond the configured DDR aperture
    // faults instead of aliasing, and mtval holds the full address. satp.ASID
    // is nine bits wide; no PMP entries.
    "physaddr_bits": 64,
    "asidlen": 9,
    "pmp": {"grain": 0, "count": 0, "usable_count": 0, "tor_supported": true, "na4_supported": true, "napot_supported": true},
    // Misaligned accesses trap after translation and the region check: an
    // untranslated access outside every region is an access fault first, as
    // on FROST.
    "misaligned": {
      "exceptions": {"load_store": {"None": null}, "vector": {"None": null}, "amo": {"None": null}, "lrsc": {"None": null}},
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "byte_by_byte": false
    },
    // FROST's physical memory attributes (riscv_pkg::pma_* and hw/rtl/README.md).
    "regions": [
      // Low BRAM: loads, stores, and atomics; page tables live in DDR only.
      {
        "base": {
          "len": 64,
          "value": "0x0"
        },
        "size": {
          "len": 64,
          "value": "0x40000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // MMIO device pages. The TestRIG build backs them with a RAM (hw/sim/frost_rvfi_dii.sv). No atomics.
      {
        "base": {
          "len": 64,
          "value": "0x40000000"
        },
        "size": {
          "len": 64,
          "value": "0x31000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Rest of the device quadrant below the APLIC: FROST faults loads and ignores untranslated stores.
      {
        "base": {
          "len": 64,
          "value": "0x40031000"
        },
        "size": {
          "len": 64,
          "value": "0x3FCF000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": false,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // APLIC window, backed by the same RAM.
      {
        "base": {
          "len": 64,
          "value": "0x44000000"
        },
        "size": {
          "len": 64,
          "value": "0x400000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Unmapped device quadrant between the APLIC and IMSIC.
      {
        "base": {
          "len": 64,
          "value": "0x44400000"
        },
        "size": {
          "len": 64,
          "value": "0x3C00000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": false,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // IMSIC window, backed by the TestRIG device RAM, like MMIO and APLIC.
      {
        "base": {
          "len": 64,
          "value": "0x48000000"
        },
        "size": {
          "len": 64,
          "value": "0x200000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Rest of the device quadrant above the IMSIC.
      {
        "base": {
          "len": 64,
          "value": "0x48200000"
        },
        "size": {
          "len": 64,
          "value": "0x37E00000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": false,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Cached DDR: 1 GiB default at 0x8000_0000, the only region page-table walks read.
      // The TestRIG runner replaces this size for other supported capacities.
      {
        "base": {
          "len": 64,
          "value": "0x80000000"
        },
        "size": {
          "len": 64,
          "value": "0x40000000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          "supports_pte_read": true,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Sail's CLINT, which Zicntr requires, outside FROST's map at an address
      // random sequences do not form. At 0x7_FFFF_0000, just below 2^35, a
      // shifted negative number reached it (traces/clint_window_load.S).
      {
        "base": {
          "len": 64,
          "value": "0x2B6D93F10000"
        },
        "size": {
          "len": 64,
          "value": "0x10000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // cbo.zero zeroes one 64-byte block (riscv_pkg::CboZeroBlockBytes), the
    // riscv,cboz-block-size the device trees advertise.
    "cache_block_size_exp": 6,
    // A 32-byte reservation set that any store to it from this hart cancels.
    "reservation": {"reservation_set_size_exp": 5, "require_exact_reservation_addr": false, "invalidate_on_same_hart_store": true},
    "clint": {"supported": true, "base": 47749633474560, "size": 49152},
    "simple_interrupt_generator": {"supported": false, "base": 0},
    // The TestRIG build never waits in WFI (it takes no interrupts).
    "wfi_is_nop": true
  },
  "extensions": {
    // misa is read-only RV64 IMAFDC+B+S+U.
    "M": {"supported": true, "mutable_misa": false},
    "A": {"supported": true, "mutable_misa": false},
    // FROST sets mstatus.FS to Dirty when an FP instruction raises any flag,
    // even one fflags already holds.
    "F": {"supported": true, "mutable_misa": false, "fflags_dirty_policy": "Fflags_Dirty_Flag"},
    "D": {"supported": true, "mutable_misa": false},
    "B": {"supported": true, "mutable_misa": false},
    "S": {"supported": true, "mutable_misa": false},
    "U": {"supported": true, "mutable_misa": false},
    "Zba": {"supported": true},
    "Zbb": {"supported": true},
    "Zbs": {"supported": true},
    "Zbkb": {"supported": true},
    "Zicond": {"supported": true},
    "Zicntr": {"supported": true},
    "Zicsr": {"supported": true},
    "Zifencei": {"supported": true},
    "Zihintpause": {"supported": true},
    "Zca": {"supported": true},
    "Zcd": {"supported": true},
    "Sstc": {"supported": true},
    "Svade": {"supported": true},
    // Invalid-PTE refusals expire within bounded time, including on wrong paths.
    "Svvptc": {"supported": true},
    "Svbare": {"supported": true},
    "Sv39": {"supported": true},
    "C": {"mutable_misa": false},
    "V": {"support_level": "Disabled", "mutable_misa": false},
    "H": {"supported": false},
    "Zibi": {"supported": false},
    "Zic64b": {"supported": true},
    // cbo.clean/flush/inval on 64-byte blocks; menvcfg/senvcfg CBIE and CBCFE.
    // Every FROST master is coherent, so they change no data, as in Sail.
    "Zicbom": {"supported": true},
    // prefetch.i/r/w retire as ORI to x0.
    "Zicbop": {"supported": true},
    // cbo.zero zeroes 64-byte blocks (platform.cache_block_size_exp) of low
    // BRAM and cached DDR, the regions marked supports_cbo_zero above.
    "Zicboz": {"supported": true},
    // Left off: Sail requires AMO support on every coherent cacheable MainMemory region, while the TestRIG device RAM windows set AMONone.
    "Ziccamoa": {"supported": false},
    "Ziccamoc": {"supported": false},
    "Ziccif": {"supported": true},
    // Left off: TestRIG builds omit the misaligned-access engine and trap misaligned loads and stores.
    "Zicclsm": {"supported": false},
    // Left off: Sail requires RsrvEventual on every coherent cacheable MainMemory region, while the TestRIG device RAM windows set RsrvNone.
    "Ziccrse": {"supported": false},
    "Zicfilp": {"supported": false},
    "Zicfiss": {"supported": false},
    // ntl.* and c.ntl.* are add/c.add x0 hints and retire as no-ops.
    "Zihintntl": {"supported": true},
    // FROST implements Zihpm with storage on counters 3..10; user aliases
    // 11..31 read zero in M-mode and trap below M-mode, matching Sail.
    "Zihpm": {"supported": true},
    "Zilx": {"supported": false},
    // No implemented extension redefines them: mop.r.n and mop.rr.n write zero to rd.
    "Zimop": {"supported": true},
    "Zabha": {"supported": false},
    "Zacas": {"supported": false},
    "Zama16b": {"supported": false},
    // FROST retires wrs.nto and wrs.sto at once and raises illegal-instruction
    // on wrs.nto in S and U when mstatus.TW is set; wrs.sto never traps.
    // Sail 0.16's non-nop wrs.nto enters Step_Waiting in RVFI-DII mode even
    // without a reservation, reporting pc_wdata = 0 and consuming the next
    // packet, so nto.is_nop is true and zawrs_test covers the mstatus.TW trap.
    "Zawrs": {"supported": true, "nto": {"is_nop": true}, "sto": {"is_nop": true}},
    // Zfa (FLI, FMINM/FMAXM, FROUND/FROUNDNX, FCVTMOD.W.D, FLEQ/FLTQ; D-format
    // high-half moves require RV32) and Zfhmin (FLH/FSH, FMV.X.H/FMV.H.X, FCVT between H and
    // S/D) are implemented; full Zfh is not.
    "Zfa": {"supported": true},
    "Zfbfmin": {"supported": false},
    "Zfh": {"supported": false},
    "Zfhmin": {"supported": true},
    // c.lbu/lhu/lh/sb/sh, c.zext.b/h/w, c.sext.b/h, c.not and c.mul expand in predecode.
    "Zcb": {"supported": true},
    // c.mop.n (n odd, 1-15) writes no register.
    "Zcmop": {"supported": true},
    "Zbc": {"supported": true},
    "Zbkc": {"supported": true},
    "Zbkx": {"supported": false},
    "Zknd": {"supported": false},
    "Zkne": {"supported": false},
    "Zknh": {"supported": false},
    "Zkr": {"supported": false},
    "Zksed": {"supported": false},
    "Zksh": {"supported": false},
    "Zkt": {"supported": true},
    "Zvabd": {"supported": false},
    "Zvfbfmin": {"supported": false},
    "Zvfbfwma": {"supported": false},
    "Zvfh": {"supported": false},
    "Zvfhmin": {"supported": false},
    "Zvbb": {"supported": false},
    "Zvbc": {"supported": false},
    "Zvkg": {"supported": false},
    "Zvkned": {"supported": false},
    "Zvknha": {"supported": false},
    "Zvknhb": {"supported": false},
    "Zvksed": {"supported": false},
    "Zvksh": {"supported": false},
    "Zvkt": {"supported": false},
    // Left off: Sail requires supports_pte_read on every coherent cacheable MainMemory region, while FROST walks page tables in DDR only.
    "Ssccptr": {"supported": false},
    "Sdtrig": {"supported": false},
    "Sscofpmf": {"supported": true},
    "Sha": {"supported": false},
    "Shcounterenw": {"supported": false},
    "Sscounterenw": {"supported": true},
    "Shvsatpa": {"supported": false},
    "Shvstvala": {"supported": false},
    "Shvstvecd": {"supported": false},
    "Ssstrict": {"supported": false},
    "Shgatpa": {"supported": false},
    "Shtvala": {"supported": false},
    "Sstvala": {"supported": true},
    "Sstvecd": {"supported": true},
    "Svadu": {"supported": false},
    "Svinval": {"supported": true},
    "Svrsw60t59b": {"supported": false},
    // Svnapot: 64 KiB NAPOT leaves and the reserved N encodings
    // (traces/svnapot_leaf.S).
    "Svnapot": {"supported": true},
    "Svukte": {"supported": false},
    // Ssnpm: senvcfg.PMM with PMLEN 7 and 16; a reserved or unsupported
    // write keeps the old value on both (traces/ssnpm_pmm.S).
    "Ssnpm": {"supported": true, "supported_pmlen_7": true, "supported_pmlen_16": true},
    "Smnpm": {"supported": false},
    "Smmpm": {"supported": false},
    "Smcntrpmf": {"supported": false},
    "Sv48": {"supported": false},
    "Sv57": {"supported": false},
    "Ssqosid": {"supported": false},
    // Svpbmt: PBMTE and the PBMT fault rules compare equal
    // (traces/svpbmt_pbmte.S). FROST's NC and IO data path (its uncached
    // alias) and its PMA overrides on NC and IO pages (AMO/LR/SC and fetch
    // access faults) are outside what this configuration describes.
    "Svpbmt": {"supported": true},
    "Stateen": {"Smstateen": {"supported": false}, "Ssstateen": {"supported": false}}
  }
}
