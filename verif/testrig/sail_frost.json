// Sail RISC-V model settings for FROST, applied over sail_riscv_sim's default
// configuration with --config-override (tests/test_testrig.py). They describe
// FROST's implementation choices: its extensions, CSR write masks, xtval
// values, misaligned-access traps, and physical memory map, so that TestRIG
// reports only behavior the two disagree on. See verif/testrig/README.md.
{
  "base": {
    // FIOM must be writable whenever satp.MODE can leave Bare, as FROST's is.
    "writable_fiom": true,
    // mhpmcounter3..31 and mhpmevent3..31 read zero; mcounteren, scounteren,
    // and mcountinhibit implement CY, TM, and IR (mcountinhibit CY and IR).
    "writable_hpm_counters": {"len": 32, "value": "0x0000_0000"},
    "mcounteren_writable_bits": {"len": 32, "value": "0x0000_0007"},
    "scounteren_writable_bits": {"len": 32, "value": "0x0000_0007"},
    "mcountinhibit": {"supported": true, "writable_bits": {"len": 32, "value": "0x0000_0005"}},
    // riscv_pkg::MedelegMask and FROST's three delegable interrupts.
    "medeleg": {"delegatable_bits": {"len": 64, "value": "0x0000_0000_0000_B3FF"}},
    "mideleg": {"delegatable_bits": {"len": "xlen", "value": "0x0000_0000_0000_0222"}},
    // FROST has no V extension, so mstatus.VS is read-only zero; FS takes all
    // four states.
    "mstatus": {"fs_legal_states": "ExtContext_FourState", "vs_legal_states": "ExtContext_Off"},
    // FROST writes 0 to mtval/stval for illegal instructions.
    "xtval_nonzero": {
      "illegal_instruction": false
    }
  },
  "memory": {
    // Sail starts a1 (x11) at this address, as a boot ROM would pass a device
    // tree; 0 makes every register start at zero, as on FROST after the reset
    // preamble.
    "dtb_address": {"len": 64, "value": "0x0"},
    // FROST compares whole 64-bit physical addresses and maps nothing above
    // 4 GiB, so a page-table PPN or an untranslated address beyond the map
    // faults instead of aliasing, and mtval holds the full address. No ASID
    // bits; no PMP entries.
    "physaddr_bits": 64,
    "asidlen": 0,
    "pmp": {"grain": 0, "count": 0, "usable_count": 0, "tor_supported": true, "na4_supported": true, "napot_supported": true},
    // Misaligned accesses trap after translation and the region check: an
    // untranslated access outside every region is an access fault first, as
    // on FROST.
    "misaligned": {
      "exceptions": {"load_store": {"None": null}, "vector": {"None": null}, "amo": {"None": null}, "lrsc": {"None": null}},
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "byte_by_byte": false
    },
    // FROST's physical memory attributes (riscv_pkg::pma_* and hw/rtl/README.md).
    "regions": [
      // Low BRAM: loads, stores, and atomics; page tables live in DDR only.
      {
        "base": {
          "len": 64,
          "value": "0x0"
        },
        "size": {
          "len": 64,
          "value": "0x40000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // MMIO device pages. The TestRIG build backs them with a RAM (hw/sim/frost_rvfi_dii.sv). No atomics.
      {
        "base": {
          "len": 64,
          "value": "0x40000000"
        },
        "size": {
          "len": 64,
          "value": "0x31000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Rest of the device quadrant below the PLIC: FROST faults loads and ignores untranslated stores.
      {
        "base": {
          "len": 64,
          "value": "0x40031000"
        },
        "size": {
          "len": 64,
          "value": "0x3FCF000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": false,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // PLIC window, backed by the same RAM.
      {
        "base": {
          "len": 64,
          "value": "0x44000000"
        },
        "size": {
          "len": 64,
          "value": "0x400000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Rest of the device quadrant above the PLIC.
      {
        "base": {
          "len": 64,
          "value": "0x44400000"
        },
        "size": {
          "len": 64,
          "value": "0x3BC00000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": false,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Cached DDR: 1 GiB at 0x8000_0000, the only region page-table walks read.
      {
        "base": {
          "len": 64,
          "value": "0x80000000"
        },
        "size": {
          "len": 64,
          "value": "0x40000000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": false,
          "supports_pte_read": true,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // Sail's CLINT, which Zicntr requires, placed where FROST's map has nothing and tests do not reach.
      {
        "base": {
          "len": 64,
          "value": "0x7FFFF0000"
        },
        "size": {
          "len": 64,
          "value": "0x10000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "Some": "AlignmentException"
            },
            "vector": {
              "Some": "AlignmentException"
            },
            "amo": "AlignmentException",
            "lrsc": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    // A doubleword reservation that any store to it from this hart cancels.
    "reservation": {"reservation_set_size_exp": 3, "require_exact_reservation_addr": false, "invalidate_on_same_hart_store": true},
    "clint": {"supported": true, "base": 34359672832, "size": 49152},
    "simple_interrupt_generator": {"supported": false, "base": 0},
    // The TestRIG build never waits in WFI (it takes no interrupts).
    "wfi_is_nop": true
  },
  "extensions": {
    // misa is read-only RV64 IMAFDC+B+S+U.
    "M": {"supported": true, "mutable_misa": false},
    "A": {"supported": true, "mutable_misa": false},
    // FROST sets mstatus.FS to Dirty when an FP instruction raises any flag,
