// Overlay on sail_frost.json for a FROST built with the vector unit at VLEN
// 512 (tests/test_testrig.py --vlen 512). The three files differ only in
// V.vlen_exp. misa.V is read-only, as FROST's misa is.
{
  "base": {
    "mstatus": {"vs_legal_states": "ExtContext_FourState"}
  },
  "extensions": {
    "V": {"support_level": "Full", "mutable_misa": false, "vlen_exp": 9},
    "Zvfhmin": {"supported": true},
    "Zvfh": {"supported": true},
    "Zvbb": {"supported": true},
    "Zvbc": {"supported": true},
    "Zvkg": {"supported": true},
    "Zvkned": {"supported": true},
    "Zvknha": {"supported": true},
    "Zvknhb": {"supported": true},
    "Zvkt": {"supported": true}
  }
}
