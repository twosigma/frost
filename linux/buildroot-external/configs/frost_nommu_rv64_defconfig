# FROST RV64 no-MMU M-mode Linux -- Buildroot defconfig (Phase 1 M7 / D12)
#
# Provenance: derived from the upstream buildroot defconfig
#   configs/qemu_riscv64_nommu_virt_defconfig
# with the FROST retarget (initramfs instead of an ext2/virtio disk, the
# FROST kernel CONFIG fragment on top of the rv64 base config, and the
# post-image packaging step). The kernel base is linux-nommu-base-rv64.config
# (upstream riscv64-virt nommu mini-config); the FROST fragment carries no
# XLEN. The -rv64 name suffixes are historical, from when an rv32 lane
# existed beside this one.
#
# Build:
#   make -C linux/buildroot O=$(pwd)/linux/build-rv64 \
#        BR2_EXTERNAL=$(pwd)/linux/buildroot-external frost_nommu_rv64_defconfig
#   make -C linux/buildroot O=$(pwd)/linux/build-rv64
# Output lands in linux/build-rv64/images/.
#
# NOTE: the rv64-nommu internal toolchain (gcc 15.2.0 / binutils 2.45.1 /
# uClibc + elf2flt bFLT) comes from the pinned Buildroot tree's defaults,
# same as the rv32 lane. D12's float watch item is RESOLVED: the first build's
# generated .config selects BR2_RISCV_ABI_LP64D=y (hard-float lp64d
# userspace); the feared MMU-gated soft-float fallback did not materialize.

# --- Architecture: RISC-V 64-bit, no MMU ---
BR2_riscv=y
BR2_RISCV_64=y
# BR2_RISCV_USE_MMU is not set

# --- Host kernel headers must match the target kernel series (Linux 6.18) ---
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# --- Download integrity: carry the linux-6.18.7 hash in our own patch dir so
#     BR2_DOWNLOAD_FORCE_CHECK_HASHES can verify the custom kernel tarball ---
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_FROST_PATH)/board/frost/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# --- Linux kernel: 6.18.7, rv64 virt-nommu base config + FROST fragment ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_FROST_PATH)/board/frost/linux-nommu-base-rv64.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FROST_PATH)/board/frost/linux-nommu-frost.config.fragment"

# --- Init system: busybox (nommu bFLT userspace) ---
BR2_INIT_BUSYBOX=y

# --- Root filesystem: initramfs (cpio.gz). FROST has no block device, so the
#     rootfs is an initramfs loaded into DDR; the kernel fragment enables
#     CONFIG_BLK_DEV_INITRD + CONFIG_RD_GZIP to consume it. ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# (ext2 / virtio-blk rootfs intentionally omitted -- see the kernel fragment.)

# --- Post-image: package Image + generated DTB + initramfs into the FROST
#     FPGA/sim memory images sw.{mem,txt} and sw_ddr.{mem,txt}. ---
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FROST_PATH)/board/frost/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_FROST_PATH)/board/frost/busybox.config"
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_FROST_PATH)/board/frost/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FROST_PATH)/board/frost/rootfs-overlay"

# --- FROST packages: userspace boot stress payload (run from the overlay
#     inittab; prints the FROST_USERSPACE_STRESS_PASS token CI asserts). ---
BR2_PACKAGE_FROST_STRESS=y
