# FROST RV64 Buildroot defconfig: the OpenSBI firmware and the musl test
# initramfs that the Sv39 kernel boots into. No kernel is built here: FROST
# boots Debian's pinned one, which post-image-mmu.sh stages through
# ../../debian_kernel.py (../../README.md, "Kernel").
#
# Build (inside the frost container, from the repository root):
#   make -C linux/buildroot O=$(pwd)/linux/build-mmu \
#        BR2_EXTERNAL=$(pwd)/linux/buildroot-external frost_rv64_defconfig
#   make -C linux/buildroot O=$(pwd)/linux/build-mmu
# Output lands in linux/build-mmu/images/: rootfs.cpio, fw_jump.bin (built by
# post-image-mmu.sh from the linux/opensbi submodule), Debian's kernel as
# Image-debian, rootfs-frost.cpio (rootfs.cpio plus the NIC module and its
# loader), the packed sw.{mem,txt} / sw_ddr.{mem,txt} boot images, and
# frost.dtb.

# --- Architecture: RISC-V 64-bit general purpose (rv64gc, lp64d), MMU ---
BR2_riscv=y
BR2_riscv_g=y
BR2_RISCV_64=y
BR2_RISCV_ABI_LP64D=y

# --- Toolchain: Bootlin's stable GCC 15.3 / musl release, also in Docker.
# Buildroot 2026.08's built-in Bootlin choice still selects 2025.08; use the
# custom download path to keep native and container builds on the same release.
# The external tree's hash verifies the archive on native builds too.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://toolchains.bootlin.com/downloads/releases/toolchains/riscv64-lp64d/tarballs/riscv64-lp64d--musl--stable-2026.08-1.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-linux"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_FROST_PATH)/patches"

# --- Init and rootfs: busybox (static, so each BusyBox exec during init skips
#     the dynamic loader's page faults and relocations), uncompressed cpio
#     initramfs (inflating a gzip'd one costs the core tens of cycles per
#     byte) ---
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FROST_PATH)/board/frost/busybox-mmu.fragment"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FROST_PATH)/board/frost/rootfs-overlay-mmu"
# The initramfs does no IP networking (frost_nettest uses packet sockets):
# leave out the ifupdown boot script.
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# --- Boot payload packaging: OpenSBI build + frost_boot_image.py ---
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FROST_PATH)/board/frost/post-image-mmu.sh"

# --- Userspace: the boot stress payload, which also reads the
#     counters the hardware regression checks (../../README.md, "Counters and
#     mcounteren"), so no perf is needed on the target ---
BR2_PACKAGE_FROST_STRESS=y
