# Applied on top of Buildroot's default busybox config
# (BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES in frost_rv64_defconfig). Static
# linking keeps each BusyBox exec during init free of dynamic-loader relocation
# work; the rest of userspace (frost_stress, frost_sigprobe, frost_nettest)
# stays dynamic on musl.
CONFIG_STATIC=y
