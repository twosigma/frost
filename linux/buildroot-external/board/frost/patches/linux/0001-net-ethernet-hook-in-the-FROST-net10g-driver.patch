From 148a2a2061419e4fad4ec82aa3ecca9db4d143da Mon Sep 17 00:00:00 2001
From: Adam Bagley <adam.bagley@tssecurities.com>
Date: Fri, 18 Sep 2026 12:00:00 -0400
Subject: [PATCH] net: ethernet: hook in the FROST net10g driver

Source drivers/net/ethernet/frost/Kconfig and build
drivers/net/ethernet/frost/, the directory of the FROST SoC's network
drivers. The directory's files (Kconfig, Makefile and frost_net10g.c, the
driver for the "frost,net10g" 10GBASE-R controller) are not part of this
patch: the FROST Buildroot external tree installs them from
linux/frost-net10g in the FROST repository once the kernel is patched,
and the same source builds as a DKMS module for distribution kernels.
---
 drivers/net/ethernet/Kconfig  | 1 +
 drivers/net/ethernet/Makefile | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/net/ethernet/Kconfig b/drivers/net/ethernet/Kconfig
index aead145..8f8e369 100644
--- a/drivers/net/ethernet/Kconfig
+++ b/drivers/net/ethernet/Kconfig
@@ -74,6 +74,7 @@ source "drivers/net/ethernet/engleder/Kconfig"
 source "drivers/net/ethernet/ezchip/Kconfig"
 source "drivers/net/ethernet/faraday/Kconfig"
 source "drivers/net/ethernet/freescale/Kconfig"
+source "drivers/net/ethernet/frost/Kconfig"
 source "drivers/net/ethernet/fujitsu/Kconfig"
 source "drivers/net/ethernet/fungible/Kconfig"
 source "drivers/net/ethernet/google/Kconfig"
diff --git a/drivers/net/ethernet/Makefile b/drivers/net/ethernet/Makefile
index 998dd62..11f46c1 100644
--- a/drivers/net/ethernet/Makefile
+++ b/drivers/net/ethernet/Makefile
@@ -42,6 +42,7 @@ obj-$(CONFIG_NET_VENDOR_ENGLEDER) += engleder/
 obj-$(CONFIG_NET_VENDOR_EZCHIP) += ezchip/
 obj-$(CONFIG_NET_VENDOR_FARADAY) += faraday/
 obj-$(CONFIG_NET_VENDOR_FREESCALE) += freescale/
+obj-$(CONFIG_NET_VENDOR_FROST) += frost/
 obj-$(CONFIG_NET_VENDOR_FUJITSU) += fujitsu/
 obj-$(CONFIG_NET_VENDOR_FUNGIBLE) += fungible/
 obj-$(CONFIG_NET_VENDOR_GOOGLE) += google/
-- 
