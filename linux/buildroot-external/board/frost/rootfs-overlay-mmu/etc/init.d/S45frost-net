# Configure the RJ-45 NIC identified by its platform device address.
case "$1" in
start)
    for interface in /sys/class/net/*; do
        case "$(readlink -f "$interface/device")" in
        */40022000.ethernet)
            name=${interface##*/}
            ip link set "$name" up || exit 1
            ip -4 addr show dev "$name" | grep -q 'inet ' && continue
            udhcpc -i "$name" -b -p /run/udhcpc-frost.pid
            ;;
        esac
    done
    ;;
stop)
    if [ -f /run/udhcpc-frost.pid ]; then
        kill "$(cat /run/udhcpc-frost.pid)" 2>/dev/null || true
        rm -f /run/udhcpc-frost.pid
    fi
    ;;
esac
