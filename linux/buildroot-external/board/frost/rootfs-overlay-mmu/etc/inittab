# /etc/inittab for the FROST MMU Linux lane (busybox init; runlevels ignored).
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#   id        == tty to run on, or empty for /dev/console
#   action    == one of sysinit, respawn, askfirst, wait, and once

# An initramfs boot does not auto-mount devtmpfs: mount it first (the static
# /dev/console from the device table bootstraps init's own stdio).
::sysinit:/bin/mount -t devtmpfs devtmpfs /dev
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS

# FROST userspace boot stress payload (MMU edition): timer storm + signals,
# fork/exec with copy-on-write checks, anonymous and shared mappings, futex
# ping-pong, LR/SC contention, and cycle/instret deltas through
# perf_event_open. Prints the FROST_USERSPACE_STRESS_PASS token that the QEMU
# CI job and the hardware boot soak assert on. sysinit entries run
# sequentially before the getty, so the token always precedes the login prompt.
::sysinit:/usr/bin/frost_stress --boot

# Put a getty on the serial port
console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
