# FROST mainline rv64 MMU Linux mini-config (Phase 3 M7). Buildroot treats it
# as a full .config and runs olddefconfig, so only the load-bearing choices are
# listed; everything else takes the kernel's default. Disable symbols with
# "# CONFIG_x is not set", never "=n". One kernel patch (the NIC driver), no
# NONPORTABLE, no M-mode.
#
# The DT (frost_boot_image.py) describes the hart, the ns16550a on PLIC source
# 1, the CLINT (OpenSBI's), and the PLIC with its S context; the kernel runs
# in S-mode under OpenSBI fw_jump with Sv39 (mmu-type in the DT), Sstc timers,
# and the SBI PMU on the cycle/instret counters.

CONFIG_ARCH_RV64I=y
CONFIG_64BIT=y
CONFIG_MMU=y
# CONFIG_SMP is not set
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# FROST traps every misaligned access. Linux asks OpenSBI's FWFT extension to
# delegate those traps and emulates them itself; this choice keeps the timed
# boot-time misalignment speed probe out (every probe access would be a trap).
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
CONFIG_HZ_100=y
CONFIG_PRINTK_TIME=y

# Rootfs: an external uncompressed cpio initramfs passed via linux,initrd-*,
# or an NFSv3 export the kernel mounts itself (root=/dev/nfs with nfsroot= and
# ip=; sw/apps/linux_boot's FROST_LINUX_NFSROOT packs those bootargs).
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y

# systemd (Debian on the NFS root) requires cgroups (it uses the v2 hierarchy,
# no controllers) and AF_UNIX sockets, and recommends the automounter and tmpfs
# ACLs and xattrs. Its other requirements and the seccomp filters it
# recommends are on by default.
CONFIG_CGROUPS=y
CONFIG_UNIX=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Console: the ns16550a face, interrupt-driven through the PLIC; earlycon from
# the DT stdout-path.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y

# perf basics: the SBI PMU driver over the fixed cycle/instret counters.
CONFIG_PERF_EVENTS=y
CONFIG_RISCV_PMU=y
CONFIG_RISCV_PMU_SBI=y
CONFIG_KALLSYMS=y

# Networking: packet sockets, IPv4 (the NFS root's transport) with the kernel's
# ip= configuration, static or by DHCP (the NFS root's default; no BOOTP or
# RARP), and the frost,net10g NIC driver, which board/frost/patches/linux adds
# to the kernel. IPv6, on by default with INET, stays off: nothing needs it,
# and it would send autoconfiguration frames each time the interface comes up,
# which frost_nettest's idle checks do not allow for.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_FROST=y
CONFIG_FROST_NET10G=y

# Nothing FROST does not have.
# CONFIG_PCI is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_MODULES is not set
# CONFIG_ARCH_VIRT is not set
