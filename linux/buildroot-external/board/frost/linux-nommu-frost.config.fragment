# FROST delta for the Linux 6.18.7 rv64/no-MMU/M-mode QEMU-virt base:
# linux-nommu-base-rv64.config. In kbuild fragments, disable symbols with
# "# CONFIG_x is not set", never "=n".
#
# FROST exposes its native UART/timer through Linux-compatible aliases:
#   0x4000_1000..101C  ns16550a UART (reg-shift=2, reg-io-width=4)
#   0x4001_0000        CLINT msip for hart 0
#   0x4001_4000/4004   CLINT mtimecmp[31:0]/[63:32]
#   0x4001_BFF8/BFFC   CLINT mtime[31:0]/[63:32]
# Native MMIO remains at 0x4000_0000: TX/RX at +0x00/+0x04, FIFOs at
# +0x08/+0x0C, mtime at +0x10/+0x14, mtimecmp at +0x18/+0x1C, msip at +0x20,
# and RX/TX status at +0x24/+0x28.
# See linux/README.md for the complete native and aliased MMIO map. Keep this
# synchronized with cpu_and_mem.sv, build_fpga_boot.py, and hw/rtl/README.md.
#
# Standard 8250 and CLINT drivers need no board-specific replacements. The
# generated no-MMU DT omits the hardware PLIC and defaults to polled UART;
# FROST_LINUX_SERIAL_IRQ_MODE=cpu-local-meip exposes MEIP only for diagnostics.


# -----------------------------------------------------------------------------
# Core mode: M-mode, no-MMU, nonportable. Keep these set for FROST.
# -----------------------------------------------------------------------------
CONFIG_NONPORTABLE=y            # gate for the M-mode/no-MMU "not upstream-portable" combo
CONFIG_RISCV_M_MODE=y           # kernel runs in M-mode; no SBI firmware, and the core's S-mode goes unused
# CONFIG_ARCH_RV64I is not restated here. The ARCH choice lives in the base
# config (linux-nommu-base-rv64.config): fragments apply last, so a restatement
# would override whatever base is merged.
# The kernel runs without translation; the core's Sv39 support goes unused.
# CONFIG_MMU is not set
CONFIG_BINFMT_FLAT=y            # nommu userspace needs bFLT executables (busybox FLAT)


# -----------------------------------------------------------------------------
# Rootfs: FROST has no block device. Supply an external cpio with QEMU -initrd
# or the FROST DDR image; set CONFIG_INITRAMFS_SOURCE to embed one instead.
# -----------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y         # enable initrd/initramfs as the root filesystem
CONFIG_INITRAMFS_SOURCE=""      # empty => supply cpio externally (-initrd / JTAG blob); set to a path to embed
CONFIG_RD_GZIP=y                # allow a gzip-compressed external initramfs image
# --- drop the disk-based rootfs path ---
# FROST has no virtio-blk device.
# CONFIG_VIRTIO_BLK is not set
# ext2 was only for the virtio-blk disk; initramfs uses ramfs/tmpfs.
# CONFIG_EXT2_FS is not set
# The block layer remains at its hidden default because disabling it requires
# CONFIG_EXPERT, which also changes many unrelated kernel defaults.


# -----------------------------------------------------------------------------
# Console: the ns16550a alias supplies the word-stride layout expected by 8250.
# With no PLIC DT node, packaging defaults to polling; cpu-local-meip is
# diagnostic.
# -----------------------------------------------------------------------------
CONFIG_SERIAL_8250=y            # drives QEMU virt's UART and FROST's ns16550a alias
CONFIG_SERIAL_8250_CONSOLE=y    # register ttyS0 as the system console
CONFIG_SERIAL_EARLYCON=y        # generic earlycon framework (pre-driver boot messages)
# FROST exposes one UART; trim the static port table.
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y     # bind the 8250 from the DT "serial@..." node (no PCI probing)
CONFIG_SERIAL_CORE=y            # (auto-selected) tty serial core
CONFIG_SERIAL_CORE_CONSOLE=y    # (auto-selected) serial-as-console support
# The generated FROST DTB selects /soc/serial@40001000 and uses:
#   earlycon=uart8250,mmio32,0x40001000 console=ttyS0


# -----------------------------------------------------------------------------
# Device tree: the packer places the FROST DTB in DDR and passes its address in
# a1; QEMU supplies its own. The normal path uses an external DTB.
# -----------------------------------------------------------------------------
CONFIG_OF=y                     # device-tree support (probe UART/timer/memory from DT)
CONFIG_OF_EARLY_FLATTREE=y      # parse the FDT early (needed for earlycon + memory setup)
# By default, pass the DTB externally (QEMU -dtb / FROST blob).
# CONFIG_USE_BUILTIN_DTB is not set
CONFIG_BUILTIN_DTB_SOURCE=""    # if embedding instead: set to "<vendor>/frost-nommu-fpga"
# (arch/riscv keeps its DTS files in vendor subdirs, so the generated
# frost-nommu-fpga.dts would go under arch/riscv/boot/dts/<vendor>/; it is
# regenerated per build by build_fpga_boot.py from the clock and initrd size.)
# CONFIG_SOC_VIRT is set in the SoC section below, not here.


# -----------------------------------------------------------------------------
# SoC: keep SOC_VIRT for required boot glue until an in-tree FROST machine
# exists. Revisit then; FROST itself has no virt devices.
# -----------------------------------------------------------------------------
CONFIG_SOC_VIRT=y               # boot glue + earlycon table; revisit once a FROST machine exists


# -----------------------------------------------------------------------------
# Drop QEMU-virt devices absent from FROST and reduce the image size.
# -----------------------------------------------------------------------------
# FROST has no virtio transport.
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
# FROST has no NIC.
# CONFIG_VIRTIO_NET is not set
# Drop the virtio core.
# CONFIG_VIRTIO is not set
# CONFIG_VIRTIO_MENU is not set
# FROST has no PCI host bridge.
# CONFIG_PCI is not set
# No networking stack is needed for the MVP.
# CONFIG_NET is not set
# CONFIG_PACKET is not set
# CONFIG_INET is not set
# Re-enable AF_UNIX if userspace needs it later.
# CONFIG_UNIX is not set
# CONFIG_NETDEVICES is not set


# -----------------------------------------------------------------------------
# PLIC omitted from the no-MMU DT. The RISC-V architecture selects the SiFive
# PLIC driver unconditionally, but without a DT node it binds to no device.
# Packaging defaults UART to polling.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Timer: the DT advertises FROST's CLINT alias and its machine software/timer
# interrupts. The standard M-mode timer path accesses it directly; rdtime is
# also available.
# -----------------------------------------------------------------------------
CONFIG_RISCV_TIMER=y            # in-core rdtime-based clocksource/clockevent (works in M-mode nommu)


# -----------------------------------------------------------------------------
# Small bring-up aids retained from the virt config.
# -----------------------------------------------------------------------------
CONFIG_PRINTK_TIME=y            # timestamped boot log (matches the virt build, eases triage)
# Linux 6.18 no longer has SLOB; its default SLUB allocator is used.
