library (sram_1w1r_512x68_TT_1p1V_25C_lib){
    delay_model : "table_lookup";
    time_unit : "1ns" ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    resistance_unit : "1kohm" ;
    capacitive_load_unit(1, pF) ;
    leakage_power_unit : "1mW" ;
    pulling_resistance_unit : "1kohm" ;
    operating_conditions(OC){
    process : 1.0 ;
    voltage : 1.1 ;
    temperature : 25;
    }

    input_threshold_pct_fall       :  50.0 ;
    output_threshold_pct_fall      :  50.0 ;
    input_threshold_pct_rise       :  50.0 ;
    output_threshold_pct_rise      :  50.0 ;
    slew_lower_threshold_pct_fall  :  10.0 ;
    slew_upper_threshold_pct_fall  :  90.0 ;
    slew_lower_threshold_pct_rise  :  10.0 ;
    slew_upper_threshold_pct_rise  :  90.0 ;

    nom_voltage : 1.1;
    nom_temperature : 25;
    nom_process : 1.0;
    default_cell_leakage_power    : 0.0 ;
    default_leakage_power_density : 0.0 ;
    default_input_pin_cap    : 1.0 ;
    default_inout_pin_cap    : 1.0 ;
    default_output_pin_cap   : 0.0 ;
    default_max_transition   : 0.5 ;
    default_fanout_load      : 1.0 ;
    default_max_fanout   : 4.0 ;
    default_connection_class : universal ;

    voltage_map ( VDD, 1.1 );
    voltage_map ( GND, 0 );

    lu_table_template(CELL_TABLE){
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.005, 0.05, 0.5");
        index_2("0.0008364000000000001, 0.0066912000000000004, 0.053529600000000004");
    }

    lu_table_template(CONSTRAINT_TABLE){
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.005, 0.05, 0.5");
        index_2("0.005, 0.05, 0.5");
    }

    default_operating_conditions : OC; 


    type (data){
    base_type : array;
    data_type : bit;
    bit_width : 68;
    bit_from : 67;
    bit_to : 0;
    }

    type (addr){
    base_type : array;
    data_type : bit;
    bit_width : 9;
    bit_from : 8;
    bit_to : 0;
    }

cell (sram_1w1r_512x68){
    memory(){ 
    type : ram;
    address_width : 9;
    word_width : 68;
    }
    interface_timing : true;
    dont_use  : true;
    map_only   : true;
    dont_touch : true;
    area : 107291.59455000001;

    pg_pin(vdd) {
         voltage_name : VDD;
         pg_type : primary_power;
    }

    pg_pin(gnd) {
         voltage_name : GND;
         pg_type : primary_ground;
    }

    leakage_power () {
      value : 0.036173;
    }
    cell_leakage_power : 0.036173;
    bus(din0){
        bus_type  : data; 
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        memory_write(){ 
            address : addr0; 
            clocked_on  : clk0; 
        }
        pin(din0[67:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
            }
        }
        }
    }
    bus(addr0){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        max_transition       : 0.5;
        pin(addr0[8:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
            }
        }
        }
    }

    pin(csb0){
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        internal_power(){
            when : "!csb0"; 
            rise_power(scalar){
                values("1.367877e+01");
            }
            fall_power(scalar){
                values("1.367877e+01");
            }
        }
        internal_power(){
            when : "csb0"; 
            rise_power(scalar){
                values("1.367877e+01");
            }
            fall_power(scalar){
                values("1.367877e+01");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("0.8345"); 
            }
            fall_constraint(scalar) {
                values("0.8345"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("1.669"); 
            }
            fall_constraint(scalar) {
                values("1.669"); 
            }
         }
    }

    bus(dout1){
        bus_type  : data; 
        direction  : output; 
        max_capacitance : 0.053529600000000004;  
        min_capacitance : 0.0008364000000000001;  
        memory_read(){ 
            address : addr1; 
        }
        pin(dout1[67:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk1"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("0.384, 0.391, 0.451",\
                   "0.384, 0.391, 0.451",\
                   "0.384, 0.391, 0.451");
            }
            cell_fall(CELL_TABLE) {
            values("0.384, 0.391, 0.451",\
                   "0.384, 0.391, 0.451",\
                   "0.384, 0.391, 0.451");
            }
            rise_transition(CELL_TABLE) {
            values("0.001, 0.001, 0.007",\
                   "0.001, 0.001, 0.007",\
                   "0.001, 0.001, 0.007");
            }
            fall_transition(CELL_TABLE) {
            values("0.001, 0.001, 0.007",\
                   "0.001, 0.001, 0.007",\
                   "0.001, 0.001, 0.007");
            }
        }
        }
    }

    bus(addr1){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        max_transition       : 0.5;
        pin(addr1[8:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
            }
        }
        }
    }

    pin(csb1){
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009",\
                   "0.009, 0.009, 0.009");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001",\
                   "0.001, 0.001, 0.001");
            }
        }
    }

    pin(clk1){
        clock             : true;
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        internal_power(){
            when : "!csb1"; 
            rise_power(scalar){
                values("1.367877e+01");
            }
            fall_power(scalar){
                values("1.367877e+01");
            }
        }
        internal_power(){
            when : "csb1"; 
            rise_power(scalar){
                values("1.367877e+01");
            }
            fall_power(scalar){
                values("1.367877e+01");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk1; 
            rise_constraint(scalar) {
                values("0.8345"); 
            }
            fall_constraint(scalar) {
                values("0.8345"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk1; 
            rise_constraint(scalar) {
                values("1.669"); 
            }
            fall_constraint(scalar) {
                values("1.669"); 
            }
         }
    }

    }
}
