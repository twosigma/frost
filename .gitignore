# Buildroot's test initramfs with the NIC module appended, rebuilt by
# sw/apps/linux_boot/Makefile.
/sw/apps/linux_boot/rootfs.cpio

# Buildroot firmware, test userspace, and caches. Regenerate with
# `make -C sw/apps/linux_boot`; the kernel comes from Debian packages.
/linux/build/
/linux/build-rv64/
/linux/build-mmu/
/linux/dl/
/linux/ccache/

# Debian kernel packages and NIC module, pinned by linux/debian_kernel.py.
/linux/debian-kernel/

