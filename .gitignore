# Compiled software (regenerated on demand by test/build/load scripts)
sw.mem
sw64.mem
sw.txt
sw_ddr.mem
sw_ddr.txt
sw_ddr.bin
sw_imem_*.mem
sw/apps/*/sw.S
# The arch-test build's copy of the test source with its constants repaired.
sw/apps/arch_test/test_src_repaired.S
# Buildroot's test initramfs with the NIC module appended, rebuilt by
# sw/apps/linux_boot/Makefile.
/sw/apps/linux_boot/rootfs.cpio

# FROST MMU Linux: out-of-tree Buildroot build output (firmware and test
# userspace; no kernel is built) and the download and ccache caches.
# `make -C sw/apps/linux_boot` (and the CI build-frost-linux-mmu job) regenerate
# them from the linux/buildroot submodule and the linux/buildroot-external tree.
# /linux/build/ and /linux/build-rv64/ come from removed Linux builds; they stay
# ignored so checkouts that still have them keep a clean git status.
/linux/build/
/linux/build-rv64/
/linux/build-mmu/
/linux/dl/
/linux/ccache/

# Debian's kernel packages, the tree they extract into, and the NIC module built
# against it: a download cache, refilled from the pin in linux/debian_kernel.py.
/linux/debian-kernel/

# mypy
.mypy_cache/

# Vivado
*.jou
*.log
# ... except the console captures kept as test fixtures: a board's UART output is
# a log, and tests/fixtures holds it byte for byte for the parsers that read it.
!tests/fixtures/*.log
*.str
.Xil/
fpga/build/*/work*
fpga/build/*/SUMMARY_*.md

# Local VS Code extension build/package output
tools/vscode-frost/node_modules/
tools/vscode-frost/out/
tools/vscode-frost/*.vsix

# Local timing notes and device captures. Working notes stay out of the
# repository; keep them in a scratch directory instead.
/TIMING_HANDOFF_*.md
/device_view.png

# Site-specific hardware-regression values (NFS root, board address).
fpga/site.env
