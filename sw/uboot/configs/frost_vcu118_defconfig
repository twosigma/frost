CONFIG_RISCV=y
CONFIG_TARGET_QEMU_VIRT=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_SMODE=y
CONFIG_CMODEL_MEDANY=y

CONFIG_TEXT_BASE=0x80200000
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_SYS_MALLOC_F_LEN=0x4000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x80400000
CONFIG_SYS_LOAD_ADDR=0x84000000
CONFIG_ENV_SIZE=0x20000

# Device Tree passed from OpenSBI in a1
CONFIG_OF_CONTROL=y
CONFIG_OF_PRIOR_STAGE=y
CONFIG_DEFAULT_DEVICE_TREE="qemu-virt64"
# CONFIG_BOARD_INIT is not set

# Serial Console (ns16550a @ 0x40001000)
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_BAUDRATE=115200

# Timer (RISC-V rdtime @ 200 MHz)
CONFIG_TIMER=y
CONFIG_RISCV_TIMER=y

# Disable parallel NOR CFI flash (VCU118 uses SPI NOR flash MT25QU01G)
# CONFIG_MTD_NOR_FLASH is not set
# CONFIG_CFI_FLASH is not set
# CONFIG_CMD_FLASH is not set

# FROST Ethernet NIC (coherent DMA @ 0x40022000)
CONFIG_NET=y
CONFIG_FROST_NET10G=y
CONFIG_CMD_NET=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTPBOOT=y

# Command Line & Boot Environment
CONFIG_SYS_PROMPT="frost=> "
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_RUN=y
CONFIG_BOOTDELAY=3

# Default TFTP Boot Command
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="dhcp; setenv serverip 192.168.1.159; tftpboot 0x84000000 Image; tftpboot 0x88000000 frost.dtb; tftpboot 0x88100000 rootfs.cpio; booti 0x84000000 0x88100000:${filesize} 0x88000000"

# SPI and SPI NOR Flash
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_MICRON=y
CONFIG_SPI_FLASH_BAR=y
CONFIG_CMD_SF=y
CONFIG_FROST_SPI=y
