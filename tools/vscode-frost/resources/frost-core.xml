    <reg name="a5" bitsize="64" type="int" regnum="15" group="general"/>
    <reg name="a6" bitsize="64" type="int" regnum="16" group="general"/>
    <reg name="a7" bitsize="64" type="int" regnum="17" group="general"/>
    <reg name="s2" bitsize="64" type="int" regnum="18" group="general"/>
    <reg name="s3" bitsize="64" type="int" regnum="19" group="general"/>
    <reg name="s4" bitsize="64" type="int" regnum="20" group="general"/>
    <reg name="s5" bitsize="64" type="int" regnum="21" group="general"/>
    <reg name="s6" bitsize="64" type="int" regnum="22" group="general"/>
