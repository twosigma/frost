<!DOCTYPE target SYSTEM "gdb-target.dtd">
<!--
  Opt-in RV64 FROST core register description. Register numbers, wire widths,
  and FPU types match the X3 OpenOCD target description captured in Phase A
  on 2026-09-07. Keep explicit regnum values: the remote numbering has a gap
  at 65 before the floating-point CSRs. See the adjacent README.md.
-->
<target>
  <architecture>riscv:rv64</architecture>
  <feature name="org.gnu.gdb.riscv.cpu">
    <reg name="zero" bitsize="64" type="int" regnum="0" group="general"/>
    <reg name="ra" bitsize="64" type="int" regnum="1" group="general"/>
    <reg name="sp" bitsize="64" type="int" regnum="2" group="general"/>
    <reg name="gp" bitsize="64" type="int" regnum="3" group="general"/>
    <reg name="tp" bitsize="64" type="int" regnum="4" group="general"/>
    <reg name="t0" bitsize="64" type="int" regnum="5" group="general"/>
    <reg name="t1" bitsize="64" type="int" regnum="6" group="general"/>
    <reg name="t2" bitsize="64" type="int" regnum="7" group="general"/>
    <reg name="fp" bitsize="64" type="int" regnum="8" group="general"/>
    <reg name="s1" bitsize="64" type="int" regnum="9" group="general"/>
    <reg name="a0" bitsize="64" type="int" regnum="10" group="general"/>
    <reg name="a1" bitsize="64" type="int" regnum="11" group="general"/>
    <reg name="a2" bitsize="64" type="int" regnum="12" group="general"/>
    <reg name="a3" bitsize="64" type="int" regnum="13" group="general"/>
