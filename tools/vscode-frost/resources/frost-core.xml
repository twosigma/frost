    <reg name="pc" bitsize="64" type="int" regnum="32" group="general"/>
  </feature>
  <feature name="org.gnu.gdb.riscv.fpu">
    <union id="FPU_FD">
      <field name="float" type="ieee_single"/>
      <field name="double" type="ieee_double"/>
