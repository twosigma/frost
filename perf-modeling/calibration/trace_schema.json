{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FROST performance calibration JSONL event",
  "version": 1,
  "required_common": ["cycle", "event", "source"],
  "events": {
    "meta": {"required": ["rtl_commit", "clock_domain", "memory_configuration"]},
    "dispatch": {"required": ["uops"]},
    "retire": {"required": ["uops"]},
    "cache_request": {"required": ["cache", "address", "is_write", "request_id"]},
    "cache_response": {"required": ["cache", "request_id", "ok"]},
    "mshr_allocate": {"required": ["cache", "slot", "line_address"]},
    "mshr_release": {"required": ["cache", "slot", "line_address"]},
    "axi_request": {"required": ["axi_id", "address", "is_write", "bytes"]},
    "axi_response": {"required": ["axi_id", "ok"]},
    "backpressure": {"required": ["resource", "reason"]}
  }
}
