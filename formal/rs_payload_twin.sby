[tasks]
bmc
bmc_cdb packet packet_only
bmc_cdb_2 packet packet_only
bmc_commit packet packet_only
bmc_commit_2 packet cmo
bmc_operands
cover_cmo_request cmo

[options]
~cover_cmo_request: mode bmc
cover_cmo_request: mode cover
~cmo: depth 5
cmo: depth 6
packet: vcd_sim on

[engines]
~packet: smtbmc boolector
packet: btor btormc

[script]
# Payload twin: two tomasulo_wrapper copies on the same inputs from the same
# zero state, each reservation station with RS_STAGE2_PAYLOAD_HAVOC (an
# arbitrary, independent stage2/stage2b payload on every edge after which the
# stage holds no packet). The harness asserts every wrapper output equal, and
# the RS issue packets equal while valid: no reader takes the payload outside
# its valid.
read -formal -sv riscv_pkg.sv vec_hold_rows.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv mwp_dist_ram.sv
read -formal -sv mwp_dist_ram_ohread.sv
read -sv rob_serializer.sv sfence_operand_store.sv
read -sv reorder_buffer.sv
read -sv register_alias_table.sv
read -formal -sv rs_issue2_selector.sv
# FORMAL_STANDALONE_ENV=0 retains station assertions without standalone
# assumptions or covers. The real allocator exercises the branch-payload
# RAM's rule against reusing a live ROB tag.
read -sv coherent_rs_capacity.sv
read -sv coherent_rs_issue2_selector.sv
read -sv coherent_rs_payload_store.sv
read -formal -sv -D RS_STAGE2_PAYLOAD_HAVOC reservation_station.sv
read -sv cdb_arbiter.sv
read -sv fu_cdb_adapter.sv
read -sv int_alu_shim.sv
read -sv int_muldiv_shim.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -sv coherent_lq_issue_selector.sv
read -sv coherent_lq_candidate_select.sv
read -sv coherent_lq_address_store.sv
read -sv -DFROST_YOSYS load_queue.sv
read -sv sq_forwarding_unit.sv
read -sv store_queue.sv
read -sv dtlb.sv
read -sv dmmu.sv
read -sv tomasulo_perf_counters.sv
read -sv sq_early_addr_pipeline.sv
read -sv commit_bus_pipeline.sv
read -sv dispatch_rs_router.sv
read -sv sc_pending_unit.sv
read -sv coherent_atomic_select.sv
read -formal -sv mem_wakeup_merge.sv
read -sv lq_coherence_port.sv
read -sv divider.sv
read -sv dsp_tiled_multiplier_unsigned.sv
read -sv multiplier.sv cl_multiplier.sv
read -sv alu.sv
read -sv fp_engine.sv
# The FMA datapath's results are abstracted (fp_fma_pipe_equiv checks them).
read -formal -D FP_FMA_PIPE_ABSTRACT -sv fp_pipe_lzc.sv fp_fma_pipe.sv
read -sv fp_div_unit.sv
read -sv fp_shim.sv
read -formal -sv tomasulo_wrapper.sv
read -formal -sv rs_payload_twin_formal.sv
hierarchy -top rs_payload_twin_formal
script free_undefined.ys
# Only the harness equalities are checked here: the submodules keep their
# assumptions, and their own assertions belong to their tasks.
chformal -assert -remove * rs_payload_twin_formal %d
prep -top rs_payload_twin_formal
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
opt_clean
# Both copies start from the same state: every register at zero.
setundef -zero -init
# Check the same complete model in each task. The four wide packets and
# operand values have separate cones. The remaining assertions form the
# complement of those named groups. The second commit packet shares its task
# with the CMO request. The kind and address faults pass at depth five because
# the first valid request appears in frame five. Check that sixth frame.
# Every task keeps all wrapper assumptions.
select -assert-count 104 t:$check r:FLAVOR=assume %i
select -assert-count 175 t:$check r:FLAVOR=assert %i
select -set packets c:p_twin_cdb c:p_twin_cdb_2 c:p_twin_commit_comb c:p_twin_commit_comb_2
select -set operands c:p_twin_operand_*
select -set cmo c:p_twin_cmo_*
select -set commit_and_cmo c:p_twin_commit_comb_2 @cmo
select -assert-count 3 @cmo
select -assert-count 4 @commit_and_cmo
select -assert-count 4 @packets
select -assert-count 16 @operands
cmo: select -assert-count 1 c:c_twin_cmo_request t:$check %i r:FLAVOR=cover %i
bmc: chformal -assert -remove @packets @operands @cmo
bmc_cdb: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_twin_cdb %d
bmc_cdb_2: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_twin_cdb_2 %d
bmc_commit: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_twin_commit_comb %d
cmo: chformal -assert -remove t:$check r:FLAVOR=assert %i @commit_and_cmo %d
bmc_operands: chformal -assert -remove t:$check r:FLAVOR=assert %i @operands %d
bmc: select -assert-count 152 t:$check r:FLAVOR=assert %i
packet_only: select -assert-count 1 t:$check r:FLAVOR=assert %i
cmo: select -assert-count 4 t:$check r:FLAVOR=assert %i
bmc_operands: select -assert-count 16 t:$check r:FLAVOR=assert %i
cover_cmo_request: chformal -cover -remove t:$check r:FLAVOR=cover %i c:c_twin_cmo_request %d
cover_cmo_request: select -assert-count 1 t:$check r:FLAVOR=cover %i

