[tasks]
bmc
cover

[options]
bmc: mode bmc
# ROB BMC checks local safety invariants and one-cycle interface contracts.
# Depth history: smtbmc depth 8 blew the harness's 300 s CI ceiling; btormc
# cleared depth 16 (full buffer + pointer wraparound at 2-per-cycle
# allocation) in seconds. After the alloc-time pre-decoded commit-class FF
# vectors were added for x3 timing closure, depth 16 grew to ~11.5 min on a
# fast desktop and timed out CI's 40 min; depth 12 passes in ~40 s locally
# with ample CI margin (still well past the old depth-8 coverage, at the
# cost of no longer reaching full-buffer wraparound in one run).
bmc: depth 12
cover: mode cover
cover: depth 30

[engines]
bmc: btor btormc
cover: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv mwp_dist_ram.sv
read -formal -sv mwp_dist_ram_ohread.sv
read -formal -sv rob_serializer.sv
read -formal -sv reorder_buffer.sv
prep -top reorder_buffer

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
