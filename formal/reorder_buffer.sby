[tasks]
bmc
cover

[options]
bmc: mode bmc
# Check local safety invariants and one-cycle interface contracts. Depth 12
# limits runtime but does not reach a full buffer with pointer wraparound.
bmc: depth 12
cover: mode cover
cover: depth 30

[engines]
bmc: btor btormc
cover: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv mwp_dist_ram.sv
read -formal -sv mwp_dist_ram_ohread.sv
read -formal -sv rob_serializer.sv sfence_operand_store.sv
read -formal -sv reorder_buffer.sv
hierarchy -top reorder_buffer
script free_undefined.ys
prep -top reorder_buffer
select -assert-count 45 t:$check r:FLAVOR=assert %i
select -assert-count 14 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/sfence_operand_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
free_undefined.ys
