# Only the event serializer is observed; its input vectors are unconstrained.
perfretime: select -assert-count 4 c:p_perf_retime_* t:$check %i r:FLAVOR=assert %i
perfretime: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_perf_retime_* %d
perfretime: chformal -assume -remove t:$check r:FLAVOR=assume %i c:p_perf_retime_reset %d
perfretime: chformal -cover -remove
perfretime: cutpoint w:perf_raw w:perf_merge_hit_new w:perf_merge_miss_new
perfretime: delete -output w:*
memory_map
conflict: select -assert-min 1 t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
conflict: cutpoint t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
conflict: select -assert-none t:*ff* t:*FF* t:*latch*
conflict: delete -output w:*
conflict: opt_clean
# Leave only the check's cone.
putselect: delete -output w:*
opt
# Keep word operations for the long scheduled SMT covers.
~wordcover: techmap
opt -fast
setundef -anyseq
opt_clean

# Arbitrary state and both selector values cover every enabled valuation.
conflict: design -save conflict_cases
conflict: connect -set prefetch_busy 1'b0
conflict: opt -full
conflict: async2sync
conflict: setundef -anyseq
conflict: chformal -lower
conflict: select -assert-count 1 t:$assert
conflict: sat -seq 2 -prove-asserts -verify -timeout 60
conflict: design -load conflict_cases
conflict: connect -set prefetch_busy 1'b1
conflict: opt -full
conflict: async2sync
conflict: setundef -anyseq
conflict: chformal -lower
conflict: select -assert-count 1 t:$assert
conflict: sat -seq 2 -prove-asserts -verify -timeout 60

