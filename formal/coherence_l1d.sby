flook: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_full_cover_lookahead %d
fcovers: chformal -assert -remove
fwcover: select -assert-count 1 c:p_withdraw_full_cover t:$check %i r:FLAVOR=cover %i
fwcover: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_withdraw_full_cover %d
fwcover: chformal -assert -remove
