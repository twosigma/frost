[tasks]
coh_l1d_conflict_prove single conflict
coh_l1d_conflict_multi_prove multi conflict padded
coh_l1d_conflict_stream_prove stream multi conflict padded
coh_l1d_bmc single control control_single
coh_l1d_multi_bmc multi control control_multi padded
coh_l1d_stream_bmc stream multi control_stream padded longbmc streamscript payloadcontrol
coh_l1d_stream_hold_bmc stream multi cadical padded longbmc streamscript payloadhold
coh_l1d_stream_free_nostore_bmc stream multi control control_stream padded nostore payloadcontrol
coh_l1d_stream_free_nostore_hold_bmc stream multi control cadical padded nostore payloadhold
coh_l1d_stream_free_bmc stream multi control control_stream padded bulk
coh_l1d_stream_outlier_prove stream multi control padded pdr outlier
coh_l1d_stream_owned_prove stream multi padded streamread epphase streamowned
coh_l1d_stream_prove stream multi padded pdr unbounded streamread epphase
coh_l1d_stream_cover stream multi streamcovers covermode padded
coh_l1d_turn_cover turnstream multi turncovers covermode padded
coh_l1d_cover single covers covermode
coh_l1d_path_cover single pathcovers covermode
coh_l1d_data_bmc single data arraydata word0
coh_l1d_data1_bmc single data arraydata word1
coh_l1d_data2_bmc single data arraydata word2
coh_l1d_data3_bmc single data arraydata word3
coh_l1d_store_payload_bmc single data payload
coh_l1d_store_grant_bmc single data grantdata
coh_l1d_store_multi_payload_bmc multi data payload multidata
coh_l1d_store_multi_grant_bmc multi data grantdata multidata
coh_l1d_multi_data0_bmc multi data arraydata word0 multidata
coh_l1d_multi_data1_bmc multi data arraydata word1 multidata
coh_l1d_multi_data2_bmc multi data arraydata word2 multidata
coh_l1d_multi_data3_bmc multi cadical arraydata word3 multidata
coh_l1d_ways_data_bmc ways data arraydata word0 multidata

coh_l1d_local_prove single local owner
coh_l1d_local_multi_prove multi local owner padded
coh_l1d_local_owned_prove single owned epphase
coh_l1d_local_multi_owned_prove multi owned padded epphase
coh_l1d_local_ways_owned_prove ways owned padded epphase
coh_l1d_local_sector_prove single local sector
coh_l1d_local_multi_sector_prove multi local sector padded
coh_l1d_local_ways_sector_prove ways local sector padded
coh_l1d_local_cover single localcovers covermode localscheduled
coh_l1d_local_data_bmc single localschedule localscheduled localdata
coh_l1d_local_hold_bmc single localschedule localscheduled localhold
coh_l1d_local_control_bmc single localschedule localscheduled localcontrol
coh_l1d_local_ways_prove ways local owner padded

# cbo.zero writes: the zero-line control and data checks with zero writes on.
coh_l1d_zero_bmc single zcontrol control_single zero
coh_l1d_zero_multi_bmc multi zcontrol control_multi padded zero zmulti
coh_l1d_zero_payload_bmc single data zpayload zero
coh_l1d_zero_cover single zcovers zsingle covermode zero
coh_l1d_zero_lookahead_cover multi zcovers zlook covermode zero padded

[options]
~covermode: mode bmc
~covermode: depth 40
local: mode prove
local: depth 80
sector: depth 8
owned: mode prove
owned: depth 8
streamowned: mode prove
streamowned: depth 8
localschedule: depth 80
~covermode: timeout 1200
covermode: mode cover
covermode: depth 80
covermode: timeout 600
# The hit-path covers use free inputs, so they need longer than the scripted
# covers.
pathcovers: depth 40
pathcovers: timeout 1800
# The store cover reaches its last cover in about ten minutes.
covers: timeout 1200
zcovers: timeout 2400
# Retain reset and every transition, but avoid repeatedly rejecting shallow
# witnesses for a twin installation that freezes a Modified victim.
zsingle: skip 40
~covermode: aigsmt boolector
conflict: mode prove
conflict: depth 2
conflict: timeout 600
# The eight-endpoint stream BMC reads the stream cover's scripted loads, so
# its frames reach the speculative behavior; CI runs it in the hart
# maintenance proof's job. The free-input stream BMCs are shallower: their
# frames take about 1.3 times longer than the previous one. The free BMC with
# stores leaves out four assertions that the outlier proof covers without a
# depth bound, and shares a CI job with the four-way hit-port array BMC.
longbmc: timeout 3600
streamscript: depth 42
nostore: depth 24
bulk: depth 32
pdr: mode prove
bulk: timeout 10800
unbounded: timeout 2400
outlier: timeout 2400
nostore: timeout 3600
# The control BMCs check four ordered store records, local atomics and
# look-ahead admission. Each runs in its own CI job.
control_single: depth 40
control_single: timeout 10800
control_multi: timeout 18000
# Data tasks get about twice their measured duration, rounded up to five
# minutes; word variants share the word-0 representative's allowance.
coh_l1d_data_bmc: timeout 3900
coh_l1d_data1_bmc: timeout 3900
coh_l1d_data2_bmc: timeout 3900
coh_l1d_data3_bmc: timeout 3900
coh_l1d_store_payload_bmc: timeout 900
coh_l1d_store_grant_bmc: timeout 1200
coh_l1d_store_multi_payload_bmc: timeout 1800
coh_l1d_store_multi_grant_bmc: timeout 3600
coh_l1d_multi_data0_bmc: timeout 4200
coh_l1d_multi_data1_bmc: timeout 4200
coh_l1d_multi_data2_bmc: timeout 4200
coh_l1d_multi_data3_bmc: timeout 4200
coh_l1d_ways_data_bmc: timeout 5100
# The zero-write BMC with three endpoints stops short of the control BMC's
# depth to stay inside its allowance with the extra write kind.
zmulti: depth 30

[engines]
control_single: abc bmc3
pdr: abc pdr
control_multi: abc bmc3 -c
control_stream: abc bmc3
data: abc bmc3 -c
cadical: abc bmc3 -c
conflict: smtbmc boolector
covers: smtbmc boolector
pathcovers: smtbmc boolector
zcovers: smtbmc boolector
streamcovers: smtbmc boolector
turncovers: smtbmc boolector
owner: abc pdr
owned: smtbmc boolector
streamowned: smtbmc boolector
sector: smtbmc boolector
localdata: abc bmc3 -c
localhold: abc bmc3 -c
localcontrol: abc bmc3
localcovers: smtbmc boolector

[script]
read -sv coherence_read_stream.sv
read -sv cache_perf_pkg.sv
read -sv coherence_pkg.sv
# The read ownership lemmas read the request endpoints' phases.
epphase: read -formal -sv coherence_request_endpoint.sv
~epphase: read -sv coherence_request_endpoint.sv
read -sv coherence_put_endpoint.sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv coherence_grant_select.sv coherence_read_select.sv
control: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
streamread: read -formal -sv -D STREAM_UNBOUNDED_PROOF -D READ_OWNER_PROOF coherence_read_payload.sv coherence_l1d.sv
zcontrol: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
zcovers: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
zpayload: read -formal -sv -D ZERO_WRITES -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
streamscript: read -formal -sv -D STREAM_COVER -D STREAM_PASSIVE_CYCLES=24 coherence_read_payload.sv coherence_l1d.sv
conflict: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
streamcovers: read -formal -sv -D STREAM_COVER coherence_read_payload.sv coherence_l1d.sv
turncovers: read -formal -sv -D STREAM_TURN_COVER coherence_read_payload.sv coherence_l1d.sv
covers: read -formal -sv -D STORE_COVER -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
pathcovers: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
word0: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=0 coherence_read_payload.sv coherence_l1d.sv
word1: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=1 coherence_read_payload.sv coherence_l1d.sv
word2: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=2 coherence_read_payload.sv coherence_l1d.sv
word3: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=3 coherence_read_payload.sv coherence_l1d.sv
payload: read -formal -sv -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
grantdata: read -formal -sv -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
local: read -formal -sv -D LOCAL_ATOMIC_PROOF coherence_read_payload.sv coherence_l1d.sv
owned: read -formal -sv -D LOCAL_ATOMIC_PROOF -D READ_OWNER_PROOF coherence_read_payload.sv coherence_l1d.sv
localscheduled: read -formal -sv -D LOCAL_ATOMIC_PROOF -D LOCAL_ATOMIC_COVER coherence_read_payload.sv coherence_l1d.sv
read -sv coherence_store_buffer.sv
read -sv sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv
single: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 coherence_l1d
multi: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
stream: chparam -set MISSES 8 -set STREAM_PREFETCH 1 coherence_l1d
turnstream: chparam -set STREAM_PREFETCH 1 coherence_l1d
ways: chparam -set CACHE_BYTES 256 -set WAYS 4 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
# Tasks that drive no cbo.zero writes build the L1D without the zero path.
~zero: chparam -set ZERO_LINE 0 coherence_l1d
~conflict: prep -flatten -top coherence_l1d
conflict: hierarchy -check -top coherence_l1d
conflict: proc -noopt
conflict: flatten
conflict: opt_expr -keepdc -noclkinv
# The matching conflict proof supplies this guarded, clocked identity.
control: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
control: chformal -assert2assume c:p_prefetch_conflict_split
zcontrol: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
zcontrol: chformal -assert2assume c:p_prefetch_conflict_split
zcontrol: select -assert-min 1 c:p_zero_* t:$check %i r:FLAVOR=assert %i
streamscript: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
streamscript: chformal -assert2assume c:p_prefetch_conflict_split
# Separate wide holds from control without assumptions between groups. Each
# scripted or no-store pair keeps its original depth and input environment.
payloadcontrol: chformal -assert -remove c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
payloadcontrol: select -assert-min 1 t:$check r:FLAVOR=assert %i
payloadhold: select -assert-count 4 c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
payloadhold: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold %u %u %u %d
payloadhold: select -assert-count 4 t:$check r:FLAVOR=assert %i
unbounded: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
unbounded: chformal -assert2assume c:p_prefetch_conflict_split
# The stream ownership task proves the read ownership lemmas, the selected
# read's kind and the hit path's shadow rule by 8-step induction and assumes
# nothing from this task. The request endpoints' own checks run in their proofs.
unbounded: chformal -assert -remove t:$check r:FLAVOR=assert %i a:src=*coherence_request_endpoint.sv:* %i
unbounded: select -assert-count 17 t:$check r:FLAVOR=assert %i c:p_owned_* c:p_selected_kind c:p_path_shadowed %u %u %i
unbounded: chformal -assert2assume c:p_owned_* c:p_selected_kind c:p_path_shadowed
bulk: chformal -assert -remove c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
bulk: select -assert-count 322 t:$check r:FLAVOR=assert %i
outlier: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold %u %u %u %d
outlier: select -assert-count 4 t:$check r:FLAVOR=assert %i
# The unbounded stream proof leaves out the four outlier assertions, which the
# outlier task proves, and the assertions that PDR does not close: the pairwise
# distinctness of live endpoint lines, the store record address and acquisition
# checks, the prefetch window, prefetch acquisition window and atomic exclusion
# checks, the hit path's slot and answer checks, the pending-probe bound and a
# few others. Its read defines STREAM_UNBOUNDED_PROOF, which drops the
# loop-generated ones; the others carry the p_bounded_ label prefix.
unbounded: chformal -assert -remove c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
unbounded: chformal -assert -remove c:*p_bounded_* c:p_acquire_read_payload c:p_acquire_read_role c:p_atomic_no_load_endpoint c:p_atomic_single_owner c:p_atomic_store_exclusive c:p_block_zero_exact c:p_grant_live c:p_grant_prefetch_flag c:p_prefetch_hint_conflict c:p_prefetch_owner_conflict c:p_read_owned_exact c:p_request_payload c:p_store_acquire_once c:p_store_grant_head c:p_store_grant_head_exact c:p_store_head_address c:p_store_head_valid c:p_store_install_address c:p_store_read_service_bound c:p_store_yields_read
unbounded: select -assert-count 165 t:$check r:FLAVOR=assert %i
conflict: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
conflict: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_prefetch_conflict_split %d
conflict: chformal -assume -remove
conflict: chformal -cover -remove
# The scripted store covers issue one load, which the hit path cannot take;
# the hit-path covers run with free inputs and only the interface assumptions.
covers: chformal -cover -remove c:c_path_*
pathcovers: select -assert-count 6 c:c_path_*
pathcovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:c_path_* %d
pathcovers: chformal -assert -remove
streamcovers: select -assert-count 4 c:*p_stream_two c:*p_stream_attach c:*p_stream_lr_admit c:*p_stream_amo_admit
streamcovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:*p_stream_two c:*p_stream_attach c:*p_stream_lr_admit c:*p_stream_amo_admit %u %u %u %d
# Control assertions run in the control tasks; this task checks the datapath.
# The zero-control tasks keep every zero-line assertion. The payload task
# checks the five store payload assertions at the same depth, without
# assuming any of the zero-control assertions or repeating them.
zpayload: select -assert-count 5 c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5
zpayload: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5 %u %u %u %u %d
zpayload: select -assert-count 5 t:$check r:FLAVOR=assert %i
zcovers: select -assert-count 5 c:p_zero_cover_* t:$check %i r:FLAVOR=cover %i
zsingle: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_cover_twin c:p_zero_cover_twin_victim c:p_zero_cover_twin_wait c:p_zero_cover_fallback %u %u %u %d
zsingle: select -assert-count 4 t:$check r:FLAVOR=cover %i
zlook: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_cover_lookahead %d
zcovers: chformal -assert -remove
payload: select -assert-count 5 c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5
payload: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5 %u %u %u %u %d
arraydata: select -assert-count 4 c:p_store_data_6 c:p_store_data_7 c:p_store_data_path c:p_store_data_path_known
arraydata: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_6 c:p_store_data_7 c:p_store_data_path c:p_store_data_path_known %u %u %u %d
grantdata: select -assert-count 3 c:p_store_data_8 c:p_store_data_9 c:p_store_data_10
grantdata: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_8 c:p_store_data_9 c:p_store_data_10 %u %u %d
turncovers: select -assert-count 4 c:p_stream_read_turn c:p_stream_empty_turn c:p_stream_probe_turn c:p_stream_cancel_turn
turncovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_stream_read_turn c:p_stream_empty_turn c:p_stream_probe_turn c:p_stream_cancel_turn %u %u %u %d
local: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_local_* c:p_atomic_context_identity c:p_atomic_read_identity c:p_selected_kind %u %u %u %d
local: chformal -assert -remove c:p_local_probe_data
# Each owned task proves the local atomic lemmas, the read ownership lemmas and
# the selected read's kind by 8-step induction and assumes nothing from the
# owner or sector tasks.
owned: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_local_failed_owned c:p_owned_* c:p_local_write_pending c:p_local_write_op c:p_local_amo_acquire c:p_local_acquired_amo c:p_local_phase c:p_local_granted c:p_local_acquired_sc c:p_local_active c:p_local_service c:p_local_failure c:p_selected_kind %u %u %u %u %u %u %u %u %u %u %u %u %d
owned: select -assert-count 28 t:$check r:FLAVOR=assert %i
streamowned: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_owned_* c:p_selected_kind c:p_path_shadowed %u %u %d
streamowned: select -assert-count 17 t:$check r:FLAVOR=assert %i
# The matching owned task proves these facts by unbounded induction.
owner: chformal -assert2assume c:p_local_failed_owned c:p_local_write_pending c:p_local_write_op c:p_local_amo_acquire c:p_local_acquired_amo c:p_local_phase c:p_local_granted c:p_local_acquired_sc c:p_local_active c:p_local_service c:p_local_failure c:p_selected_kind
owner: chformal -assert -remove c:p_local_sector c:p_local_lookup_stable c:p_local_conflict_sample c:p_local_admit_sector
owner: select -assert-count 16 t:$check r:FLAVOR=assert %i
owner: select -assert-count 2 c:p_local_lookup_owner c:p_local_sc_lookup %u t:$check %i r:FLAVOR=assert %i
sector: select -assert-count 8 c:p_local_sector c:p_local_lookup_stable c:p_local_conflict_sample c:p_local_admit_sector c:p_local_lookup_owner c:p_local_service c:p_local_sc_lookup c:p_local_active
sector: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_local_sector c:p_local_lookup_stable c:p_local_conflict_sample c:p_local_admit_sector c:p_local_lookup_owner c:p_local_service c:p_local_sc_lookup c:p_local_active %u %u %u %u %u %u %u %d
# The matching owner task proves both lookup facts by unbounded induction.
sector: chformal -assert2assume c:p_local_lookup_owner c:p_local_sc_lookup
sector: select -assert-count 6 t:$check r:FLAVOR=assert %i
sector: select -assert-count 2 c:p_local_lookup_owner c:p_local_sc_lookup %u t:$check %i r:FLAVOR=assume %i
# Array behavior is arbitrary for controller induction. Real-array byte and
# completion checks run in the bounded tasks and the array proofs.
owned: cutpoint w:array_ready w:array_valid w:array_hit w:array_state w:array_addr w:array_data w:array_way w:array_available w:update_ready
local: cutpoint w:array_ready w:array_valid w:array_hit w:array_state w:array_addr w:array_data w:array_way w:array_available w:update_ready
localcovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_local_probe_cover c:p_local_fail_cover c:p_local_release_cover %u %u %d
# Partition the scheduled real-array BMC without assuming any assertion. The
# data task checks arbitrary-byte preservation and deferred probe data; the
# hold task checks the wide payload identities. The control task keeps every
# other assertion, including future additions. All three keep depth 80.
localdata: select -assert-count 2 c:p_local_image c:p_local_probe_data
localdata: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_local_image c:p_local_probe_data %u %d
localdata: select -assert-count 2 t:$check r:FLAVOR=assert %i
localhold: select -assert-count 4 c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
localhold: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold %u %u %u %d
localhold: select -assert-count 4 t:$check r:FLAVOR=assert %i
localcontrol: chformal -assert -remove c:p_local_image c:p_local_probe_data c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold
localcontrol: select -assert-min 1 t:$check r:FLAVOR=assert %i
nostore: connect -set i_write_mask 8'h00
~zero: connect -set i_write_zero 1'b0
memory_map
conflict: select -assert-min 1 t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
conflict: cutpoint t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
conflict: select -assert-none t:*ff* t:*FF* t:*latch*
conflict: delete -output w:*
conflict: opt_clean
opt
techmap
opt -fast
setundef -anyseq
opt_clean

# Arbitrary state and both selector values cover every enabled valuation.
conflict: design -save conflict_cases
conflict: connect -set prefetch_busy 1'b0
conflict: opt -full
conflict: async2sync
conflict: chformal -lower
conflict: select -assert-count 1 t:$assert
conflict: sat -seq 2 -prove-asserts -verify -timeout 60
conflict: design -load conflict_cases
conflict: connect -set prefetch_busy 1'b1
conflict: opt -full
conflict: async2sync
conflict: chformal -lower
conflict: select -assert-count 1 t:$assert
conflict: sat -seq 2 -prove-asserts -verify -timeout 60

