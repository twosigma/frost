[tasks]
coh_l1d_perf_prove stream multi perfretime
coh_l1d_conflict_prove single conflict
coh_l1d_conflict_multi_prove multi conflict padded
coh_l1d_conflict_stream_prove stream multi conflict padded
coh_l1d_bmc single control control_single
coh_l1d_multi_bmc multi control control_multi padded
# The scripted and the free stream control BMCs use the cadical engine. On the
# default engine their last frames pass or stall with unrelated logic changes.
coh_l1d_stream_bmc stream multi cadical padded longbmc streamscript streambounded
coh_l1d_stream_hold_bmc stream multi cadical padded longbmc streamscript payloadhold
coh_l1d_stream_free_nostore_bmc stream multi control control_stream padded nostore streambounded
coh_l1d_stream_free_nostore_hold_bmc stream multi control cadical padded nostore payloadhold
coh_l1d_stream_free_bmc stream multi control cadical padded bulk streambounded
coh_l1d_stream_outlier_prove stream multi control padded pdr outlier
coh_l1d_stream_owned_prove stream multi padded streamread epphase streamowned bufdefines
coh_l1d_stream_snapshot_prove stream multi padded streamread epphase streamsnap bufdefines
coh_l1d_stream_prove stream multi padded pdr unbounded streamread epphase bufdefines
coh_l1d_stream_cover stream multi streamcovers covermode padded
coh_l1d_snapshot_cover single snapcover covermode wordcover
coh_l1d_turn_cover turnstream multi turncovers covermode padded
coh_l1d_cover single covers covermode
coh_l1d_path_cover single pathcovers covermode
coh_l1d_put_select_prove single putselect
coh_l1d_data_bmc single data arraydata word0
coh_l1d_data1_bmc single data arraydata word1
coh_l1d_data2_bmc single data arraydata word2
coh_l1d_data3_bmc single data arraydata word3
coh_l1d_store_payload_bmc single data payload
coh_l1d_store_grant_bmc single data grantdata
coh_l1d_store_multi_payload_bmc multi data payload multidata
coh_l1d_store_multi_grant_bmc multi data grantdata multidata
coh_l1d_multi_data0_bmc multi data arraydata word0 multidata
coh_l1d_multi_data1_bmc multi data arraydata word1 multidata
coh_l1d_multi_data2_bmc multi data arraydata word2 multidata
coh_l1d_multi_data3_bmc multi cadical arraydata word3 multidata
coh_l1d_ways_data_bmc ways data arraydata word0 multidata
coh_l1d_answer_bmc multi answer padded
coh_l1d_stream_answer_bmc stream multi answer padded streamanswer

coh_l1d_local_prove single local owner
coh_l1d_local_multi_prove multi local owner padded
coh_l1d_local_owned_prove single owned epphase
coh_l1d_local_multi_owned_prove multi owned padded epphase
coh_l1d_local_ways_owned_prove ways owned padded epphase
coh_l1d_local_sector_prove single local sector
coh_l1d_local_multi_sector_prove multi local sector padded
coh_l1d_local_ways_sector_prove ways local sector padded
coh_l1d_local_cover single localcovers covermode localscheduled
coh_l1d_local_data_bmc single localschedule localscheduled localdata
coh_l1d_local_hold_bmc single localschedule localscheduled localhold
coh_l1d_local_control_bmc single localschedule localscheduled localcontrol
coh_l1d_local_ways_prove ways local owner padded

# cbo.zero writes: the zero-line control and data checks with zero writes on.
coh_l1d_zero_bmc single zcontrol control_single zero
coh_l1d_zero_multi_bmc multi zcontrol control_multi padded zero zmulti
coh_l1d_zero_payload_bmc single data zpayload zero
coh_l1d_zero_cover single zcovers zsingle covermode zero
coh_l1d_zero_lookahead_cover multi zcovers zlook covermode zero padded
# The zero stream model: three endpoints with stream prefetching, cbo.zero
# writes and full-line stores. The store queue's write-more hint and
# same-sector claim are free, so these tasks also check every trace in which
# the hints stay low. The two stream properties that predate the request
# checks run in one task.
coh_l1d_zero_stream_hint_bmc turnstream multi cadical padded zero zstreamhint
# The two zero request properties on the same model: the same-block twin rule
# in one task, and upper-sector request exclusion in one task per holding
# endpoint, whose three cases together are the property. Endpoint 1's case is
# split again by the operation in operation_q when the request is accepted;
# its five parts together are that case. Endpoint 0's case runs on CaDiCaL,
# unlike the other cases: on CaDiCaL its time per frame grows steadily, and
# on Glucose single late frames of this case take about half an hour.
coh_l1d_zero_stream_line_bmc turnstream multi padded zero zstreamline
coh_l1d_zero_stream_upper_ep0_bmc turnstream multi cadical padded zero zstreamupper upperep0
coh_l1d_zero_stream_upper_ep1_read_bmc turnstream multi padded zero zstreamupper upperglucose upperep1read
coh_l1d_zero_stream_upper_ep1_store_bmc turnstream multi padded zero zstreamupper upperglucose upperep1store
coh_l1d_zero_stream_upper_ep1_lookahead_bmc turnstream multi padded zero zstreamupper upperglucose upperep1lookahead
coh_l1d_zero_stream_upper_ep1_prefetch_bmc turnstream multi padded zero zstreamupper upperglucose upperep1prefetch
coh_l1d_zero_stream_upper_ep1_rest_bmc turnstream multi padded zero zstreamupper upperglucose upperep1rest
coh_l1d_zero_stream_upper_ep2_bmc turnstream multi padded zero zstreamupper upperglucose upperep2
coh_l1d_zero_progress_cover multi zprogress covermode zero padded wordcover
coh_l1d_zero_stream_bmc turnstream multi zrequest zero padded
coh_l1d_zero_request_cover turnstream multi zrequest zrequestcover covermode zero padded wordcover

# Full-line stores: the zero-line and full-pair checks with every write a
# scalar store, so the depth goes to filling and pairing records.
coh_l1d_full_bmc single fcontrol control_single zero fullonly
coh_l1d_full_multi_bmc multi fcontrol control_multi padded zero zmulti fullonly
coh_l1d_full_payload_bmc single data fpayload zero fullonly
coh_l1d_full_cover single fcovers fsingle covermode zero fullonly
coh_l1d_full_lookahead_cover multi fcovers flook covermode zero padded fullonly

# Full-line and zero-line stores with the absorbed-put withdrawal that
# cpu_top sets with MEMORY_LINK_STAGES above 0 (WITHDRAW_ABSORBED_W).
coh_l1d_withdraw_full_bmc single fcontrol control_single zero fullonly withdraw
coh_l1d_withdraw_zero_bmc single zcontrol control_single zero withdraw
coh_l1d_withdraw_full_payload_bmc single data fpayload zero fullonly withdraw
coh_l1d_withdraw_zero_payload_bmc single data zpayload zero withdraw
coh_l1d_withdraw_full_cover single fwcover covermode zero fullonly withdraw
# Full-line holds: the gather and pair holds and claimed credit at three and
# four records with one endpoint.
coh_l1d_full_hold_cover single fhcover covermode zero fullonly
# The store buffer's interface contract, which its own proofs assume, checked
# as assertions on the L1D that drives it: zero and full-line writes with the
# store queue's hints free and three endpoints, so pair and look-ahead
# acquisitions both occur.
coh_l1d_buffer_contract_bmc multi fcontrol control_multi padded zero zmulti contract bufdefines

[options]
~covermode: mode bmc
~covermode: depth 40
local: mode prove
local: depth 80
sector: depth 8
owned: mode prove
owned: depth 8
streamowned: mode prove
streamowned: depth 8
streamsnap: mode prove
streamsnap: depth 3
localschedule: depth 80
~covermode: timeout 1200
streamsnap: timeout 600
covermode: mode cover
covermode: depth 80
covermode: timeout 600
# The stream witnesses include the eight-endpoint state and need time to
# serialize after the cover queries complete.
streamcovers: timeout 1200
# The hit-path covers use free inputs, so they need longer than the scripted
# covers.
pathcovers: depth 40
pathcovers: timeout 1800
snapcover: depth 70
snapcover: vcd_sim on
# The store cover reaches its last cover in about ten minutes.
covers: timeout 1200
zcovers: timeout 2400
fcovers: timeout 7200
# Measured at 2342 seconds; the allowance is 2.2 times that, rounded up to
# a whole minute (86 minutes).
fwcover: timeout 5160
fwcover: vcd_sim on
fwcover: skip 48
fhcover: timeout 1200
fhcover: vcd_sim on
zsingle: vcd_sim on
# Keep every transition from reset, but query only the later cover window.
# Reaching a dirty twin victim requires several completed transactions.
zsingle: skip 48
# The single-endpoint zero cover reaches its last cover in 53 to 109 minutes
# running beside one other formal job and needs about three hours on the
# build host with the trial tree's cbo.zero changes.
coh_l1d_zero_cover: timeout 14400
fsingle: vcd_sim on
~covermode: aigsmt boolector
conflict: mode prove
conflict: depth 2
conflict: timeout 600
# The W-selector check is one-step inductive on the selector registers.
putselect: mode prove
putselect: depth 2
putselect: timeout 600
# The eight-endpoint stream BMC reads the stream cover's scripted loads.
# All three control BMCs leave five payload checks to the independent
# unbounded outlier proof, whose free-input model covers each specialization.
# Matching scripted and no-store hold tasks also check those five assertions
# at the original bounds. No partition assumes facts from another partition.
# The free BMC with stores shares a job with the four-way hit-port array BMC.
longbmc: timeout 3600
# With full-line stores in the model the scripted stream BMC takes about 37
# minutes; CI runners take up to about 2.2 times as long.
coh_l1d_stream_bmc: timeout 5100
streamscript: depth 42
nostore: depth 24
bulk: depth 32
pdr: mode prove
bulk: timeout 10800
unbounded: timeout 2400
outlier: timeout 2400
nostore: timeout 3600
# The control BMCs check four ordered store records, local atomics and
# look-ahead admission. Each runs in its own CI job.
control_single: depth 40
control_single: timeout 10800
# With free_undefined.ys, coh_l1d_bmc measured 10,283 s and coh_l1d_multi_bmc
# measured 15,407 s; give both headroom inside their dedicated CI jobs.
coh_l1d_bmc: timeout 14400
control_multi: timeout 18000
coh_l1d_multi_bmc: timeout 20400
# Data tasks get about twice their measured duration, rounded up to five
# minutes; word variants share the word-0 representative's allowance.
coh_l1d_data_bmc: timeout 3900
coh_l1d_data1_bmc: timeout 3900
coh_l1d_data2_bmc: timeout 3900
coh_l1d_data3_bmc: timeout 3900
coh_l1d_store_payload_bmc: timeout 900
# The zero and full payload BMCs build the L1D with both twin kinds; they
# take about 40 minutes on a loaded host. The full-line one took 41 minutes
# here and gets about 2.2 times that for slower CI runners.
coh_l1d_zero_payload_bmc: timeout 5400
coh_l1d_full_payload_bmc: timeout 5700
coh_l1d_withdraw_zero_payload_bmc: timeout 5400
coh_l1d_withdraw_full_payload_bmc: timeout 5400
coh_l1d_store_grant_bmc: timeout 1200
coh_l1d_store_multi_payload_bmc: timeout 1800
coh_l1d_store_multi_grant_bmc: timeout 3600
coh_l1d_multi_data0_bmc: timeout 4200
coh_l1d_multi_data1_bmc: timeout 4200
coh_l1d_multi_data2_bmc: timeout 4200
coh_l1d_multi_data3_bmc: timeout 4200
coh_l1d_ways_data_bmc: timeout 5100
# The zero-write BMC with three endpoints stops short of the control BMC's
# depth to stay inside its allowance with the extra write kind. With streaming
# enabled on the same three-endpoint geometry, a prefetch into a cbo.zero twin
# is first reachable at step 29.
zmulti: depth 30
contract: timeout 900
zstreamhint: depth 31
zstreamline: depth 31
zstreamline: timeout 3600
zstreamupper: depth 31
# Measured: the endpoint 0 and 2 cases take about 46 and 10 minutes, and
# endpoint 1's read, store, look-ahead, prefetch and remaining-operation parts
# 846, 229, 27, 35 and 24 seconds (155 minutes as one task); each allowance is
# at least 2.2 times that for slower CI runners.
coh_l1d_zero_stream_upper_ep0_bmc: timeout 6120
coh_l1d_zero_stream_upper_ep1_read_bmc: timeout 2100
coh_l1d_zero_stream_upper_ep1_store_bmc: timeout 600
coh_l1d_zero_stream_upper_ep1_lookahead_bmc: timeout 300
coh_l1d_zero_stream_upper_ep1_prefetch_bmc: timeout 300
coh_l1d_zero_stream_upper_ep1_rest_bmc: timeout 300
coh_l1d_zero_stream_upper_ep2_bmc: timeout 1500
zprogress: depth 160
zprogress: timeout 1200
zprogress: vcd_sim on
zprogress: skip 128
zrequest: depth 170
zrequest: timeout 1200
zrequest: vcd_sim on
zrequestcover: timeout 2400
zrequestcover: skip 159
zrequestcover: vcd_sim on
# The answer BMCs check only the read-answer properties: grant answers of
# attached loads and same-sector merges, against stores, probes, the hit path
# and duplicate answers. The eight-endpoint task is shallower, as the free
# stream BMCs are.
answer: depth 20
answer: timeout 3600
streamanswer: depth 16

perfretime: mode prove
perfretime: depth 4
perfretime: timeout 120

[engines]
perfretime: smtbmc boolector
coh_l1d_bmc: abc bmc3
# With zero writes and full-line stores in the model, Glucose finishes the
# single-endpoint control BMCs in about half the default engine's time.
coh_l1d_zero_bmc: abc bmc3 -g
coh_l1d_full_bmc: abc bmc3 -g
coh_l1d_withdraw_full_bmc: abc bmc3 -g
coh_l1d_withdraw_zero_bmc: abc bmc3 -g
pdr: abc pdr
control_multi: abc bmc3 -c
control_stream: abc bmc3
data: abc bmc3 -c
cadical: abc bmc3 -c
conflict: smtbmc boolector
covers: smtbmc boolector
pathcovers: smtbmc boolector
zsingle: smtbmc boolector
zlook: smtbmc boolector
zstreamline: abc bmc3 -g
upperglucose: abc bmc3 -g
zprogress: smtbmc boolector
coh_l1d_zero_stream_bmc: abc bmc3 -c
zrequestcover: smtbmc boolector
fsingle: smtbmc boolector
flook: smtbmc boolector
fwcover: smtbmc boolector
fhcover: smtbmc boolector
streamcovers: smtbmc boolector
turncovers: smtbmc boolector
owner: abc pdr
owned: smtbmc boolector
streamowned: smtbmc boolector
streamsnap: smtbmc boolector
snapcover: smtbmc boolector
sector: smtbmc boolector
putselect: smtbmc boolector
localdata: abc bmc3 -c
localhold: abc bmc3 -c
localcontrol: abc bmc3
localcovers: smtbmc boolector
answer: abc bmc3 -c

[script]
read -sv coherence_read_stream.sv
read -sv cache_perf_pkg.sv
read -sv coherence_pkg.sv
# The read ownership lemmas read the request endpoints' phases.
epphase: read -formal -sv coherence_request_endpoint.sv
~epphase: read -sv coherence_request_endpoint.sv
read -sv coherence_put_endpoint.sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv coherence_grant_select.sv coherence_read_select.sv
perfretime: read -formal -sv -D PERF_EVENT_PROOF coherence_read_payload.sv coherence_l1d.sv
control: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
streamread: read -formal -sv -D STREAM_UNBOUNDED_PROOF -D READ_OWNER_PROOF -D SNAPSHOT_OWNER_PROOF coherence_read_payload.sv coherence_l1d.sv
snapcover: read -formal -sv -D SNAPSHOT_OWNER_COVER coherence_read_payload.sv coherence_l1d.sv
zcontrol: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
zcovers: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
zpayload: read -formal -sv -D ZERO_WRITES -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
zstreamhint: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
zstreamline: read -formal -sv -D ZERO_WRITES coherence_read_payload.sv coherence_l1d.sv
upperep0: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=0 coherence_read_payload.sv coherence_l1d.sv
upperep1read: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=1 -D ZERO_UPPER_OP=ReadOp coherence_read_payload.sv coherence_l1d.sv
upperep1store: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=1 -D ZERO_UPPER_OP=StoreOp coherence_read_payload.sv coherence_l1d.sv
upperep1lookahead: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=1 -D ZERO_UPPER_OP=LookaheadOp coherence_read_payload.sv coherence_l1d.sv
upperep1prefetch: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=1 -D ZERO_UPPER_OP=PrefetchOp coherence_read_payload.sv coherence_l1d.sv
upperep1rest: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=1 -D ZERO_UPPER_OP_REST coherence_read_payload.sv coherence_l1d.sv
upperep2: read -formal -sv -D ZERO_WRITES -D ZERO_UPPER_EP=2 coherence_read_payload.sv coherence_l1d.sv
zprogress: read -formal -sv -D ZERO_WRITES -D ZERO_PROGRESS_COVER coherence_read_payload.sv coherence_l1d.sv
zrequest: read -formal -sv -D ZERO_WRITES -D ZERO_REQUEST_PROOF coherence_read_payload.sv coherence_l1d.sv
fcontrol: read -formal -sv -D ZERO_WRITES -D FULL_WRITES coherence_read_payload.sv coherence_l1d.sv
fcovers: read -formal -sv -D ZERO_WRITES -D FULL_WRITES coherence_read_payload.sv coherence_l1d.sv
fwcover: read -formal -sv -D ZERO_WRITES -D FULL_WRITES coherence_read_payload.sv coherence_l1d.sv
fhcover: read -formal -sv -D ZERO_WRITES -D FULL_WRITES coherence_read_payload.sv coherence_l1d.sv
fpayload: read -formal -sv -D ZERO_WRITES -D FULL_WRITES -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
streamscript: read -formal -sv -D STREAM_COVER -D STREAM_PASSIVE_CYCLES=24 coherence_read_payload.sv coherence_l1d.sv
conflict: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
streamcovers: read -formal -sv -D STREAM_COVER coherence_read_payload.sv coherence_l1d.sv
turncovers: read -formal -sv -D STREAM_TURN_COVER coherence_read_payload.sv coherence_l1d.sv
covers: read -formal -sv -D STORE_COVER -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
pathcovers: read -formal -sv coherence_read_payload.sv coherence_l1d.sv
putselect: read -formal -sv -D PUT_SELECT_PROOF coherence_read_payload.sv coherence_l1d.sv
word0: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=0 coherence_read_payload.sv coherence_l1d.sv
word1: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=1 coherence_read_payload.sv coherence_l1d.sv
word2: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=2 coherence_read_payload.sv coherence_l1d.sv
word3: read -formal -sv -D STORE_DATA_PROOF -D STORE_BYTE_WORD=3 coherence_read_payload.sv coherence_l1d.sv
payload: read -formal -sv -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
grantdata: read -formal -sv -D STORE_DATA_PROOF coherence_read_payload.sv coherence_l1d.sv
local: read -formal -sv -D LOCAL_ATOMIC_PROOF coherence_read_payload.sv coherence_l1d.sv
owned: read -formal -sv -D LOCAL_ATOMIC_PROOF -D READ_OWNER_PROOF coherence_read_payload.sv coherence_l1d.sv
localscheduled: read -formal -sv -D LOCAL_ATOMIC_PROOF -D LOCAL_ATOMIC_COVER coherence_read_payload.sv coherence_l1d.sv
answer: read -formal -sv -D READ_ANSWER_PROOF coherence_read_payload.sv coherence_l1d.sv
# The contract task reads the buffer's controller-side assertions, never its
# FORMAL assumptions.
~bufdefines: read -sv coherence_store_buffer.sv
streamread: read -sv -D SNAPSHOT_OWNER_PROOF coherence_store_buffer.sv
contract: read -sv -D BUFFER_CONTRACT coherence_store_buffer.sv
~streamread: read -sv sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv
streamread: read -sv -D SNAPSHOT_OWNER_PROOF sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv
single: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 coherence_l1d
withdraw: chparam -set WITHDRAW_ABSORBED_W 1 coherence_l1d
multi: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
stream: chparam -set MISSES 8 -set STREAM_PREFETCH 1 coherence_l1d
turnstream: chparam -set STREAM_PREFETCH 1 coherence_l1d
ways: chparam -set CACHE_BYTES 256 -set WAYS 4 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
# Tasks that drive no cbo.zero writes build the L1D without the zero path
# and without full-line stores; the zero and full tasks build both.
~zero: chparam -set ZERO_LINE 0 -set FULL_LINE 0 coherence_l1d
~conflict: hierarchy -top coherence_l1d
~conflict: script free_undefined.ys
~conflict: prep -flatten -top coherence_l1d
conflict: hierarchy -check -top coherence_l1d
conflict: script free_undefined.ys
conflict: flatten
conflict: opt_expr -keepdc -noclkinv
# The matching conflict proof supplies this guarded, clocked identity.
control: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
control: chformal -assert2assume c:p_prefetch_conflict_split
zcontrol: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
zcontrol: chformal -assert2assume c:p_prefetch_conflict_split
zcontrol: select -assert-min 1 c:p_zero_* t:$check %i r:FLAVOR=assert %i
fcontrol: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
fcontrol: chformal -assert2assume c:p_prefetch_conflict_split
fcontrol: select -assert-min 1 c:p_full_* t:$check %i r:FLAVOR=assert %i
streamscript: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
streamscript: chformal -assert2assume c:p_prefetch_conflict_split
# The stream model admits all four probe opcodes. The control partition
# includes the absorbed-owner, snapshot-image control and held-reply assertions.
# The independent outlier proof assumes no BMC or ownership assertions.
streambounded: select -assert-count 332 t:$check r:FLAVOR=assert %i
payloadhold: select -assert-count 332 t:$check r:FLAVOR=assert %i
outlier: select -assert-count 332 t:$check r:FLAVOR=assert %i
streambounded: chformal -assert -remove c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold c:p_snapshot_credit_data
streambounded: select -assert-count 327 t:$check r:FLAVOR=assert %i
payloadhold: select -assert-count 5 c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold c:p_snapshot_credit_data
payloadhold: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold c:p_snapshot_credit_data %u %u %u %u %d
payloadhold: select -assert-count 5 t:$check r:FLAVOR=assert %i
# The snapshot ownership task proves absorbed-PutM ownership disjointness by
# 3-step induction using only the read ownership lemmas.
streamsnap: chformal -assert -remove t:$check r:FLAVOR=assert %i a:src=*coherence_request_endpoint.sv:* %i
streamsnap: select -assert-count 18 t:$check r:FLAVOR=assert %i c:p_owned_* c:p_selected_kind c:p_path_shadowed %u %u %i
streamsnap: chformal -assert2assume c:p_owned_* c:p_selected_kind c:p_path_shadowed
streamsnap: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_snapshot_absorbed_clean c:p_snapshot_put_owner c:p_snap_* %u %u %d
streamsnap: select -assert-count 53 t:$check r:FLAVOR=assert %i
streamsnap: select -assert-count 1 c:p_snapshot_absorbed_clean t:$check %i r:FLAVOR=assert %i
unbounded: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
unbounded: chformal -assert2assume c:p_prefetch_conflict_split
# The stream ownership task proves the read ownership lemmas, the selected
# read's kind and the hit path's shadow rule by 8-step induction and assumes
# nothing from this task. The snapshot ownership task proves the absorbed-PutM
# ownership lemma by 3-step induction using only those read ownership lemmas.
# The request endpoints' own checks run in their proofs.
unbounded: chformal -assert -remove t:$check r:FLAVOR=assert %i a:src=*coherence_request_endpoint.sv:* %i
unbounded: select -assert-count 18 t:$check r:FLAVOR=assert %i c:p_owned_* c:p_selected_kind c:p_path_shadowed %u %u %i
unbounded: chformal -assert2assume c:p_owned_* c:p_selected_kind c:p_path_shadowed
unbounded: select -assert-count 1 c:p_snapshot_absorbed_clean t:$check %i r:FLAVOR=assert %i
unbounded: chformal -assert2assume c:p_snapshot_absorbed_clean
unbounded: chformal -assert -remove c:p_snap_*
outlier: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold c:p_snapshot_credit_data %u %u %u %u %d
outlier: select -assert-count 5 t:$check r:FLAVOR=assert %i
# The unbounded stream proof leaves out the five outlier assertions, which the
# outlier task proves, and the assertions that PDR does not close: the pairwise
# distinctness of live endpoint lines, the store record address and acquisition
# checks, the prefetch window, prefetch acquisition window and atomic exclusion
# checks, the hit path's slot and answer checks, the pending-probe bound, the
# Modified-sector and prefetch-record checks that the stream BMCs prove, and a
# few others. Its read defines STREAM_UNBOUNDED_PROOF, which drops the
# loop-generated ones; the others carry the p_bounded_ label prefix.
unbounded: chformal -assert -remove c:p_grant_mux_exact c:p_local_image_stable c:p_load_payload_held c:p_reply_hold c:p_snapshot_credit_data
unbounded: chformal -assert -remove c:*p_bounded_* c:p_acquire_read_payload c:p_acquire_read_role c:p_atomic_no_load_endpoint c:p_atomic_single_owner c:p_atomic_store_exclusive c:p_block_zero_exact c:p_grant_live c:p_grant_prefetch_flag c:p_prefetch_hint_conflict c:p_prefetch_owner_conflict c:p_grant_keeps_modified c:p_prefetch_not_record c:p_read_owned_exact c:p_request_payload c:p_store_acquire_once c:p_store_grant_head c:p_store_grant_head_exact c:p_store_head_address c:p_store_head_valid c:p_store_install_address c:p_store_read_service_bound c:p_store_yields_read
unbounded: select -assert-count 168 t:$check r:FLAVOR=assert %i
conflict: select -assert-count 1 c:p_prefetch_conflict_split t:$check %i r:FLAVOR=assert %i
conflict: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_prefetch_conflict_split %d
conflict: chformal -assume -remove
conflict: chformal -cover -remove
# The W-selector task keeps only its own check, with no input assumptions.
putselect: select -assert-count 1 c:p_put_select_clears t:$check %i r:FLAVOR=assert %i
putselect: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_put_select_clears %d
putselect: chformal -assume -remove
putselect: chformal -cover -remove
putselect: select -assert-count 1 t:$check r:FLAVOR=assert %i
# The scripted store covers issue one load, which the hit path cannot take;
# the hit-path covers run with free inputs and only the interface assumptions.
covers: chformal -cover -remove c:c_path_*
pathcovers: select -assert-count 6 c:c_path_*
pathcovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:c_path_* %d
pathcovers: chformal -assert -remove
streamcovers: select -assert-count 4 c:*p_stream_two c:*p_stream_attach c:*p_stream_lr_admit c:*p_stream_amo_admit
streamcovers: chformal -cover -remove t:$check r:FLAVOR=cover %i c:*p_stream_two c:*p_stream_attach c:*p_stream_lr_admit c:*p_stream_amo_admit %u %u %u %d
snapcover: select -assert-count 5 c:c_sc_wb_* c:c_snapshot_* %u t:$check %i r:FLAVOR=cover %i
snapcover: chformal -cover -remove t:$check r:FLAVOR=cover %i c:c_sc_wb_* c:c_snapshot_* %u %d
snapcover: select -assert-count 5 t:$check r:FLAVOR=cover %i
snapcover: chformal -assert -remove
# Control assertions run in the control tasks; this task checks the datapath.
# The zero-control tasks keep every zero-line assertion. The payload task
# checks the five store payload assertions at the same depth, without
# assuming any of the zero-control assertions or repeating them.
zpayload: select -assert-count 5 c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5
zpayload: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5 %u %u %u %u %d
zpayload: select -assert-count 5 t:$check r:FLAVOR=assert %i
fpayload: select -assert-count 5 c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5
fpayload: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_store_data_1 c:p_store_data_2 c:p_store_data_3 c:p_store_data_4 c:p_store_data_5 %u %u %u %u %d
fpayload: select -assert-count 5 t:$check r:FLAVOR=assert %i
zcovers: select -assert-count 5 c:p_zero_cover_* t:$check %i r:FLAVOR=cover %i
zsingle: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_cover_twin c:p_zero_cover_twin_victim c:p_zero_cover_twin_wait c:p_zero_cover_fallback %u %u %u %d
zsingle: select -assert-count 4 t:$check r:FLAVOR=cover %i
zlook: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_cover_lookahead %d
zcovers: chformal -assert -remove
zstreamhint: select -assert-count 2 c:p_prefetch_not_record c:p_grant_keeps_modified
zstreamhint: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_prefetch_not_record c:p_grant_keeps_modified %u %d
zstreamhint: select -assert-count 2 t:$check r:FLAVOR=assert %i
zstreamhint: check -assert
zstreamline: select -assert-count 1 c:p_zero_acquire_line
zstreamline: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_zero_acquire_line %d
zstreamline: select -assert-count 1 t:$check r:FLAVOR=assert %i
zstreamline: check -assert
zstreamupper: select -assert-count 1 c:p_zero_no_upper_request_ep
zstreamupper: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_zero_no_upper_request_ep %d
zstreamupper: select -assert-count 1 t:$check r:FLAVOR=assert %i
zstreamupper: check -assert
contract: select -assert-count 12 c:*p_buffer_contract_* t:$check %i r:FLAVOR=assert %i
contract: chformal -assert -remove t:$check r:FLAVOR=assert %i c:*p_buffer_contract_* %d
contract: select -assert-count 12 t:$check r:FLAVOR=assert %i
contract: check -assert
zprogress: select -assert-count 2 c:p_zero_progress_* t:$check %i r:FLAVOR=cover %i
zprogress: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_progress_* %d
zprogress: chformal -assert -remove
zprogress: check -assert
zrequest: select -assert-count 3 c:p_zero_no_upper_request c:p_grant_keeps_modified c:p_zero_request_complete
zrequest: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_zero_no_upper_request c:p_grant_keeps_modified c:p_zero_request_complete %u %u %d
zrequest: select -assert-count 3 t:$check r:FLAVOR=assert %i
zrequest: check -assert
zrequestcover: chformal -assert -remove
zrequestcover: select -assert-count 1 c:p_zero_request_drained t:$check %i r:FLAVOR=cover %i
zrequestcover: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_zero_request_drained %d
fcovers: select -assert-count 4 c:p_full_cover_* t:$check %i r:FLAVOR=cover %i
fsingle: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_full_cover_pair c:p_full_cover_twin c:p_full_cover_fallback %u %u %d
