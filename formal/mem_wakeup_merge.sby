script free_undefined.ys
prep -top mem_wakeup_merge -flatten
select -assert-none t:$assume a:init
select -assert-count 10 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/tomasulo_wrapper/wakeup/mem_wakeup_merge.sv
free_undefined.ys
