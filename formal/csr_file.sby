[tasks]
bmc rv32        # Bounded model checking
cover rv32      # Cover checking
bmc_rv64 rv64   # BMC with the FROST_RV64 build axis (XLEN=64)
cover_rv64 rv64 # Cover with the FROST_RV64 build axis

[options]
bmc: mode bmc
bmc_rv64: mode bmc
bmc: depth 20
bmc_rv64: depth 20
cover: mode cover
cover_rv64: mode cover
cover: depth 25
cover_rv64: depth 25

[engines]
smtbmc z3

[script]
rv32: read -formal -sv riscv_pkg.sv
rv32: read -formal -sv csr_file.sv
rv64: read -formal -sv -DFROST_RV64 riscv_pkg.sv
rv64: read -formal -sv -DFROST_RV64 csr_file.sv
prep -top csr_file

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/csr/csr_file.sv
