[tasks]
pm_mode_bmc
bmc
cover
bmc_perf_off
vector_bmc
vector_cover

[options]
pm_mode_bmc: mode bmc
pm_mode_bmc: depth 20
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 25
bmc_perf_off: mode bmc
bmc_perf_off: depth 20
vector_bmc: mode bmc
vector_bmc: depth 20
vector_cover: mode cover
vector_cover: depth 25

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv csr_file.sv
# The top-level default: profiling counters absent.
bmc_perf_off: chparam -set PERF_COUNTERS 0 csr_file
# The vector state (mstatus.VS and the vector CSRs) at VLEN 256.
vector_bmc: chparam -set PERF_COUNTERS 0 -set VECTOR 1 -set VLEN 256 csr_file
vector_cover: chparam -set PERF_COUNTERS 0 -set VECTOR 1 -set VLEN 256 csr_file
hierarchy -top csr_file
script free_undefined.ys
prep -top csr_file
# Keep the original standalone assumptions and isolate the PMM assertions.
pm_mode_bmc: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_pm_mode_exact c:p_pm_mode_not_reserved c:p_pmm_not_reserved %u %u %d
pm_mode_bmc: select -assert-count 3 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/csr/csr_file.sv
free_undefined.ys
