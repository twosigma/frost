[tasks]
bmc
cover
bmc_perf_off
vector_bmc
vector_cover

[options]
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 25
bmc_perf_off: mode bmc
bmc_perf_off: depth 20
vector_bmc: mode bmc
vector_bmc: depth 20
vector_cover: mode cover
vector_cover: depth 25

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv csr_file.sv
# The top-level default: profiling counters absent.
bmc_perf_off: chparam -set PERF_COUNTERS 0 csr_file
# The vector state (mstatus.VS and the vector CSRs) at VLEN 256.
vector_bmc: chparam -set PERF_COUNTERS 0 -set VECTOR 1 -set VLEN 256 csr_file
vector_cover: chparam -set PERF_COUNTERS 0 -set VECTOR 1 -set VLEN 256 csr_file
prep -top csr_file

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/csr/csr_file.sv
