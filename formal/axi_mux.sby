[tasks]
prove
prove_soc
prove_soc4
cover

[options]
prove: mode prove
prove: depth 3
prove_soc: mode prove
prove_soc: depth 3
prove_soc4: mode prove
prove_soc4: depth 3
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
read -formal -sv axi_mux.sv
# prove and cover: three ports, so the port index has an unused value, and
# narrow fields. The SoC proofs use its three- and four-port configurations,
# ids and W FIFO depth, including the uncached DDR alias port.
prove: chparam -set NUM_PORTS 3 -set ADDR_WIDTH 12 -set DATA_WIDTH 32 -set UP_ID_WIDTH 2 -set W_DEPTH 2 axi_mux
cover: chparam -set NUM_PORTS 3 -set ADDR_WIDTH 12 -set DATA_WIDTH 32 -set UP_ID_WIDTH 2 -set W_DEPTH 2 axi_mux
prove_soc: chparam -set NUM_PORTS 3 -set ADDR_WIDTH 64 -set DATA_WIDTH 256 -set UP_ID_WIDTH 3 -set W_DEPTH 4 axi_mux
prove_soc4: chparam -set NUM_PORTS 4 -set ADDR_WIDTH 64 -set DATA_WIDTH 256 -set UP_ID_WIDTH 3 -set W_DEPTH 4 axi_mux
prep -top axi_mux

[files]
../hw/rtl/lib/axi/axi_mux.sv
