[tasks]
prove
prove_full_width
prove_soc soc4 soc4proof partitioned
prove_soc_held soc4 soc4proof partitioned
prove_soc8_0 soc8 soc8proof partitioned
prove_soc8_1 soc8 soc8proof partitioned
prove_soc8_2 soc8 soc8proof partitioned
prove_soc8_3 soc8 soc8proof partitioned
prove_soc8_4 soc8 soc8proof partitioned
prove_soc8_5 soc8 soc8proof partitioned
prove_soc8_6 soc8 soc8proof partitioned
prove_soc8_7 soc8 soc8proof partitioned
prove_soc8_8 soc8 soc8proof partitioned
bmc_soc soc8
cover
cover_soc soc8

[options]
prove: mode prove
prove: depth 3
prove_full_width: mode prove
prove_full_width: depth 3
soc4proof: mode prove
soc4proof: depth 3
soc8proof: mode prove
soc8proof: depth 3
soc8proof: timeout 1800
bmc_soc: mode bmc
bmc_soc: depth 8
cover: mode cover
cover: depth 24
cover_soc: mode cover
cover_soc: depth 64
cover_soc: skip 60
cover_soc: timeout 600

[engines]
smtbmc boolector

[script]
~cover_soc: read -formal -sv sdp_dist_ram.sv axi_coherent_bridge.sv
cover_soc: read -formal -sv -D AXI_COHERENT_SOC_COVER sdp_dist_ram.sv axi_coherent_bridge.sv
# 16-bit addresses with the region in the middle, so addresses on both sides
# of it are reachable. prove and cover use 8-byte lines on a 16-bit bus, four
# beats per line, so segments merge beats, WRAP windows are narrower than,
# equal to and wider than a line, and INCR bursts cross lines, with two
# bursts and two ids per direction. prove_full_width has one beat per line,
# as in soc_top. prove_soc and prove_soc_held use soc_top's bus, lines and
# starvation bound with four bursts and ids per direction. They partition
# B-channel stability from the other assertions. The soc8 tasks use eight
# bursts and eight ids per direction, with nine explicit partitions and
# B-channel stability in its own partition. Every partition in each configuration
# is required. Shared hypotheses contain only preceding-cycle assertion results.
# cover_soc fills, drains and reuses both ID pools with single-beat traffic.
prove: chparam -set LINE_BYTES 8 -set DATA_WIDTH 16 -set ADDR_WIDTH 16 -set LINE_ADDR_WIDTH 16 -set ID_WIDTH 2 -set LINE_ID_BITS 2 -set WRITE_BURSTS 2 -set READ_BURSTS 2 -set REGION_BASE 16384 -set REGION_BYTES 16384 -set STARVATION_LIMIT 2 axi_coherent_bridge
cover: chparam -set LINE_BYTES 8 -set DATA_WIDTH 16 -set ADDR_WIDTH 16 -set LINE_ADDR_WIDTH 16 -set ID_WIDTH 2 -set LINE_ID_BITS 2 -set WRITE_BURSTS 2 -set READ_BURSTS 2 -set REGION_BASE 16384 -set REGION_BYTES 16384 -set STARVATION_LIMIT 2 axi_coherent_bridge
prove_full_width: chparam -set LINE_BYTES 8 -set DATA_WIDTH 64 -set ADDR_WIDTH 16 -set LINE_ADDR_WIDTH 16 -set ID_WIDTH 2 -set LINE_ID_BITS 2 -set WRITE_BURSTS 2 -set READ_BURSTS 2 -set REGION_BASE 16384 -set REGION_BYTES 16384 -set STARVATION_LIMIT 2 axi_coherent_bridge
soc4: chparam -set ADDR_WIDTH 16 -set LINE_ADDR_WIDTH 16 -set ID_WIDTH 4 -set REGION_BASE 16384 -set REGION_BYTES 16384 axi_coherent_bridge
soc8: chparam -set ADDR_WIDTH 16 -set LINE_ADDR_WIDTH 16 -set ID_WIDTH 4 -set LINE_ID_BITS 4 -set WRITE_BURSTS 8 -set READ_BURSTS 8 -set REGION_BASE 16384 -set REGION_BYTES 16384 axi_coherent_bridge
cover_soc: chformal -assert -remove
hierarchy -top axi_coherent_bridge
script free_undefined.ys
prep -top axi_coherent_bridge
# Freeze the DUT before loading the map. Explicit membership is checked for
# completeness and disjointness before any assertion receives a history assumption.
partitioned: async2sync
partitioned: setundef -anyseq
partitioned: chformal -lower
partitioned: write_rtlil ../model/unpartitioned.il
partitioned: design -stash unpartitioned
partitioned: read_verilog -formal -sv axi_coherent_bridge_assert.sv
partitioned: hierarchy -top axi_coherent_bridge_assert_maps
partitioned: script free_undefined.ys
partitioned: chformal -lower
partitioned: design -stash assertion_map
partitioned: design -load unpartitioned
# Resolve the roster against the restored bridge top.
partitioned: hierarchy -check -top axi_coherent_bridge
soc8proof: log -stderr If the AXI bridge assertion roster check fails, it is stale. Run: ./scripts/frost.py run python3 formal/update_axi_bridge_groups.py
soc8proof: script axi_coherent_bridge_groups.ys
soc4proof: select -set held t:$assert c:p_b_held %i
soc4proof: select -assert-count 1 @held
soc4proof: select -set other t:$assert @held %d
prove_soc: chtype -set axi_coherent_bridge_checked_assert @other
prove_soc_held: chtype -set axi_coherent_bridge_checked_assert @held
prove_soc8_0: chtype -set axi_coherent_bridge_checked_assert @group0
prove_soc8_1: chtype -set axi_coherent_bridge_checked_assert @group1
prove_soc8_2: chtype -set axi_coherent_bridge_checked_assert @group2
prove_soc8_3: chtype -set axi_coherent_bridge_checked_assert @group3
prove_soc8_4: chtype -set axi_coherent_bridge_checked_assert @group4
prove_soc8_5: chtype -set axi_coherent_bridge_checked_assert @group5
prove_soc8_6: chtype -set axi_coherent_bridge_checked_assert @group6
prove_soc8_7: chtype -set axi_coherent_bridge_checked_assert @group7
prove_soc8_8: chtype -set axi_coherent_bridge_checked_assert @group8
partitioned: techmap -max_iter 1 -map %assertion_map
partitioned: opt_clean
partitioned: select -assert-none t:axi_coherent_bridge_checked_assert
prove_soc: select -assert-count 138 t:$assert
prove_soc_held: select -assert-count 1 t:$assert
soc8proof: select -assert-min 1 t:$assert
partitioned: select -clear

[files]
free_undefined.ys
axi_coherent_bridge_groups.ys
axi_coherent_bridge_assert.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/axi/axi_coherent_bridge.sv
