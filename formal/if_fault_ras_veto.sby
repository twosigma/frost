[tasks]
bmc veto
cover veto
prove veto
prove_slot2_veto_redundant redundant

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 10
prove: mode prove
prove: depth 4
redundant: mode prove
redundant: depth 4

[engines]
smtbmc boolector

[script]
read_verilog -D SYNTHESIS -sv riscv_pkg.sv
read_verilog -D SYNTHESIS -sv sdp_dist_ram.sv
read_verilog -D SYNTHESIS -sv fetch_parcel_queue.sv
read_verilog -D SYNTHESIS -sv fetch_pc_decoupled.sv
veto: read_verilog -formal -D SYNTHESIS -D IF_FAULT_RAS_VETO_PROOF -sv if_stage.sv
redundant: read_verilog -formal -D SYNTHESIS -D IF_SLOT2_VETO_REDUNDANT_PROOF -sv if_stage.sv
hierarchy -top if_stage
delete t:fetch_btb_2w t:fetch_dir_4b t:return_address_stack t:immu t:backing_btb t:tage_predictor t:ittage_predictor
script free_undefined.ys
setattr -unset dont_touch *
setattr -mod -unset keep_hierarchy *
setundef -undriven -anyseq
prep -flatten -top if_stage
veto: select -assert-count 7 t:$check r:FLAVOR=assert %i
veto: select -assert-count 4 t:$check r:FLAVOR=cover %i
redundant: select -assert-count 5 t:$check r:FLAVOR=assert %i
redundant: select -assert-count 1 t:$check r:FLAVOR=assume %i
redundant: select -assert-none t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_parcel_queue.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_pc_decoupled.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/if_stage.sv
free_undefined.ys
