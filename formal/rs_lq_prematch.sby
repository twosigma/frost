# Actual MEM_RS and LQ composed through the wrapper slice in
# rs_lq_prematch_equiv.sv. No assumptions. Checks: MEM_RS 11 (look-ahead
# tag, 8 exported-pick tags, selected index, any-ready) and LQ 65 (64 candidate
# x entry matches against the candidate-tag CAM, 1 registered selected match
# against the registered CAM of the look-ahead tag).
[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 3
prove: mode prove
prove: depth 2

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv
read -sv load_unit.sv lq_l0_cache.sv lq_issue_selector.sv
read -sv -D SYNTHESIS mem_wakeup_merge.sv
read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -sv reservation_station.sv
read -formal -D F_LQ_PREMATCH_ONLY -D SYNTHESIS -D F_LQ_PREMATCH_PAIR -sv load_queue.sv
read -formal -sv rs_lq_prematch_equiv.sv
hierarchy -top rs_lq_prematch_equiv
proc
flatten
setundef -undriven -anyseq
opt
prep -top rs_lq_prematch_equiv
select -assert-none t:$assume
select -assert-count 76 t:$check

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/tomasulo_wrapper/wakeup/mem_wakeup_merge.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
rs_lq_prematch_equiv.sv
