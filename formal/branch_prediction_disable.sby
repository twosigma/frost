[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read_verilog -formal -D SYNTHESIS -sv branch_prediction_controller.sv
# Cut the predictor submodules so their outputs are arbitrary: the properties
# concern only the controller's prediction-use gates, whatever the lookups
# return.
delete t:branch_predictor t:direction_predictor t:ras_detector t:return_address_stack
proc
setundef -undriven -anyseq
opt
prep -top branch_prediction_controller

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/branch_prediction_controller.sv
