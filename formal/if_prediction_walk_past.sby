[tasks]
bmc
continuity
cover

[options]
bmc: mode bmc
bmc: depth 12
bmc: aigsmt boolector
continuity: mode bmc
continuity: depth 8
continuity: aigsmt boolector
cover: mode cover
cover: depth 10

[engines]
cover: smtbmc boolector
~cover: abc bmc3 -c

[script]
~continuity: read_slang --top if_prediction_walk_past_formal --single-unit -DSYNTHESIS -DIF_WALK_PAST_PROOF riscv_pkg.sv sdp_dist_ram.sv fetch_parcel_queue.sv fetch_pc_decoupled.sv if_stage.sv if_prediction_walk_past_formal.sv
continuity: read_slang --top if_prediction_walk_past_formal --single-unit -DSYNTHESIS -DIF_WALK_PAST_PROOF -DIF_CONTINUITY_PROOF riscv_pkg.sv sdp_dist_ram.sv fetch_parcel_queue.sv fetch_pc_decoupled.sv if_stage.sv if_prediction_walk_past_formal.sv
hierarchy -top if_prediction_walk_past_formal
script free_undefined.ys
setattr -unset dont_touch *
setattr -unset keep *
setattr -mod -unset keep_hierarchy *
setundef -undriven -anyseq
prep -flatten -top if_prediction_walk_past_formal

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_parcel_queue.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_pc_decoupled.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/if_stage.sv
if_prediction_walk_past_formal.sv
free_undefined.ys
