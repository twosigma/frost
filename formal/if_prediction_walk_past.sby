[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 10

[engines]
bmc: smtbmc boolector
cover: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -sv stall_capture_reg.sv
read -sv control_flow_tracker.sv
read -sv pc_reg_precompute.sv
read -sv -D SYNTHESIS pc_increment_calculator.sv
read -sv fetch_redirect.sv
read -sv pd_target_candidate.sv
read -sv served_window_coverage.sv
read -sv slot2_prediction_capture.sv
read -sv -D SYNTHESIS instruction_aligner.sv
read -sv -D SYNTHESIS pc_controller.sv
read -sv -D SYNTHESIS c_ext_state.sv
read -sv -D SYNTHESIS prediction_metadata_tracker.sv
read -sv -D SYNTHESIS branch_prediction_controller.sv
read -formal -D SYNTHESIS -D IF_WALK_PAST_PROOF -sv if_stage.sv
read -formal -sv if_prediction_walk_past_formal.sv
prep -top if_prediction_walk_past_formal

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/stall_capture_reg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/control_flow_tracker.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_reg_precompute.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_increment_calculator.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_redirect.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pd_target_candidate.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/served_window_coverage.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/slot2_prediction_capture.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/c_extension/instruction_aligner.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_controller.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/c_extension/c_ext_state.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/prediction_metadata_tracker.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/branch_prediction_controller.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/if_stage.sv
if_prediction_walk_past_formal.sv
