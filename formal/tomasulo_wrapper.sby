[tasks]
bmc concrete
cover concrete
cover_alu_issue concrete
fp_repair_bmc concrete
bmc_depth6 depth6 depth6_bmc depth6_bmc_all
bmc_wakeup_depth6 depth6 depth6_bmc depth6_wakeup
fp_repair_bmc_depth6 depth6 depth6_bmc depth6_bmc_all
cover_depth6 depth6 depth6_cover
cover_wakeup_depth6 depth6 depth6_cover depth6_wakeup
cover_fu_depth6 depth6 depth6_cover depth6_wakeup

[options]
bmc: mode bmc
bmc: depth 4
cover: mode cover
cover: depth 6
cover: vcd off
cover_alu_issue: mode cover
cover_alu_issue: depth 6
cover_alu_issue: vcd off
fp_repair_bmc: mode bmc
fp_repair_bmc: depth 4
depth6_bmc: mode bmc
depth6_bmc: depth 6
depth6_bmc: aigsmt boolector
depth6_cover: mode cover
depth6_cover: vcd off
cover_depth6: depth 6
cover_wakeup_depth6: depth 6
cover_fu_depth6: depth 8

[engines]
bmc: smtbmc boolector
cover: smtbmc boolector
cover_alu_issue: smtbmc boolector
# Skip presat for runtime. The bmc task checks satisfiability with the same
# harness and assumptions; only the internal ENABLE_DISPATCH_DONE_REPAIR
# logic differs. This retains a check against contradictory assumptions.
fp_repair_bmc: smtbmc --nopresat boolector
depth6_bmc: abc bmc3 -c
depth6_cover: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv vec_hold_rows.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv mwp_dist_ram.sv
read -formal -sv mwp_dist_ram_ohread.sv
read -sv rob_serializer.sv sfence_operand_store.sv
read -sv reorder_buffer.sv
read -sv register_alias_table.sv
read -formal -sv rs_issue2_selector.sv
# FORMAL_STANDALONE_ENV=0 retains station assertions without standalone
# assumptions or covers. The real allocator exercises the branch-payload
# RAM's rule against reusing a live ROB tag.
read -sv coherent_rs_capacity.sv
read -sv coherent_rs_issue2_selector.sv
read -sv coherent_rs_payload_store.sv
read -formal -sv reservation_station.sv
read -sv cdb_arbiter.sv
read -sv fu_cdb_adapter.sv
read -sv int_alu_shim.sv
read -sv int_muldiv_shim.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -sv coherent_lq_issue_selector.sv
read -sv coherent_lq_candidate_select.sv
read -sv coherent_lq_address_store.sv
read -sv -DFROST_YOSYS load_queue.sv
read -sv sq_forwarding_unit.sv
read -sv store_queue.sv
read -sv dtlb.sv
read -sv dmmu.sv
read -sv tomasulo_perf_counters.sv
read -sv sq_early_addr_pipeline.sv
read -sv commit_bus_pipeline.sv
read -sv dispatch_rs_router.sv
read -sv sc_pending_unit.sv
read -sv coherent_atomic_select.sv
read -formal -sv mem_wakeup_merge.sv
read -sv lq_coherence_port.sv
read -sv divider.sv
read -sv dsp_tiled_multiplier_unsigned.sv
read -sv multiplier.sv cl_multiplier.sv
read -sv alu.sv
concrete: read -sv fp_engine.sv
# The FMA datapath's results are abstracted (fp_fma_pipe_equiv checks them).
read -formal -D FP_FMA_PIPE_ABSTRACT -sv fp_pipe_lzc.sv fp_fma_pipe.sv
concrete: read -sv fp_div_unit.sv
concrete: read -sv fp_shim.sv
depth6: read -sv -D FP_SHIM_ABSTRACT_PROOF fp_shim.sv
concrete: read -formal -sv tomasulo_wrapper.sv
depth6_bmc_all: read -formal -sv tomasulo_wrapper.sv
bmc_wakeup_depth6: read -formal -D TOMASULO_WRAPPER_LQ_SQ_DISJOINT -sv tomasulo_wrapper.sv
cover_depth6: read -formal -D TOMASULO_WRAPPER_DEPTH6_COVERS -sv tomasulo_wrapper.sv
cover_wakeup_depth6: read -formal -D TOMASULO_WRAPPER_LQ_SQ_DISJOINT -D TOMASULO_WRAPPER_DEPTH6_COVERS -sv tomasulo_wrapper.sv
cover_fu_depth6: read -formal -D TOMASULO_WRAPPER_LQ_SQ_DISJOINT -D TOMASULO_WRAPPER_DEPTH6_COVERS -sv tomasulo_wrapper.sv
fp_repair_bmc: chparam -set ENABLE_DISPATCH_DONE_REPAIR 1 tomasulo_wrapper
fp_repair_bmc_depth6: chparam -set ENABLE_DISPATCH_DONE_REPAIR 1 tomasulo_wrapper
hierarchy -top tomasulo_wrapper
script free_undefined.ys
# Depth-6 tasks abstract leaf arithmetic datapaths whose control outputs are
# unused in formal mode (ALU and integer/word/carry-less multipliers) and the
# multi-cycle FP engine/divider via FP_SHIM_ABSTRACT_PROOF.
depth6: delete t:alu t:multiplier t:dsp_tiled_multiplier_unsigned t:cl_multiplier
depth6: setundef -undriven -anyseq
# The three commit-bus properties (p_registered_native_fence_implies_flush,
# p_native_fence_copy_matches_non_translation_flush and
# p_rename_wins_over_commit) are proved to depth 10 in
# tomasulo_wrapper_commit_bus with the ROB's one-class and slot-2 rename
# contracts. bmc_wakeup_depth6 checks all 44 mem_wakeup_merge assertions.
depth6_bmc_all: chformal -assert -remove tomasulo_wrapper/c:p_registered_native_fence_implies_flush tomasulo_wrapper/c:p_native_fence_copy_matches_non_translation_flush tomasulo_wrapper/c:p_rename_wins_over_commit *mem_wakeup_merge*/*
bmc_wakeup_depth6: chformal -assert -remove t:$check r:FLAVOR=assert %i *mem_wakeup_merge*/* %d
depth6: setattr -mod -unset keep_hierarchy *
depth6: setattr -unset keep_hierarchy */c:*
depth6: flatten
# Production cpu_ooo ties i_fu_complete_0..7 to zero; tying those
# test-injection ports prevents synthetic duplicate-tag CDB collisions against
# live loads in mem_wakeup_merge and guarantees cover_fu_depth6 reaches the
# CDB through the abstracted FU adapters.
depth6_wakeup: connect -nomap -set i_fu_complete_0 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_1 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_2 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_3 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_4 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_5 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_6 81'b0
depth6_wakeup: connect -nomap -set i_fu_complete_7 81'b0
depth6_cover: chformal -assert -remove
cover_depth6: chformal -cover -remove t:$check r:FLAVOR=cover %i c:cover_d6_env_* %d
cover_wakeup_depth6: chformal -cover -remove t:$check r:FLAVOR=cover %i c:cover_d6_w_* %d
cover_fu_depth6: chformal -cover -remove t:$check r:FLAVOR=cover %i c:cover_d6_fu_* %d
bmc_depth6: select -assert-count 773 t:$check r:FLAVOR=assert %i
bmc_depth6: select -assert-count 56 t:$check r:FLAVOR=assume %i
bmc_wakeup_depth6: select -assert-count 44 t:$check r:FLAVOR=assert %i
depth6_wakeup: select -assert-count 57 t:$check r:FLAVOR=assume %i
fp_repair_bmc_depth6: select -assert-count 809 t:$check r:FLAVOR=assert %i
fp_repair_bmc_depth6: select -assert-count 62 t:$check r:FLAVOR=assume %i
cover_depth6: select -assert-count 56 t:$check r:FLAVOR=assume %i
cover_depth6: select -assert-count 4 t:$check r:FLAVOR=cover %i
cover_wakeup_depth6: select -assert-count 8 t:$check r:FLAVOR=cover %i
cover_fu_depth6: select -assert-count 3 t:$check r:FLAVOR=cover %i
depth6_cover: select -assert-none t:$check r:FLAVOR=assert %i
depth6: setattr -unset keep */w:* */c:*
depth6: opt_clean -purge
prep -top tomasulo_wrapper
depth6_bmc: memory_map -keepdc
depth6_bmc: opt -fast -keepdc
depth6_bmc: techmap
depth6_bmc: opt -fast -keepdc
depth6_bmc: setundef -anyseq
depth6_bmc: opt_clean
# cover_alu_issue keeps only the three ALU-issue covers and cover the others.
# With 12 checkpoints the three took 50 to 60 minutes to reach at step 5 of a
# single task; the others are reached by step 3.
cover: select -assert-count 3 t:$check r:FLAVOR=cover %i c:cover_port0_through_alu2_* c:cover_head_done_result_held %u %i
cover: chformal -cover -remove c:cover_port0_through_alu2_* c:cover_head_done_result_held %u
cover: select -assert-count 15 t:$check r:FLAVOR=cover %i
cover_alu_issue: chformal -cover -remove t:$check r:FLAVOR=cover %i c:cover_port0_through_alu2_* c:cover_head_done_result_held %u %d
cover_alu_issue: select -assert-count 3 t:$check r:FLAVOR=cover %i

