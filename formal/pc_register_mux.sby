[tasks]
bmc
bmc_integrated

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read_verilog -formal -D SYNTHESIS -D PC_HOLDOFF_LOCAL_PROOF -D PC_FETCH_HOLDOFF_ONLY -D PC_MUX_LOCAL_PROOF -sv pc_controller.sv
bmc_integrated: chparam -set PENDING_HANDOFF_EXCLUDES_SLOT2 1 pc_controller
delete t:control_flow_tracker t:pc_increment_calculator
proc
setundef -undriven -anyseq
opt
prep -top pc_controller

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_controller.sv
