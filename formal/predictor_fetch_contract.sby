[tasks]
bmc
prove_order induction pdr
prove_addresses induction pdr
prove_buffer_source induction pdr
prove_slot1_sources induction smt
prove_slot2_sources induction smt
prove_targets induction smt
cover covers
cover_backing covers

[options]
bmc: mode bmc
bmc: depth 6
# Replay an ABC counterexample with the SMT solver used by the source checks.
bmc: aigsmt boolector
induction: mode prove
smt: depth 3
covers: mode cover
cover: depth 9
cover_backing: depth 521
cover_backing: skip 513
cover_backing: timeout 420
cover_backing: vcd off

[engines]
bmc: abc bmc3
pdr: abc pdr
smt: smtbmc boolector
cover: smtbmc boolector
cover_backing: btor btormc

[script]
read_slang --top if_prediction_walk_past_formal --single-unit -DSYNTHESIS -DPREDICTOR_FETCH_CONTRACT riscv_pkg.sv fetch_parcel_queue.sv fetch_pc_decoupled.sv if_stage.sv if_prediction_walk_past_formal.sv backing_btb.sv rvc_decompressor.original.sv predictor_fetch_contract.sv sdp_block_ram.sv sdp_dist_ram.sv
hierarchy -top if_prediction_walk_past_formal
script free_undefined.ys
setattr -unset dont_touch *
setattr -unset keep *
setattr -mod -unset keep_hierarchy *
setundef -undriven -anyseq
# Keep fetch on a deterministic 2-wide self-loop at the boot address during
# this witness so the full-size BTB can finish its 512 reset writes and emit a
# slot-2 backing hit right after. All proofs retain arbitrary traffic.
cover_backing: cd if_prediction_walk_past_formal
cover_backing: connect -set boot_addr_hw 0
cover_backing: connect -set raw_stall 0
cover_backing: connect -set raw_trap_taken 0
cover_backing: connect -set raw_mret_taken 0
cover_backing: connect -set raw_trap_target_hw 0
cover_backing: connect -set raw_branch_taken 0
cover_backing: connect -set raw_branch_target_hw 0
cover_backing: connect -set raw_fence_i_flush 0
cover_backing: connect -set raw_fence_i_target_hw 0
cover_backing: connect -set raw_pd_redirect 0
cover_backing: connect -set raw_pd_redirect_taken 0
cover_backing: connect -set raw_pd_redirect_target_hw 0
cover_backing: connect -set raw_instr_valid 1
cover_backing: connect -set i_disable_branch_prediction 0
cover_backing: connect -set i_fetch_translation_active 0
cover_backing: connect -set i_btb_invalidate 0
cover_backing: connect -set i_fetch_priv_u 0
cover_backing: connect -set i_fetch_asid 0
cover_backing: connect -set provider_q 0
cover_backing: connect -set served_word 0
cover_backing: connect -set fetch_bank 0
cover_backing: connect -set i_instr_fault0 0
cover_backing: connect -set i_instr_fault0_page 0
cover_backing: connect -set i_instr_fault1 0
cover_backing: connect -set i_instr_fault1_page 0
cover_backing: connect -set fetch_instr 128'h0000006f000000130000006f00000013
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_taken 1
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_pos 2'd2
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_comp 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_call 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_ret 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_tgt_cached 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_target_hw 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_w0 0
cover_backing: connect -set u_if_stage.u_fetch_btb_2w.f_w1 0
cover_backing: connect -set u_if_stage.u_immu.f_pa_valid 1
cover_backing: connect -set u_if_stage.u_immu.f_fault0 0
cover_backing: connect -set u_if_stage.u_immu.f_fault0_page 0
cover_backing: connect -set u_if_stage.u_immu.f_fault1 0
cover_backing: connect -set u_if_stage.u_immu.f_fault1_page 0
cover_backing: connect -set u_if_stage.u_immu.f_pa0 0
cover_backing: connect -set u_if_stage.u_immu.f_pa1 4
cover_backing: connect -set u_if_stage.u_immu.f_line_ok 0
cover_backing: connect -set u_if_stage.u_immu.f_walk_req 0
cover_backing: connect -set u_if_stage.u_immu.f_walk_vpn 0
cover_backing: connect -set u_if_stage.u_fetch_dir_4b.f_taken 0
cover_backing: connect -set u_if_stage.u_ras.f_nonempty 0
cover_backing: connect -set u_if_stage.u_ras.f_top_hw 0
cover_backing: connect -set u_if_stage.u_ras.f_tos 0
cover_backing: connect -set u_if_stage.u_ras.f_valid_count 0
cover_backing: connect -set u_if_stage.u_tage_predictor.f_word 0
cover_backing: connect -set u_if_stage.u_tage_predictor.f_hist 0
cover_backing: connect -set u_if_stage.u_tage_predictor.f_b0 0
cover_backing: connect -set u_if_stage.u_tage_predictor.f_b1 0
cover_backing: connect -set u_if_stage.u_ittage_predictor.f_hist 0
cover_backing: connect -set u_if_stage.u_ittage_predictor.f_b0 0
cover_backing: connect -set u_if_stage.u_ittage_predictor.f_b1 0
cover_backing: connect -set u_if_stage.u_ittage_predictor.f_hit 0
cover_backing: connect -set u_if_stage.u_ittage_predictor.f_target 0
cover_backing: cd ..
prep -flatten -top if_prediction_walk_past_formal
select -assert-count 29 t:$check r:FLAVOR=assert %i
select -assert-count 1 t:$check r:FLAVOR=assume %i
select -assert-count 5 t:$check r:FLAVOR=cover %i
prove_order: select -set queue_inv c:p_queue_source_on_use c:p_queue_sideband
prove_order: select -assert-count 2 @queue_inv t:$check %i r:FLAVOR=assert %i
prove_order: chformal -assert2assume @queue_inv
prove_order: select -set obligations c:contract.p_pair_control c:contract.p_pair_fault c:contract.p_pair_bubble c:contract.p_pd_restore c:contract.p_slot1_cond_clear
prove_order: select -assert-count 5 @obligations t:$check %i r:FLAVOR=assert %i
prove_addresses: select -set obligations c:contract.p_packet_step c:contract.p_backing_region c:contract.p_backing_by_size
prove_addresses: select -assert-count 3 @obligations t:$check %i r:FLAVOR=assert %i
# Prove that every occupied parcel-queue slot was written from a live window
# with matching predecode sideband. The slot-1, slot-2, and order proofs assume
# only these proven queue invariants.
prove_buffer_source: select -set obligations c:p_queue_source_on_use
prove_buffer_source: select -assert-count 1 @obligations t:$check %i r:FLAVOR=assert %i
prove_slot1_sources: select -set queue_source c:p_queue_source_on_use
prove_slot1_sources: select -assert-count 1 @queue_source t:$check %i r:FLAVOR=assert %i
prove_slot1_sources: chformal -assert2assume @queue_source
prove_slot1_sources: select -assert-count 2 t:$check r:FLAVOR=assume %i
prove_slot1_sources: select -set obligations c:p_queue_sideband c:contract.p_s1_expansion c:contract.p_s1_hot c:contract.p_s1_rs1 c:contract.p_s1_rs2
prove_slot1_sources: select -assert-count 5 @obligations t:$check %i r:FLAVOR=assert %i
prove_slot2_sources: select -set queue_source c:p_queue_source_on_use
prove_slot2_sources: select -assert-count 1 @queue_source t:$check %i r:FLAVOR=assert %i
prove_slot2_sources: chformal -assert2assume @queue_source
prove_slot2_sources: select -assert-count 2 t:$check r:FLAVOR=assume %i
prove_slot2_sources: select -set obligations c:p_queue_sideband c:contract.p_s2_size c:contract.p_s2_expansion c:contract.p_s2_branch c:contract.p_s2_hot c:contract.p_s2_rs1 c:contract.p_s2_rs2 c:contract.p_s2_rs1_hot
prove_slot2_sources: select -assert-count 8 @obligations t:$check %i r:FLAVOR=assert %i
prove_targets: select -set obligations c:contract.p_s1_native* c:contract.p_s2_native* c:contract.p_s1_compressed* c:contract.p_s2_compressed*
prove_targets: select -assert-count 8 @obligations t:$check %i r:FLAVOR=assert %i
induction: chformal -assert -remove t:$check r:FLAVOR=assert %i @obligations %d
~covers: chformal -cover -remove
covers: chformal -assert -remove
covers: select -set backing_hit c:contract.c_backing_hit
covers: select -assert-count 1 @backing_hit t:$check %i r:FLAVOR=cover %i
cover: chformal -cover -remove @backing_hit
cover_backing: chformal -cover -remove t:$check r:FLAVOR=cover %i @backing_hit %d

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_parcel_queue.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/fetch_pc_decoupled.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/if_stage.sv
if_prediction_walk_past_formal.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/backing_btb.sv
predictor_reference/rvc_decompressor.original.sv
predictor_fetch_contract.sv
predictor_twin_ram/sdp_block_ram.sv
predictor_twin_ram/sdp_dist_ram.sv
free_undefined.ys
