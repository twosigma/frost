[tasks]
bmc
bmc_addr1
bmc_unstaged
cover

[options]
bmc: mode bmc
bmc: depth 12
bmc_addr1: mode bmc
bmc_addr1: depth 10
bmc_unstaged: mode bmc
bmc_unstaged: depth 10
cover: mode cover
cover: depth 10

[engines]
smtbmc boolector

[script]
read -sv sdp_dist_ram.sv
read -formal -sv mwp_dist_ram.sv
read -formal -sv mwp_dist_ram_ohread.sv
read -formal -sv mwp_dist_ram_formal.sv
bmc: hierarchy -top mwp_dist_ram_formal
cover: hierarchy -top mwp_dist_ram_formal
bmc_addr1: hierarchy -top mwp_dist_ram_formal -chparam ADDR_WIDTH 1
bmc_unstaged: hierarchy -top mwp_dist_ram_formal -chparam NUM_STAGED_LVT_PORTS 0
hierarchy -top mwp_dist_ram_formal
script free_undefined.ys
prep -top mwp_dist_ram_formal
memory_map
opt -fast
select -assert-count 3 t:$check r:FLAVOR=assert %i
~bmc_unstaged: select -assert-count 4 t:$check r:FLAVOR=cover %i
bmc_unstaged: select -assert-count 1 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
mwp_dist_ram_formal.sv
free_undefined.ys
