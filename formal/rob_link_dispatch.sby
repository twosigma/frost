[tasks]
p00
p01
p10
p11

[options]
mode prove
depth 1

[engines]
smtbmc boolector

[script]
read -sv -D SYNTHESIS -D ROB_LINK_DISPATCH_LOCAL_PROOF riscv_pkg.sv dispatch.sv
p01: chparam -set RAW_INT_RF_VALUES 1 dispatch
p10: chparam -set SLOT2_VALID_FROM_BUNDLE 1 dispatch
p11: chparam -set SLOT2_VALID_FROM_BUNDLE 1 -set RAW_INT_RF_VALUES 1 dispatch
prep -top dispatch -flatten
select -assert-none t:$assume a:init
select -assert-count 2 t:$check r:FLAVOR=assert %i
select -assert-none t:$check r:FLAVOR=assume %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/dispatch/dispatch.sv
