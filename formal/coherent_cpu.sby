[tasks]
coh_stage_take_prove stage_take
coh_address_class_prove address_class
coh_candidate_select_prove candidate
coh_sc_selected_prove sc
coh_lq_cut_prove lq
coh_lq_forward_prove lq forward
coh_lq_normal_fill_prove lq normal
coh_lq_selector_prove selector
coh_lq_selector4_prove selector selector4
coh_lq_selector16_prove selector selector16

[options]
mode prove
depth 4
timeout 180

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
sc: read -formal -sv -D FROST_COHERENT_CLUSTER -D COHERENT_SC_LOCAL_PROOF sc_pending_unit.sv
sc: chparam -set COHERENT_CLUSTER 1 sc_pending_unit
sc: prep -flatten -top sc_pending_unit
lq: read -sv -D FROST_COHERENT_CLUSTER sdp_dist_ram.sv mwp_dist_ram.sv load_unit.sv lq_l0_cache.sv coherent_l0_flags.sv lq_issue_selector.sv coherent_lq_issue_selector.sv coherent_lq_candidate_select.sv coherent_lq_stage_take.sv
lq: read -formal -sv coherent_lq_address_store.sv
lq: read -formal -sv -D FROST_COHERENT_CLUSTER -D F_LQ_PREMATCH_ONLY -D COHERENT_LQ_LOCAL_PROOF load_queue.sv
lq: chparam -set COHERENT_CLUSTER 1 load_queue
forward: chparam -set ENABLE_SQ_FORWARD_FAST_PATH 1 load_queue
normal: chparam -set CACHE_NORMAL_MEMORY 1 -set CACHE_UNCACHED_DATA 0 -set MEM_RESPONSE_ERRORS 1 load_queue
lq: prep -flatten -top load_queue

selector: read -formal -sv lq_issue_selector.sv coherent_lq_issue_selector.sv
selector4: chparam -set DEPTH 4 coherent_lq_issue_selector
selector16: chparam -set DEPTH 16 coherent_lq_issue_selector
selector: prep -flatten -top coherent_lq_issue_selector

candidate: read -formal -sv coherent_lq_candidate_select.sv
candidate: prep -top coherent_lq_candidate_select

address_class: read -formal -sv coherent_lq_address_store.sv
address_class: prep -flatten -top coherent_lq_address_store

stage_take: read -formal -sv coherent_lq_stage_take.sv
stage_take: prep -top coherent_lq_stage_take

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/tomasulo_wrapper/atomics/sc_pending_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_candidate_select.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_address_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_l0_flags.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_stage_take.sv
