[tasks]
bmc
cover
bmc_tag_indexed
cover_tag_indexed

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 20
bmc_tag_indexed: mode bmc
bmc_tag_indexed: depth 12
cover_tag_indexed: mode cover
cover_tag_indexed: depth 20

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -sv sdp_dist_ram.sv
read -sv mwp_dist_ram.sv
read -formal -sv rs_issue2_selector.sv
read -formal -sv reservation_station.sv
# The INT configuration's ROB-tag-indexed branch payload (side RAM + tag
# ownership assumption).
bmc_tag_indexed: chparam -set TAG_INDEXED_BRANCH_PAYLOAD 1 reservation_station
cover_tag_indexed: chparam -set TAG_INDEXED_BRANCH_PAYLOAD 1 reservation_station
prep -top reservation_station

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
