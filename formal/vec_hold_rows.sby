[tasks]
vhold_lq_bmc
vhold_sq_bmc
vhold_sq_cursor_bmc
vhold_lq_cover cover_tasks
cover cover_tasks
vhold_sq_cursor_cover cover_tasks

[options]
vhold_lq_bmc: aigsmt boolector
vhold_lq_bmc: mode bmc
vhold_lq_bmc: depth 8
vhold_sq_bmc: mode bmc
vhold_sq_bmc: depth 8
vhold_sq_cursor_bmc: mode bmc
vhold_sq_cursor_bmc: depth 8
cover_tasks: mode cover
cover_tasks: depth 16
timeout 1800

[engines]
cover_tasks: smtbmc boolector
vhold_lq_bmc: abc bmc3
vhold_sq_bmc: smtbmc boolector
vhold_sq_cursor_bmc: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv vec_hold_rows.sv
read -formal -sv vec_hold_rows_formal.sv
cover: chparam -set DIRECT_ADDR 1 vec_hold_rows_formal
vhold_sq_bmc: chparam -set DIRECT_ADDR 1 vec_hold_rows_formal
vhold_sq_cursor_bmc: chparam -set DIRECT_ADDR 1 -set CURSOR_ONLY 1 vec_hold_rows_formal
vhold_sq_cursor_cover: chparam -set DIRECT_ADDR 1 -set CURSOR_ONLY 1 vec_hold_rows_formal
hierarchy -top vec_hold_rows_formal
script free_undefined.ys
prep -top vec_hold_rows_formal

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_hold_rows.sv
vec_hold_rows_formal.sv
free_undefined.ys
