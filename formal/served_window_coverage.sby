[tasks]
bmc
bmc_xilinx
bmc_32
bmc_32_xilinx
prove
cover

[options]
bmc: mode bmc
bmc: depth 1
bmc_xilinx: mode bmc
bmc_xilinx: depth 1
bmc_32: mode bmc
bmc_32: depth 1
bmc_32_xilinx: mode bmc
bmc_32_xilinx: depth 1
prove: mode prove
prove: depth 1
cover: mode cover
cover: depth 1

[engines]
smtbmc boolector

[script]
bmc: read_verilog -formal -sv served_window_coverage.sv served_window_coverage_formal.sv
bmc_32: read_verilog -formal -sv served_window_coverage.sv served_window_coverage_formal.sv
bmc_xilinx: read_verilog -formal +/xilinx/cells_sim.v
bmc_xilinx: read_verilog -formal -D FROST_XILINX_PRIMS -sv served_window_coverage.sv served_window_coverage_formal.sv
bmc_32_xilinx: read_verilog -formal +/xilinx/cells_sim.v
bmc_32_xilinx: read_verilog -formal -D FROST_XILINX_PRIMS -sv served_window_coverage.sv served_window_coverage_formal.sv
prove: read_verilog -formal +/xilinx/cells_sim.v
prove: read_verilog -formal -D FROST_XILINX_PRIMS -sv served_window_coverage.sv served_window_coverage_formal.sv
cover: read_verilog -formal -D SERVED_WINDOW_COVER -sv served_window_coverage.sv served_window_coverage_formal.sv
bmc: chparam -set WORD_BITS 62 served_window_coverage_formal
bmc_xilinx: chparam -set WORD_BITS 62 served_window_coverage_formal
prove: chparam -set WORD_BITS 62 served_window_coverage_formal
cover: chparam -set WORD_BITS 62 served_window_coverage_formal
hierarchy -top served_window_coverage_formal
script free_undefined.ys
prep -top served_window_coverage_formal -flatten
~cover: select -assert-count 4 t:$check r:FLAVOR=assert %i
cover: select -assert-count 4 t:$check r:FLAVOR=cover %i
select -assert-none t:$assume
select -assert-none t:$check r:FLAVOR=assume %i

[files]
../hw/rtl/cpu_and_mem/cpu/if_stage/served_window_coverage.sv
served_window_coverage_formal.sv
free_undefined.ys
