[tasks]
prove

[options]
mode prove
depth 2

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rob_serializer.sv rob_alloc_lvt_reference.sv
read -formal -D SYNTHESIS -D ROB_ALLOC_LVT_LOCAL_PROOF -sv reorder_buffer.sv
hierarchy -top reorder_buffer
proc
delete -port reorder_buffer/o:*
opt_clean -purge
prep -top reorder_buffer -flatten
# Expose corresponding bit registers across wide and separate RAM words.
# Without this, output-only equality is too weak for induction on arbitrary states.
memory_map
techmap
opt
select -assert-none t:$assume
select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 2 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
rob_alloc_lvt_reference.sv
