[tasks]
prove

[options]
mode prove
aigsmt boolector

[engines]
# Read-port equality alone cannot establish that hidden rows agree.
# Prove correspondence of initialized RAM bits over every transition
# before proving the two read-port comparisons.
abc lcorr; pdr

[script]
read -sv riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rob_serializer.sv sfence_operand_store.sv rob_alloc_lvt_reference.sv
read -formal -D SYNTHESIS -D ROB_ALLOC_LVT_LOCAL_PROOF -sv reorder_buffer.sv
hierarchy -top reorder_buffer
script free_undefined.ys
delete -port reorder_buffer/o:*
opt_clean -purge
prep -top reorder_buffer -flatten
select -assert-none t:$assume
select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 2 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/sfence_operand_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
rob_alloc_lvt_reference.sv
free_undefined.ys
