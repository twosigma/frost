[tasks]
immu_twin immu
immu_twin_hold immu hold

[options]
mode bmc
depth 1
timeout 180

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS riscv_pkg.sv dtlb.sv immu.sv
hold: chparam -set PA_VALID_COPIES 4 -set PA_COPY_HOLD 1 immu
hierarchy -check -top immu
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 117 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut immu/w:*
select -assert-none immu/t:$dff %co:+[Q] immu/w:* %i %co1 immu/t:* %i
select -assert-count 1402 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS riscv_pkg.sv dtlb.sv immu.sv
hold: chparam -set PA_VALID_COPIES 4 -set PA_COPY_HOLD 1 immu
hierarchy -check -top immu
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 117 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut immu/w:*
select -assert-none immu/t:$dff %co:+[Q] immu/w:* %i %co1 immu/t:* %i
select -assert-count 1402 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists, including declared indices.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
select -assert-count 2804 t:$anyseq
select -assert-count 1402 t:$anyseq n:*_gold %i
select -assert-count 1402 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
~hold: select -assert-min 6 @blk
hold: select -assert-min 12 @blk
~hold: select -assert-min 6437 t:$equiv
hold: select -assert-min 6443 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
../hw/rtl/cpu_and_mem/cpu/mmu/immu.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
