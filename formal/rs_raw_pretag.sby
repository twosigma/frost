# Raw-wakeup candidate tags, exported winners, and selected ready-vector equivalence.
[tasks]
bmc
bmc_export
bmc_ready_vector

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv
read -sv -D SYNTHESIS mem_wakeup_merge.sv
bmc: read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -sv reservation_station.sv rs_raw_pretag_equiv.sv
bmc_export: read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -sv reservation_station.sv rs_raw_pretag_equiv.sv
bmc_ready_vector: read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -D RS_PRETAG_READY_VECTOR_PROOF -sv reservation_station.sv rs_raw_pretag_equiv.sv
bmc_export: chparam -set PREISSUE_READY_EXPORT 1 rs_raw_pretag_equiv
bmc_ready_vector: chparam -set PREISSUE_READY_EXPORT 1 rs_raw_pretag_equiv
hierarchy -top rs_raw_pretag_equiv
proc
flatten
setundef -undriven -anyseq
opt
prep -top rs_raw_pretag_equiv
select -assert-none t:$assume
bmc: select -assert-count 1 t:$check
bmc_export: select -assert-count 11 t:$check
bmc_ready_vector: select -assert-count 12 t:$check

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/tomasulo_wrapper/wakeup/mem_wakeup_merge.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
rs_raw_pretag_equiv.sv
