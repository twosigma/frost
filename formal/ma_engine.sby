[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 16
prove: mode prove
prove: depth 2
prove: timeout 60

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv ma_pkg.sv
read -formal -sv line_align.sv
bmc: read -formal -sv ma_engine.sv
cover: read -formal -sv ma_engine.sv
prove: read -formal -D MA_ENGINE_REQUEST_PROOF -sv ma_engine.sv
hierarchy -top ma_engine
script free_undefined.ys
prep -top ma_engine

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/misaligned/ma_pkg.sv
../hw/rtl/lib/line_align.sv
../hw/rtl/cpu_and_mem/cpu/misaligned/ma_engine.sv
free_undefined.ys
