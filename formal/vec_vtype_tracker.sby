[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove: depth 18
cover: mode cover
cover: depth 18
timeout 300

[engines]
bmc: smtbmc boolector
prove: abc pdr
cover: smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv vec_cfg_unit.sv
read -formal -sv vec_vtype_tracker.sv
read -formal -sv vec_vtype_tracker_formal.sv
hierarchy -top vec_vtype_tracker_formal
script free_undefined.ys
prep -top vec_vtype_tracker_formal
select -assert-count 9 t:$check r:FLAVOR=assert %i
select -assert-count 8 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_cfg_unit.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_vtype_tracker.sv
vec_vtype_tracker_formal.sv
free_undefined.ys
