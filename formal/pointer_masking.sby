# Copyright (c) 2026 John Goodacre.
#
# Ssnpm pointer masking: the base-register transform at MEM_RS issue gives
# every address consumer the ignore transformation's result (Sv39 canonical
# check, Bare PMA decodes, xtval), and senvcfg.PMM's WARL legalization.
# Combinational, so one BMC step covers every input.
[tasks]
bmc
bmc_ddr31
bmc_ddr36
bmc_ddr37

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
bmc_ddr31: verilog_defines -D FROST_DDR_CAPACITY_LOG2_BYTES=31
bmc_ddr36: verilog_defines -D FROST_DDR_CAPACITY_LOG2_BYTES=36
bmc_ddr37: verilog_defines -D FROST_DDR_CAPACITY_LOG2_BYTES=37
read -formal -sv riscv_pkg.sv
read -formal -sv ma_pkg.sv
read -formal -sv pointer_masking.sv
prep -top pointer_masking

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/misaligned/ma_pkg.sv
pointer_masking.sv
