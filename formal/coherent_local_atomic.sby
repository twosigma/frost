[tasks]
amo_bmc bmc amo
sc_bmc bmc sc
amo_cover cover amo
sc_cover cover sc
reservation_prove reservation

[options]
bmc: mode bmc
cover: mode cover
reservation: mode prove
depth 100
reservation: depth 2
timeout 1200
bmc: aigsmt boolector

[engines]
bmc: abc bmc3 -c
cover: smtbmc boolector
reservation: smtbmc boolector

[script]
read -sv riscv_pkg.sv
read -sv cache_perf_pkg.sv
read -sv coherence_pkg.sv
read -sv sdp_dist_ram.sv
read -formal -sv sq_forwarding_unit.sv
read -sv store_queue.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -sv coherent_lq_issue_selector.sv
read -sv coherent_lq_candidate_select.sv
read -sv coherent_lq_address_store.sv
read -sv load_queue.sv
read -sv data_mem_request_router.sv
read -sv sc_pending_unit.sv
read -sv coherent_atomic_guard.sv
read -sv sdp_block_ram.sv
read -sv sdp_packed_tag_uram.sv
read -sv sdp_ram_byte_en.sv
read -sv coherence_read_flags.sv
read -sv coherence_read_select.sv
read -sv coherence_read_payload.sv
read -sv coherence_request_endpoint.sv
read -sv coherence_put_endpoint.sv
read -sv coherence_store_buffer.sv
read -sv coherence_array.sv
read -sv -D LOCAL_ATOMIC_DEPENDENCY coherence_l1d.sv
read -sv fu_cdb_adapter.sv cdb_arbiter.sv
read -formal -sv -D LOCAL_ATOMIC_DEPENDENCY -noautowire coherence_store_boundary_formal.sv coherent_local_atomic_formal.sv
amo: chparam -set MODE 1 coherent_local_atomic_formal
sc: chparam -set MODE 2 coherent_local_atomic_formal
cover: chparam -set COVER_MODE 1 coherent_local_atomic_formal
~reservation: prep -flatten -top coherent_local_atomic_formal
reservation: prep -flatten -top coherent_local_reservation_formal
chformal -assert -cover -remove c:*sq_forwarding_unit_inst*
amo: chformal -cover -remove c:*p_sc_*
sc: chformal -cover -remove c:*p_amo_*
memory_map
opt
techmap
opt -fast
setundef -anyseq
opt_clean

