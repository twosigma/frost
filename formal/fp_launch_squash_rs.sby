# Producer property for fp_shim LAUNCH_SQUASH on the real FP_RS
# (see fp_launch_squash_rs_producer.sv).
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 14

[engines]
smtbmc boolector

[script]
read -sv -D SYNTHESIS riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv
prove: read -sv -D SYNTHESIS reservation_station.sv
cover: read -sv -D SYNTHESIS reservation_station.sv
prove: read -formal fp_launch_squash_rs_producer.sv
cover: read -formal -D FP_LS_COVER_FROM_RESET fp_launch_squash_rs_producer.sv
prep -top fp_launch_squash_rs_producer
prove: select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 2 t:$check r:FLAVOR=assert %i
select -assert-none t:$assume t:$assert

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
fp_launch_squash_rs_producer.sv
