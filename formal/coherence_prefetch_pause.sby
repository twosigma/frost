[tasks]
pf_pause_prove proof
pf_pause_cover reach

[options]
proof: mode prove
proof: depth 12
reach: mode cover
reach: depth 24

[engines]
smtbmc boolector

[script]
read -formal -sv coherence_prefetch_pause.sv coherence_prefetch_pause_formal.sv
prep -top coherence_prefetch_pause_formal

[files]
../hw/rtl/lib/cache/coherence_prefetch_pause.sv
coherence_prefetch_pause_formal.sv
