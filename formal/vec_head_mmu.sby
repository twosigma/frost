[tasks]
bmc
cover
stride_bmc
stride_fault_e0_bmc
stride_fault_e2_bmc
stride_cover
index_bmc
index_fault_e0_bmc
index_fault_e2_bmc
index_irq_bmc
index_irq_resume_bmc
index_cover
uncached_bmc
uncached_fault_bmc
uncached_irq_bmc
uncached_seg_bmc
uncached_seg_fault_bmc
uncached_seg_irq_bmc
uncached_cover

[options]
bmc: mode bmc
bmc: depth 48
cover: mode cover
cover: depth 90
stride_bmc: mode bmc
stride_bmc: depth 60
stride_fault_e0_bmc: mode bmc
stride_fault_e0_bmc: depth 60
stride_fault_e2_bmc: mode bmc
stride_fault_e2_bmc: depth 60
stride_cover: mode cover
stride_cover: depth 60
index_bmc: mode bmc
index_bmc: depth 60
index_fault_e0_bmc: mode bmc
index_fault_e0_bmc: depth 60
index_fault_e2_bmc: mode bmc
index_fault_e2_bmc: depth 60
index_irq_bmc: mode bmc
index_irq_bmc: depth 60
index_irq_resume_bmc: mode bmc
index_irq_resume_bmc: depth 60
index_cover: mode cover
index_cover: depth 60
uncached_bmc: mode bmc
uncached_bmc: depth 36
uncached_fault_bmc: mode bmc
uncached_fault_bmc: depth 36
uncached_irq_bmc: mode bmc
uncached_irq_bmc: depth 36
uncached_seg_bmc: mode bmc
uncached_seg_bmc: depth 44
uncached_seg_fault_bmc: mode bmc
uncached_seg_fault_bmc: depth 44
uncached_seg_irq_bmc: mode bmc
uncached_seg_irq_bmc: depth 44
uncached_cover: mode cover
uncached_cover: depth 44
bmc: timeout 1200
cover: timeout 180
stride_bmc: timeout 1080
stride_fault_e0_bmc: timeout 300
stride_fault_e2_bmc: timeout 1080
stride_cover: timeout 900
index_bmc: timeout 900
index_fault_e0_bmc: timeout 300
index_fault_e2_bmc: timeout 900
index_irq_bmc: timeout 900
index_irq_resume_bmc: timeout 900
index_cover: timeout 900
uncached_bmc: timeout 600
uncached_fault_bmc: timeout 900
uncached_irq_bmc: timeout 600
uncached_seg_bmc: timeout 600
uncached_seg_fault_bmc: timeout 900
uncached_seg_irq_bmc: timeout 600
uncached_cover: timeout 900

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv ma_pkg.sv
bmc: read -formal -D VEC_HEAD_MMU_PROOF -sv vec_head_mmu.sv
cover: read -formal -D VEC_HEAD_MMU_PROOF -sv vec_head_mmu.sv
stride_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_RUN_NOFAULT_PROOF -sv vec_head_mmu.sv
stride_fault_e0_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_RUN_FAULT_E0_PROOF -sv vec_head_mmu.sv
stride_fault_e2_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_RUN_FAULT_E2_PROOF -sv vec_head_mmu.sv
stride_cover: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -sv vec_head_mmu.sv
index_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -D VEC_HEAD_MMU_INDEX_NOIRQ_PROOF -D VEC_HEAD_MMU_RUN_NOFAULT_PROOF -sv vec_head_mmu.sv
index_fault_e0_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -D VEC_HEAD_MMU_INDEX_NOIRQ_PROOF -D VEC_HEAD_MMU_RUN_FAULT_E0_PROOF -sv vec_head_mmu.sv
index_fault_e2_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -D VEC_HEAD_MMU_INDEX_NOIRQ_PROOF -D VEC_HEAD_MMU_RUN_FAULT_E2_PROOF -sv vec_head_mmu.sv
index_irq_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -D VEC_HEAD_MMU_INDEX_IRQ_PROOF -D VEC_HEAD_MMU_INDEX_IRQ_FLUSH_PROOF -sv vec_head_mmu.sv
index_irq_resume_bmc: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -D VEC_HEAD_MMU_INDEX_IRQ_PROOF -D VEC_HEAD_MMU_INDEX_IRQ_RESUME_PROOF -sv vec_head_mmu.sv
index_cover: read -formal -D VEC_HEAD_MMU_STRIDE_PROOF -D VEC_HEAD_MMU_INDEXED -sv vec_head_mmu.sv
uncached_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_ELEM_PROOF -D VEC_HEAD_MMU_UNCACHED_OK_PROOF -sv vec_head_mmu.sv
uncached_fault_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_ELEM_PROOF -D VEC_HEAD_MMU_UNCACHED_FAULT_PROOF -sv vec_head_mmu.sv
uncached_irq_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_ELEM_PROOF -D VEC_HEAD_MMU_UNCACHED_IRQ_PROOF -sv vec_head_mmu.sv
uncached_seg_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_SEG_PROOF -D VEC_HEAD_MMU_UNCACHED_OK_PROOF -sv vec_head_mmu.sv
uncached_seg_fault_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_SEG_PROOF -D VEC_HEAD_MMU_UNCACHED_FAULT_PROOF -sv vec_head_mmu.sv
uncached_seg_irq_bmc: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -D VEC_HEAD_MMU_UNCACHED_SEG_PROOF -D VEC_HEAD_MMU_UNCACHED_IRQ_PROOF -sv vec_head_mmu.sv
uncached_cover: read -formal -D VEC_HEAD_MMU_UNCACHED_PROOF -sv vec_head_mmu.sv
bmc: chparam -set VLEN 256 vec_head_mmu
cover: chparam -set VLEN 256 vec_head_mmu
stride_bmc: chparam -set VLEN 128 vec_head_mmu
stride_fault_e0_bmc: chparam -set VLEN 128 vec_head_mmu
stride_fault_e2_bmc: chparam -set VLEN 128 vec_head_mmu
stride_cover: chparam -set VLEN 128 vec_head_mmu
index_bmc: chparam -set VLEN 128 vec_head_mmu
index_fault_e0_bmc: chparam -set VLEN 128 vec_head_mmu
index_fault_e2_bmc: chparam -set VLEN 128 vec_head_mmu
index_irq_bmc: chparam -set VLEN 128 vec_head_mmu
index_irq_resume_bmc: chparam -set VLEN 128 vec_head_mmu
index_cover: chparam -set VLEN 128 vec_head_mmu
uncached_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_fault_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_irq_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_seg_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_seg_fault_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_seg_irq_bmc: chparam -set VLEN 128 vec_head_mmu
uncached_cover: chparam -set VLEN 128 vec_head_mmu
hierarchy -top vec_head_mmu
script free_undefined.ys
prep -top vec_head_mmu
bmc: select -assert-count 12 t:$check r:FLAVOR=assert %i
cover: select -assert-count 12 t:$check r:FLAVOR=assert %i
bmc: select -assert-count 4 t:$check r:FLAVOR=cover %i
cover: select -assert-count 4 t:$check r:FLAVOR=cover %i
stride_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
stride_fault_e0_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
stride_fault_e2_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
stride_cover: select -assert-count 24 t:$check r:FLAVOR=assert %i
stride_bmc: select -assert-count 3 t:$check r:FLAVOR=cover %i
stride_fault_e0_bmc: select -assert-count 3 t:$check r:FLAVOR=cover %i
stride_fault_e2_bmc: select -assert-count 3 t:$check r:FLAVOR=cover %i
stride_cover: select -assert-count 3 t:$check r:FLAVOR=cover %i
index_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_fault_e0_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_fault_e2_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_irq_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_irq_resume_bmc: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_cover: select -assert-count 24 t:$check r:FLAVOR=assert %i
index_bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
index_fault_e0_bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
index_fault_e2_bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
index_irq_bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
index_irq_resume_bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
index_cover: select -assert-count 6 t:$check r:FLAVOR=cover %i
uncached_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_fault_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_irq_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_seg_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_seg_fault_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_seg_irq_bmc: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_cover: select -assert-count 23 t:$check r:FLAVOR=assert %i
uncached_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_fault_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_irq_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_seg_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_seg_fault_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_seg_irq_bmc: select -assert-count 7 t:$check r:FLAVOR=cover %i
uncached_cover: select -assert-count 7 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/misaligned/ma_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_head_mmu.sv
free_undefined.ys
