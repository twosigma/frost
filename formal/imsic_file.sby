[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
read -formal -sv imsic_priority.sv imsic_file.sv
# The CPU's configuration: 63 identities, APLIC delivery, and the select and
# identity decodes registered beside *iselect and the MSI ingress.
chparam -set NUM_IDS 63 -set APLIC_DELIVERY 1 -set PREDECODED_SELECT 1 -set PREDECODED_MSI 1 imsic_file
prep -top imsic_file

[files]
../hw/rtl/peripherals/imsic/imsic_priority.sv
../hw/rtl/peripherals/imsic/imsic_file.sv
