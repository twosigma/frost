[tasks]
bmc
bmc_64g
bmc_128g
cover
cover_64g
cover_128g

[options]
bmc: mode bmc
bmc: depth 12
bmc_64g: mode bmc
bmc_64g: depth 12
bmc_128g: mode bmc
bmc_128g: depth 12
cover: mode cover
cover: depth 16
cover_64g: mode cover
cover_64g: depth 16
cover_128g: mode cover
cover_128g: depth 16

[engines]
smtbmc boolector

[script]
read -formal -sv line_port_axi_bridge.sv
# The width below the L2: one 64-byte line per beat.
chparam -set LINE_BYTES 64 line_port_axi_bridge
bmc_64g: chparam -set ADDR_WIDTH 37 -set AXI_ADDR_WIDTH 36 line_port_axi_bridge
bmc_128g: chparam -set ADDR_WIDTH 38 -set AXI_ADDR_WIDTH 37 line_port_axi_bridge
cover_64g: chparam -set ADDR_WIDTH 37 -set AXI_ADDR_WIDTH 36 line_port_axi_bridge
cover_128g: chparam -set ADDR_WIDTH 38 -set AXI_ADDR_WIDTH 37 line_port_axi_bridge
hierarchy -top line_port_axi_bridge
script free_undefined.ys
prep -top line_port_axi_bridge
select -assert-count 51 t:$check r:FLAVOR=assert %i
bmc: select -assert-count 6 t:$check r:FLAVOR=cover %i
cover: select -assert-count 6 t:$check r:FLAVOR=cover %i
bmc_64g: select -assert-count 7 t:$check r:FLAVOR=cover %i
bmc_128g: select -assert-count 7 t:$check r:FLAVOR=cover %i
cover_64g: select -assert-count 7 t:$check r:FLAVOR=cover %i
cover_128g: select -assert-count 7 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/lib/cache/line_port_axi_bridge.sv
free_undefined.ys
