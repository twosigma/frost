[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 5
prove: mode prove
prove: depth 2

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -D SYNTHESIS -D MISPREDICT_CAPTURE_LOCAL_PROOF -sv misprediction_flush_controller.sv
hierarchy -top misprediction_flush_controller
script free_undefined.ys
prep -top misprediction_flush_controller
select -assert-none t:$assume
select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 4 t:$check r:FLAVOR=assert %i
select -assert-count 1 w:o_fetch_flush %a %ci1 t:$dff %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/cpu_ooo/branch_recovery/misprediction_flush_controller.sv
free_undefined.ys
