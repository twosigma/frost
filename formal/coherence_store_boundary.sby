[tasks]
bmc_four_control bmc regular load four four_partition four_control
bmc_four_value_0 bmc regular load four four_partition four_value watched0
bmc_four_value_1 bmc regular load four four_partition four_value watched1
bmc_four_value_2 bmc regular load four four_partition four_value watched2
bmc_four_value_3 bmc regular load four four_partition four_value watched3
cover_four cover lifecycle load four
bmc_intervening_same_flow bmc regular intervening same int_partition int_flow
bmc_intervening_other_flow bmc regular intervening other int_partition int_flow
bmc_intervening_same_value bmc regular intervening same int_partition int_value
bmc_intervening_other_value bmc regular intervening other int_partition int_value
bmc_intervening_fatal bmc intervening int_partition int_fatal
prove_intervening_fatal_sticky intervening sticky
bmc_load_same bmc regular load same ordinary
bmc_load_other bmc regular load other ordinary
bmc_load_same_probe_launch bmc regular load same ordinary probe_launch
bmc_probe_kept_other bmc regular load other ordinary probe_launch read_first
bmc_probe_kept_same bmc regular load same ordinary probe_launch read_first
bmc_amo_same bmc regular amo same amo_partition amo_flow
bmc_amo_same_owner bmc regular amo same amo_partition amo_owner
bmc_amo_same_fatal bmc amo same amo_partition amo_fatal
prove_amo_same_fatal_sticky amo same sticky
bmc_amo_other bmc regular amo other other_partition other_flow
bmc_amo_other_home_state bmc regular amo other other_partition other_home_state
bmc_amo_other_home_id bmc regular amo other other_partition other_home_id
bmc_amo_other_c2b bmc regular amo other other_partition other_c2b
bmc_amo_other_fatal bmc amo other amo_partition amo_fatal
prove_amo_other_fatal_sticky amo other sticky
bmc_sc bmc regular sc
bmc_old bmc regular old
cover_load cover lifecycle load ordinary
cover_amo cover lifecycle amo
cover_amo_same cover lifecycle amo same
cover_amo_same_two cover lifecycle delayed amo same
cover_amo_other_home cover lifecycle amo other homepath
cover_sc cover lifecycle sc
cover_old cover lifecycle old
cover_edges_same cover boundaries delayed load same ordinary
cover_edges_same_combined cover boundaries load same ordinary
cover_edges_other cover boundaries load other ordinary
cover_probe_kept_other cover probe_kept load other ordinary probe_launch read_first
cover_probe_kept_same cover probe_kept load same ordinary probe_launch read_first

[options]
bmc: mode bmc
cover: mode cover
ordinary: depth 80
four: depth 120
# Frame 113 finishes within the split partitions' limits with the hit path;
# the covers reach handoff at 57 and drain at 92. Keep cover_four's search
# depth at 120.
four_partition: depth 114
intervening: depth 140
old: depth 80
amo: depth 140
sc: depth 140
timeout 2400
# Opening undefined values with free_undefined.ys prevents merging duplicate
# RAM write-enable muxes across the store queue, load queue and L1D. The
# four-record and intervening-load tasks are split by assertion partition
# (control/flow, value, and fatal) and watched-store / sector case so every
# partition finishes cleanly under 15,840 s with headroom for slower runners.
bmc_four_control: timeout 3600
bmc_four_value_0: timeout 15840
bmc_four_value_1: timeout 10800
bmc_four_value_2: timeout 8400
bmc_four_value_3: timeout 3600
cover_four: timeout 7200
bmc_intervening_same_flow: timeout 8400
bmc_intervening_other_flow: timeout 13200
bmc_intervening_same_value: timeout 10800
bmc_intervening_other_value: timeout 15840
bmc_intervening_fatal: timeout 1200
bmc_amo_same: timeout 6600
bmc_amo_other: timeout 6900
bmc_amo_other_home_state: timeout 600
bmc_amo_other_home_id: timeout 13800
bmc_amo_other_c2b: timeout 5400
bmc_amo_same_owner: timeout 3000
bmc_amo_same_fatal: timeout 3000
bmc_amo_other_fatal: timeout 4800
bmc_load_same_probe_launch: timeout 3600
bmc_probe_kept_same: timeout 5400
bmc_probe_kept_other: timeout 8400
# The SC handoff BMC takes about 45 minutes; CI runners take up to about 2.2
# times as long.
bmc_sc: timeout 6000
bmc: aigsmt boolector
sticky: mode prove
sticky: depth 2
sticky: timeout 120

[engines]
regular: abc bmc3 -c
# Fatal status persists after the initial reset. The induction and frame-139
# checks together exclude every fatal sample in the 140-frame horizon.
# Run through test_run_formal.py, which validates the selected-frame result.
amo_fatal: abc bmc3 -c -S 139
int_fatal: abc bmc3 -c -S 139
sticky: smtbmc boolector
cover: smtbmc boolector

[script]
read -sv coherence_read_stream.sv
read -sv riscv_pkg.sv vec_hold_rows.sv
read -sv cache_perf_pkg.sv
read -sv coherence_pkg.sv
read -sv sdp_dist_ram.sv
read -formal -sv sq_forwarding_unit.sv
read -sv store_queue.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -sv coherent_lq_issue_selector.sv
read -sv coherent_lq_candidate_select.sv
read -sv coherent_lq_address_store.sv
# The ordinary load tasks keep the LQ's registered same-sector match checks.
ordinary: read -sv -D LQ_SECTOR_MATCH_PROOF load_queue.sv
~ordinary: read -sv load_queue.sv
read -sv data_mem_request_router.sv
read -sv sc_pending_unit.sv
read -sv coherent_atomic_guard.sv
read -sv sdp_block_ram.sv
read -sv sdp_packed_tag_uram.sv
read -sv sdp_ram_byte_en.sv
read -sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv
read -sv coherence_grant_select.sv coherence_read_select.sv
read -sv coherence_read_payload.sv
read -sv coherence_request_endpoint.sv
read -sv coherence_put_endpoint.sv
read -sv coherence_store_buffer.sv
read -sv coherence_array.sv
read -sv -D LOCAL_ATOMIC_DEPENDENCY coherence_l1d.sv
~sticky: read -formal -sv -noautowire -D LOCAL_ATOMIC_DEPENDENCY coherence_store_boundary_formal.sv
sticky: read -formal -sv -noautowire -D LOCAL_ATOMIC_DEPENDENCY -D FATAL_STICKY_PROOF coherence_store_boundary_formal.sv
lifecycle: chparam -set COVER_MODE 1 coherence_store_boundary_formal
homepath: chparam -set COVER_AMO_HOME 1 coherence_store_boundary_formal
boundaries: chparam -set COVER_BOUNDARIES 1 coherence_store_boundary_formal
probe_launch: chparam -set PROBE_LAUNCH 1 coherence_store_boundary_formal
read_first: chparam -set PROBE_READ_FIRST 1 coherence_store_boundary_formal
probe_kept: chparam -set COVER_PROBE_KEPT 1 coherence_store_boundary_formal
delayed: chparam -set DELAY_SECOND_STORE 1 coherence_store_boundary_formal
same: chparam -set SECTOR_CASE 0 coherence_store_boundary_formal
other: chparam -set SECTOR_CASE 1 coherence_store_boundary_formal
old: chparam -set SECTOR_CASE 1 coherence_store_boundary_formal
load: chparam -set MODE 0 coherence_store_boundary_formal
four: chparam -set FOUR_STORES 1 coherence_store_boundary_formal
watched0: chparam -set WATCHED_STORE 0 coherence_store_boundary_formal
watched1: chparam -set WATCHED_STORE 1 coherence_store_boundary_formal
watched2: chparam -set WATCHED_STORE 2 coherence_store_boundary_formal
watched3: chparam -set WATCHED_STORE 3 coherence_store_boundary_formal
intervening: chparam -set MODE 4 coherence_store_boundary_formal
amo: chparam -set MODE 1 coherence_store_boundary_formal
sc: chparam -set MODE 2 coherence_store_boundary_formal
old: chparam -set MODE 3 coherence_store_boundary_formal
hierarchy -top coherence_store_boundary_formal
script free_undefined.ys
prep -flatten -top coherence_store_boundary_formal
check -assert
chformal -assert -cover -remove c:*sq_forwarding_unit_inst*
intervening: chformal -cover -remove
load: chformal -cover -remove c:*p_amo_* c:*p_sc_* c:*p_old_*
amo: chformal -cover -remove c:*p_load_* c:*p_sc_* c:*p_old_*
sc: chformal -cover -remove c:*p_load_* c:*p_amo_* c:*p_old_*
old: chformal -cover -remove c:*p_load_* c:*p_amo_* c:*p_sc_*
four_partition: select -assert-count 23 t:$check r:FLAVOR=assert %i
four_control: chformal -assert -remove c:p_load_value
four_control: select -assert-count 22 t:$check r:FLAVOR=assert %i
four_value: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_load_value %d
four_value: select -assert-count 1 t:$check r:FLAVOR=assert %i
four_value: select -assert-count 1 c:p_load_value
int_partition: select -assert-count 19 t:$check r:FLAVOR=assert %i
int_flow: chformal -assert -remove c:p_load_value c:p_no_fatal
int_flow: select -assert-count 17 t:$check r:FLAVOR=assert %i
int_value: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_load_value %d
int_value: select -assert-count 1 t:$check r:FLAVOR=assert %i
int_value: select -assert-count 1 c:p_load_value
int_fatal: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_no_fatal %d
int_fatal: select -assert-count 1 t:$check r:FLAVOR=assert %i
int_fatal: select -assert-count 1 c:p_no_fatal
amo_partition: select -assert-count 19 t:$check r:FLAVOR=assert %i
amo_flow: chformal -assert -remove c:p_no_buffered_atomic c:p_no_buffered_guard c:p_no_fatal
amo_flow: select -assert-count 16 t:$check r:FLAVOR=assert %i
other_partition: select -assert-count 19 t:$check r:FLAVOR=assert %i
other_flow: chformal -assert -remove c:p_no_fatal c:p_home_consume_state c:p_home_completion_id c:p_c2b_write_busy_atomic c:p_c2b_store_ack_unbusy
other_flow: select -assert-count 14 t:$check r:FLAVOR=assert %i
other_home_state: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_home_consume_state %d
other_home_state: select -assert-count 1 t:$check r:FLAVOR=assert %i
other_home_id: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_home_completion_id %d
other_home_id: select -assert-count 1 t:$check r:FLAVOR=assert %i
other_c2b: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_c2b_write_busy_atomic c:p_c2b_store_ack_unbusy %u %d
other_c2b: select -assert-count 2 t:$check r:FLAVOR=assert %i
amo_owner: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_no_buffered_atomic c:p_no_buffered_guard %u %d
amo_owner: select -assert-count 2 t:$check r:FLAVOR=assert %i
amo_fatal: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_no_fatal %d
amo_fatal: select -assert-count 1 t:$check r:FLAVOR=assert %i
amo_fatal: select -assert-count 1 c:p_no_fatal
sticky: select -assert-count 20 t:$check r:FLAVOR=assert %i
sticky: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_fatal_sticky %d
sticky: select -assert-count 1 t:$check r:FLAVOR=assert %i
sticky: select -assert-count 1 c:p_fatal_sticky
# Every finite prefix extends because these tasks have no environment assumptions.
amo_fatal: select -assert-none t:$assume
amo_fatal: select -assert-none t:$check r:FLAVOR=assume %i
int_fatal: select -assert-none t:$assume
int_fatal: select -assert-none t:$check r:FLAVOR=assume %i
sticky: select -assert-none t:$assume
sticky: select -assert-none t:$check r:FLAVOR=assume %i
memory_map
opt
bmc: techmap
bmc: opt -fast
bmc: setundef -anyseq
bmc: opt_clean
check -assert

