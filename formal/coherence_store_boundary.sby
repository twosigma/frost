[tasks]
bmc_four bmc regular load four
cover_four cover lifecycle load four
bmc_intervening bmc regular intervening
bmc_load_same bmc regular load same ordinary
bmc_load_other bmc regular load other ordinary
bmc_amo_same bmc regular amo same amo_partition amo_flow
bmc_amo_same_owner bmc regular amo same amo_partition amo_owner
bmc_amo_same_fatal bmc amo same amo_partition amo_fatal
prove_amo_same_fatal_sticky amo same sticky
bmc_amo_other bmc regular amo other other_flow
bmc_amo_other_fatal bmc amo other amo_partition amo_fatal
prove_amo_other_fatal_sticky amo other sticky
bmc_sc bmc regular sc
bmc_old bmc regular old
cover_load cover lifecycle load ordinary
cover_amo cover lifecycle amo
cover_amo_same cover lifecycle amo same
cover_amo_other_home cover lifecycle amo other homepath
cover_sc cover lifecycle sc
cover_old cover lifecycle old
cover_edges_same cover boundaries load same ordinary
cover_edges_other cover boundaries load other ordinary

[options]
bmc: mode bmc
cover: mode cover
ordinary: depth 80
four: depth 120
intervening: depth 140
old: depth 80
amo: depth 140
sc: depth 140
timeout 2400
four: timeout 7200
intervening: timeout 7200
bmc: aigsmt boolector
sticky: mode prove
sticky: depth 2
sticky: timeout 120

[engines]
regular: abc bmc3 -c
# Fatal status persists after the initial reset. The induction and frame-139
# checks together exclude every fatal sample in the 140-frame horizon.
# Run through test_run_formal.py, which validates the selected-frame result.
amo_fatal: abc bmc3 -c -S 139
sticky: smtbmc boolector
cover: smtbmc boolector

[script]
read -sv coherence_read_stream.sv
read -sv riscv_pkg.sv
read -sv cache_perf_pkg.sv
read -sv coherence_pkg.sv
read -sv sdp_dist_ram.sv
read -formal -sv sq_forwarding_unit.sv
read -sv store_queue.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -sv coherent_lq_issue_selector.sv
read -sv coherent_lq_candidate_select.sv
read -sv coherent_lq_address_store.sv
read -sv load_queue.sv
read -sv data_mem_request_router.sv
read -sv sc_pending_unit.sv
read -sv coherent_atomic_guard.sv
read -sv sdp_block_ram.sv
read -sv sdp_packed_tag_uram.sv
read -sv sdp_ram_byte_en.sv
read -sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv
read -sv coherence_grant_select.sv coherence_read_select.sv
read -sv coherence_read_payload.sv
read -sv coherence_request_endpoint.sv
read -sv coherence_put_endpoint.sv
read -sv coherence_store_buffer.sv
read -sv coherence_array.sv
read -sv -D LOCAL_ATOMIC_DEPENDENCY coherence_l1d.sv
~sticky: read -formal -sv -noautowire -D LOCAL_ATOMIC_DEPENDENCY coherence_store_boundary_formal.sv
sticky: read -formal -sv -noautowire -D LOCAL_ATOMIC_DEPENDENCY -D FATAL_STICKY_PROOF coherence_store_boundary_formal.sv
lifecycle: chparam -set COVER_MODE 1 coherence_store_boundary_formal
homepath: chparam -set COVER_AMO_HOME 1 coherence_store_boundary_formal
boundaries: chparam -set COVER_BOUNDARIES 1 coherence_store_boundary_formal
same: chparam -set SECTOR_CASE 0 coherence_store_boundary_formal
other: chparam -set SECTOR_CASE 1 coherence_store_boundary_formal
old: chparam -set SECTOR_CASE 1 coherence_store_boundary_formal
load: chparam -set MODE 0 coherence_store_boundary_formal
four: chparam -set FOUR_STORES 1 coherence_store_boundary_formal
intervening: chparam -set MODE 4 coherence_store_boundary_formal
amo: chparam -set MODE 1 coherence_store_boundary_formal
sc: chparam -set MODE 2 coherence_store_boundary_formal
old: chparam -set MODE 3 coherence_store_boundary_formal
prep -flatten -top coherence_store_boundary_formal
check -assert
chformal -assert -cover -remove c:*sq_forwarding_unit_inst*
intervening: chformal -cover -remove
load: chformal -cover -remove c:*p_amo_* c:*p_sc_* c:*p_old_*
amo: chformal -cover -remove c:*p_load_* c:*p_sc_* c:*p_old_*
sc: chformal -cover -remove c:*p_load_* c:*p_amo_* c:*p_old_*
old: chformal -cover -remove c:*p_load_* c:*p_amo_* c:*p_sc_*
amo_partition: select -assert-count 17 t:$check r:FLAVOR=assert %i
amo_flow: chformal -assert -remove c:p_no_buffered_atomic c:p_no_buffered_guard c:p_no_fatal
amo_flow: select -assert-count 14 t:$check r:FLAVOR=assert %i
other_flow: select -assert-count 17 t:$check r:FLAVOR=assert %i
other_flow: chformal -assert -remove c:p_no_fatal
other_flow: select -assert-count 16 t:$check r:FLAVOR=assert %i
amo_owner: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_no_buffered_atomic c:p_no_buffered_guard %u %d
amo_owner: select -assert-count 2 t:$check r:FLAVOR=assert %i
amo_fatal: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_no_fatal %d
amo_fatal: select -assert-count 1 t:$check r:FLAVOR=assert %i
amo_fatal: select -assert-count 1 c:p_no_fatal
sticky: select -assert-count 18 t:$check r:FLAVOR=assert %i
sticky: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_fatal_sticky %d
sticky: select -assert-count 1 t:$check r:FLAVOR=assert %i
sticky: select -assert-count 1 c:p_fatal_sticky
# Every finite prefix extends because these tasks have no environment assumptions.
amo_fatal: select -assert-none t:$assume
amo_fatal: select -assert-none t:$check r:FLAVOR=assume %i
sticky: select -assert-none t:$assume
sticky: select -assert-none t:$check r:FLAVOR=assume %i
memory_map
opt
bmc: techmap
bmc: opt -fast
bmc: setundef -anyseq
bmc: opt_clean
check -assert

