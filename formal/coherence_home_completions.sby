[tasks]
coh_completions_prove proof plain base
coh_completions_pairs_prove proof pairs plain base
coh_completions_partition_prove proof partition base
coh_completions_partition2_prove proof partition2 base
coh_completions_fast_prove proof plain fast base
coh_completions_fast_partition_prove proof partition fast base
coh_completions_cover covers plain base
coh_completions_partition_cover covers partition base
coh_completions_partition2_cover covers partition2 base
coh_completions_fast_cover covers plain fast base
coh_if_pair_cover covers if_pair plain

[options]
proof: mode prove
proof: depth 8
proof: aigsmt boolector
covers: mode cover
covers: depth 40
timeout 180
proof: timeout 600
partition2: timeout 900

[engines]
proof: abc pdr
covers: smtbmc boolector

[script]
read -formal -sv coherence_seat_select.sv coherence_work_select.sv
read -sv coherence_pkg.sv coherence_home_endpoint.sv coherence_d_arbiter.sv
~pairs: read -formal -sv coherence_home_completions.sv
pairs: read -formal -sv -D COHERENCE_COMPLETIONS_PAIRS coherence_home_completions.sv
plain: chparam -set SLOTS 3 -set RESULT_SLOTS 2 -set CACHE_BYTES 256 -set WAYS 2 -set PREFETCH_SLOTS 0 coherence_home_completions
partition: chparam -set SLOTS 3 -set RESULT_SLOTS 2 -set CACHE_BYTES 256 -set WAYS 2 -set PREFETCH_SLOTS 1 coherence_home_completions
partition2: chparam -set SLOTS 4 -set RESULT_SLOTS 2 -set CACHE_BYTES 256 -set WAYS 2 -set PREFETCH_SLOTS 2 coherence_home_completions
fast: chparam -set FAST_TAG_LAUNCH 1 coherence_home_completions
base: hierarchy -top coherence_home_completions
base: script free_undefined.ys
base: prep -top coherence_home_completions -flatten
if_pair: read -formal -sv coherence_if_pair_formal.sv
if_pair: hierarchy -top coherence_if_pair_formal
if_pair: script free_undefined.ys
if_pair: prep -top coherence_if_pair_formal -flatten
if_pair: chformal -cover -remove c:*dut*
memory_map -keepdc
opt -keepdc
proof: techmap
proof: opt -keepdc
proof: setundef -undriven -anyseq
coh_completions_prove: select -assert-count 187 t:$check r:FLAVOR=assert %i
coh_completions_cover: select -assert-count 187 t:$check r:FLAVOR=assert %i
coh_if_pair_cover: select -assert-count 187 t:$check r:FLAVOR=assert %i
coh_completions_prove: select -assert-count 9 t:$check r:FLAVOR=cover %i
coh_completions_pairs_prove: select -assert-count 9 t:$check r:FLAVOR=cover %i
coh_completions_partition_prove: select -assert-count 9 t:$check r:FLAVOR=cover %i
coh_completions_cover: select -assert-count 9 t:$check r:FLAVOR=cover %i
coh_completions_partition_cover: select -assert-count 9 t:$check r:FLAVOR=cover %i
pairs: select -assert-count 196 t:$check r:FLAVOR=assert %i
coh_completions_partition_prove: select -assert-count 188 t:$check r:FLAVOR=assert %i
coh_completions_partition_cover: select -assert-count 188 t:$check r:FLAVOR=assert %i
partition2: select -assert-count 244 t:$check r:FLAVOR=assert %i
partition2: select -assert-count 10 t:$check r:FLAVOR=cover %i
coh_completions_fast_prove: select -assert-count 194 t:$check r:FLAVOR=assert %i
coh_completions_fast_cover: select -assert-count 194 t:$check r:FLAVOR=assert %i
fast: select -assert-count 11 t:$check r:FLAVOR=cover %i
coh_completions_fast_partition_prove: select -assert-count 195 t:$check r:FLAVOR=assert %i
if_pair: select -assert-count 4 t:$check r:FLAVOR=cover %i

[files]
coherence_if_pair_formal.sv
../hw/rtl/lib/cache/coherence_seat_select.sv
../hw/rtl/lib/cache/coherence_work_select.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_home_endpoint.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_home_completions.sv
free_undefined.ys
