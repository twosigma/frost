[tasks]
coh_completions_prove proof base
coh_completions_pairs_prove proof pairs base
coh_completions_partition_prove proof partition base
coh_completions_cover covers base
coh_completions_partition_cover covers partition base
coh_if_pair_cover covers if_pair

[options]
proof: mode prove
proof: depth 8
proof: aigsmt boolector
covers: mode cover
covers: depth 40
timeout 180

[engines]
proof: abc pdr
covers: smtbmc boolector

[script]
read -formal -sv coherence_seat_select.sv coherence_work_select.sv
read -sv coherence_pkg.sv coherence_home_endpoint.sv coherence_d_arbiter.sv
~pairs: read -formal -sv coherence_home_completions.sv
pairs: read -formal -sv -D COHERENCE_COMPLETIONS_PAIRS coherence_home_completions.sv
~partition: chparam -set SLOTS 3 -set RESULT_SLOTS 2 -set CACHE_BYTES 256 -set WAYS 2 -set PREFETCH_SLOTS 0 coherence_home_completions
partition: chparam -set SLOTS 3 -set RESULT_SLOTS 2 -set CACHE_BYTES 256 -set WAYS 2 -set PREFETCH_SLOTS 1 coherence_home_completions
base: prep -top coherence_home_completions -flatten
if_pair: read -formal -sv coherence_if_pair_formal.sv
if_pair: prep -top coherence_if_pair_formal -flatten
if_pair: chformal -cover -remove c:*dut*
memory_map
opt
proof: techmap
proof: opt
proof: setundef -undriven -anyseq

[files]
coherence_if_pair_formal.sv
../hw/rtl/lib/cache/coherence_seat_select.sv
../hw/rtl/lib/cache/coherence_work_select.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_home_endpoint.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_home_completions.sv
