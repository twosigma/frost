[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read_verilog -formal -D SYNTHESIS -D PC_HOLDOFF_LOCAL_PROOF -D PC_FETCH_HOLDOFF_ONLY -sv pc_controller.sv
# Check all three actual fetch-holdoff equations for arbitrary state and
# inputs. Prediction holdoffs use the captured-tag producer invariant and are
# independently proved by pc_holdoff_tag.sby. Downstream arithmetic/tracker
# leaves do not constrain these combinational fetch identities.
delete t:control_flow_tracker t:pc_increment_calculator
proc
setundef -undriven -anyseq
opt
prep -top pc_controller

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_controller.sv
