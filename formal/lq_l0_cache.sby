[tasks]
bmc
cover
bmc_256
cover_256

[options]
bmc: mode bmc
bmc: depth 8
cover: mode cover
cover: depth 12
bmc_256: mode bmc
bmc_256: depth 8
cover_256: mode cover
cover_256: depth 12

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv lq_l0_cache.sv
bmc: chparam -set DEPTH 128 lq_l0_cache
cover: chparam -set DEPTH 128 lq_l0_cache
bmc_256: chparam -set DEPTH 256 lq_l0_cache
cover_256: chparam -set DEPTH 256 lq_l0_cache
prep -top lq_l0_cache

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
