hierarchy -top coherence_sc_wa_formal
script free_undefined.ys
prep -flatten -top coherence_sc_wa_formal
~covers: chformal -cover -remove
covers: chformal -assert -remove
setattr -unset keep
opt_clean -purge
memory_map -keepdc
opt -keepdc
covers: techmap
covers: opt -fast -keepdc
covers: abc
covers: opt -keepdc -mux_bool -fine
covers: setundef -undriven -anyseq
setundef -anyseq
opt_clean -purge
select -assert-none t:$check r:FLAVOR=assume %i
s0_proof: select -assert-count 141 t:$check r:FLAVOR=assert %i
staged_proof: select -assert-count 150 t:$check r:FLAVOR=assert %i
covers: select -assert-count 12 t:$check r:FLAVOR=cover %i
select -clear
check -assert

