[tasks]
sc_wa_s0_prove proof s0_proof
sc_wa_s1_prove proof staged_proof
sc_wa_s2_prove proof staged_proof
sc_wa_s3_prove proof staged_proof
sc_wa_s0_cover covers
sc_wa_s1_cover covers
sc_wa_s2_cover covers
sc_wa_s3_cover covers

[options]
proof: mode prove
proof: depth 2
covers: mode cover
covers: depth 200
covers: vcd_sim on
proof: timeout 600
covers: timeout 1200

[engines]
proof: smtbmc boolector
covers: btor btormc

[script]
