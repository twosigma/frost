[tasks]
bmc
cover
limit_bmc
limit_cover

[options]
multiclock on
bmc: mode bmc
bmc: depth 30
cover: mode cover
cover: depth 30
limit_bmc: mode bmc
limit_bmc: depth 30
limit_cover: mode cover
limit_cover: depth 30

[engines]
smtbmc boolector

[script]
read -sv sdp_block_ram_dc.sv
read -formal -sv cdc_sync.sv
read -formal -sv async_fifo.sv
chparam -set DEPTH 4 -set DATA_WIDTH 4 -set READY_MARGIN 1 async_fifo
limit_bmc: chparam -set DYNAMIC_LIMIT 1 async_fifo
limit_cover: chparam -set DYNAMIC_LIMIT 1 async_fifo
hierarchy -top async_fifo
script free_undefined.ys
prep -top async_fifo
select -assert-count 11 t:$check r:FLAVOR=assert %i
bmc: select -assert-count 2 t:$check r:FLAVOR=cover %i
cover: select -assert-count 2 t:$check r:FLAVOR=cover %i
limit_bmc: select -assert-count 3 t:$check r:FLAVOR=cover %i
limit_cover: select -assert-count 3 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/lib/ram/sdp_block_ram_dc.sv
../hw/rtl/lib/cdc/cdc_sync.sv
../hw/rtl/lib/fifo/async_fifo.sv
free_undefined.ys
