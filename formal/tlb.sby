[tasks]
bmc
cover
bmc_itlb
cover_itlb

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 12
bmc_itlb: mode bmc
bmc_itlb: depth 10
cover_itlb: mode cover
cover_itlb: depth 12

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv dtlb.sv
# The instruction MMU's shape: 8 entries, 2 ports (chparam -set on the module;
# yosys 0.64 cannot reprocess a hierarchy -chparam'd top).
bmc_itlb: chparam -set NUM_ENTRIES 8 -set NUM_PORTS 2 dtlb
cover_itlb: chparam -set NUM_ENTRIES 8 -set NUM_PORTS 2 dtlb
prep -top dtlb

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
