[tasks]
bmc
cover
bmc_itlb
cover_itlb

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 12
bmc_itlb: mode bmc
bmc_itlb: depth 10
cover_itlb: mode cover
cover_itlb: depth 12

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv dtlb.sv
# Match the IMMU's dtlb configuration: 16 entries, two ports and fetch checks
# with data verdicts disabled. Set
# parameters before prep; Yosys 0.64 cannot reprocess a hierarchy after
# changing its top's parameters.
bmc_itlb: chparam -set NUM_ENTRIES 16 -set NUM_PORTS 2 -set FETCH_VERDICTS 1 -set DATA_VERDICTS 0 dtlb
cover_itlb: chparam -set NUM_ENTRIES 16 -set NUM_PORTS 2 -set FETCH_VERDICTS 1 -set DATA_VERDICTS 0 dtlb
prep -top dtlb

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
