[tasks]
bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv pd_redirect_next.sv
read -formal -sv pd_redirect_next_equiv.sv
hierarchy -top pd_redirect_next_equiv
script free_undefined.ys
prep -top pd_redirect_next_equiv
select -assert-count 9 t:$check r:FLAVOR=assert %i
# The slot-1 owner may choose an address only after its PD capture.
select -assert-none */i_backing_hit %co* */o_target_native_low */o_pc_high %u */o_slot1_backing_target %u %i

[files]
pd_redirect_next_equiv.sv
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/pd_stage/pd_redirect_next.sv
free_undefined.ys
