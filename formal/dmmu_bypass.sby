[tasks]
prove
bmc replay
cover replay

[options]
prove: mode prove
prove: depth 3
bmc: mode bmc
bmc: depth 7
cover: mode cover
cover: depth 8

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
replay: read -sv -D SYNTHESIS dtlb.sv
replay: read -formal -D SYNTHESIS -D DMMU_BYPASS_REPLAY_PROOF -sv dmmu.sv
prove: read_verilog -formal -D SYNTHESIS -D DMMU_BYPASS_LOCAL_PROOF -sv dmmu.sv
prove: delete t:dtlb
hierarchy -top dmmu
script free_undefined.ys
prove: setundef -undriven -anyseq
prep -top dmmu
prove: select -assert-count 3 t:$check r:FLAVOR=assert %i
replay: select -assert-count 1 t:$check r:FLAVOR=assert %i
replay: select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dmmu.sv
free_undefined.ys
