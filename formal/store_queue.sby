[tasks]
bmc
cover
bmc_trusted
cover_trusted

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 20
bmc_trusted: mode bmc
bmc_trusted: depth 10
cover_trusted: mode cover
cover_trusted: depth 20

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv vec_hold_rows.sv
read -sv sdp_dist_ram.sv
read -formal -sv sq_forwarding_unit.sv
read -formal -sv store_queue.sv
# The core's settings: allocation trusted to dispatch, cached Normal
# memory, precise uncached stores and Zicbom handed to the hierarchy.
bmc_trusted: chparam -set TRUST_DISPATCH_VALID 1 -set CACHE_NORMAL_MEMORY 1 -set PRECISE_UNCACHED 1 -set CMO_HOME 1 store_queue
cover_trusted: chparam -set TRUST_DISPATCH_VALID 1 -set CACHE_NORMAL_MEMORY 1 -set PRECISE_UNCACHED 1 -set CMO_HOME 1 store_queue
hierarchy -top store_queue
script free_undefined.ys
prep -top store_queue
select -assert-count 83 t:$check r:FLAVOR=assert %i
select -assert-count 29 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_hold_rows.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/store_queue/sq_forwarding_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/store_queue/store_queue.sv
free_undefined.ys
