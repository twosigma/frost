[tasks]
bmc queue
cover queue
bmc_no_prepare_busy queue no_prepare_busy
cover_no_prepare_busy queue no_prepare_busy
bmc_probe_launch queue probe_launch
cover_probe_launch queue probe_launch
prove_pre_match

[options]
# Allowances are about 2.2 times each task's time on a development host
# (formal/README.md); the Load queue CI job holds their sum.
bmc: timeout 1800
bmc_no_prepare_busy: timeout 1800
bmc_probe_launch: timeout 1500
cover: timeout 600
cover_no_prepare_busy: timeout 600
cover_probe_launch: timeout 600
prove_pre_match: timeout 300
bmc: mode bmc
# Limit depth for runtime; the four cached-load slots make the model large.
bmc: depth 10
bmc_no_prepare_busy: mode bmc
bmc_no_prepare_busy: depth 10
cover: mode cover
cover: depth 20
cover_no_prepare_busy: mode cover
cover_no_prepare_busy: depth 20
# Forwarding on, as in the core, and cached loads launched during the probe.
bmc_probe_launch: mode bmc
bmc_probe_launch: depth 10
cover_probe_launch: mode cover
cover_probe_launch: depth 20
prove_pre_match: mode prove
prove_pre_match: depth 3

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv vec_hold_rows.sv
read -sv sdp_dist_ram.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv coherent_l0_flags.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
queue: read -sv coherent_lq_issue_selector.sv
queue: read -sv coherent_lq_candidate_select.sv
queue: read -formal -sv coherent_lq_address_store.sv
queue: read -formal -sv load_queue.sv
prove_pre_match: read -sv coherent_lq_issue_selector.sv
prove_pre_match: read -sv coherent_lq_candidate_select.sv
prove_pre_match: read -formal -sv coherent_lq_address_store.sv
prove_pre_match: read -formal -D F_LQ_PREMATCH_ONLY -sv load_queue.sv
no_prepare_busy: chparam -set PREPARE_LOAD_WHILE_BUSY 0 load_queue
probe_launch: chparam -set PROBE_LAUNCH 1 -set ENABLE_SQ_FORWARD_FAST_PATH 1 load_queue
hierarchy -top load_queue
script free_undefined.ys
prep -top load_queue
prove_pre_match: select -assert-none t:$assume

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_hold_rows.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_candidate_select.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_lq_address_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_l0_flags.sv
free_undefined.ys
