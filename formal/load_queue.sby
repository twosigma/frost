[tasks]
bmc queue
cover queue
bmc_no_prepare_busy queue no_prepare_busy
cover_no_prepare_busy queue no_prepare_busy
prove_pre_match

[options]
bmc: mode bmc
# Depth 10: the four cached-load slots roughly doubled the state, and depth
# 12 grew past the CI per-task ceiling (~15 min on a fast desktop). Every
# counterexample this bench has produced appeared by step 7.
bmc: depth 10
bmc_no_prepare_busy: mode bmc
bmc_no_prepare_busy: depth 10
cover: mode cover
cover: depth 20
cover_no_prepare_busy: mode cover
cover_no_prepare_busy: depth 20
prove_pre_match: mode prove
prove_pre_match: depth 3

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -sv sdp_dist_ram.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
queue: read -formal -sv load_queue.sv
prove_pre_match: read -formal -D F_LQ_PREMATCH_ONLY -sv load_queue.sv
no_prepare_busy: chparam -set PREPARE_LOAD_WHILE_BUSY 0 load_queue
prep -top load_queue
prove_pre_match: select -assert-none t:$assume

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
