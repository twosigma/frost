[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 5
cover: mode cover
cover: depth 8

[engines]
smtbmc boolector

[script]
# Read the adapter without -formal: its own FORMAL assumptions must not
# constrain the harness's arbitrary grant, flush, and payload inputs.
read -sv riscv_pkg.sv fu_cdb_adapter.sv
read -formal -sv mul_completion_tag.sv
prep -top mul_completion_tag

