[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 5
cover: mode cover
cover: depth 8

[engines]
smtbmc boolector

[script]
# Read the adapter without -formal: its own FORMAL assumptions must not
# constrain the harness's arbitrary grant, flush, and payload inputs.
read -sv riscv_pkg.sv fu_cdb_adapter.sv
read -formal -sv mul_completion_tag.sv
hierarchy -top mul_completion_tag
script free_undefined.ys
prep -top mul_completion_tag
select -assert-count 4 t:$check r:FLAVOR=assert %i
select -assert-count 6 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/fu_cdb_adapter/fu_cdb_adapter.sv
mul_completion_tag.sv
free_undefined.ys
