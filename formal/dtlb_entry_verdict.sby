[tasks]
prove
cover
prove_256m
cover_256m

[options]
prove: mode prove
prove: depth 4
prove_256m: mode prove
prove_256m: depth 4
cover: mode cover
cover: depth 8
cover_256m: mode cover
cover_256m: depth 8

[engines]
smtbmc boolector

[script]
prove_256m: verilog_defines -DFROST_DDR_CAPACITY_LOG2_BYTES=28 -DDTLB_256M_NO_ALIAS_PROOF
cover_256m: verilog_defines -DFROST_DDR_CAPACITY_LOG2_BYTES=28 -DDTLB_256M_NO_ALIAS_PROOF
read -sv riscv_pkg.sv
read -formal -D SYNTHESIS -D DTLB_ENTRY_VERDICT_PROOF -sv dtlb.sv
hierarchy -top dtlb
script free_undefined.ys
prep -top dtlb

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
free_undefined.ys
