[tasks]
prove
cover
prove_256m
cover_256m

[options]
prove: mode prove
prove: depth 4
prove_256m: mode prove
prove_256m: depth 4
cover: mode cover
cover: depth 8
cover_256m: mode cover
cover_256m: depth 8

[engines]
smtbmc boolector

[script]
prove_256m: verilog_defines -DFROST_DDR_CAPACITY_LOG2_BYTES=28 -DDTLB_256M_NO_ALIAS_PROOF
cover_256m: verilog_defines -DFROST_DDR_CAPACITY_LOG2_BYTES=28 -DDTLB_256M_NO_ALIAS_PROOF
read -sv riscv_pkg.sv
read -formal -D SYNTHESIS -D DTLB_ENTRY_VERDICT_PROOF -sv dtlb.sv
hierarchy -top dtlb
script free_undefined.ys
prep -top dtlb
prove: select -assert-count 11 t:$check r:FLAVOR=assert %i
cover: select -assert-count 11 t:$check r:FLAVOR=assert %i
prove: select -assert-count 7 t:$check r:FLAVOR=cover %i
cover: select -assert-count 7 t:$check r:FLAVOR=cover %i
prove_256m: select -assert-count 12 t:$check r:FLAVOR=assert %i
cover_256m: select -assert-count 12 t:$check r:FLAVOR=assert %i
prove_256m: select -assert-count 8 t:$check r:FLAVOR=cover %i
cover_256m: select -assert-count 8 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/dtlb.sv
free_undefined.ys
