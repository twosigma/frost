[tasks]
bmc base
cover base
bmc_nopwc base
bmc_replace base
bmc_wide wide
cover_wide wide
bmc_2g noalias
cover_2g noalias

[options]
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 64
bmc_nopwc: mode bmc
bmc_nopwc: depth 16
bmc_replace: mode bmc
bmc_replace: depth 40
bmc_wide: mode bmc
bmc_wide: depth 24
cover_wide: mode cover
cover_wide: depth 64
bmc_2g: mode bmc
bmc_2g: depth 24
cover_2g: mode cover
cover_2g: depth 64

[engines]
smtbmc boolector

[script]
# The wide tasks use a 64 GiB DDR window, whose top 2 GiB has no Svpbmt alias.
base: read -formal -sv riscv_pkg.sv
base: read -formal -sv ptw.sv
wide: read -formal -sv -DFROST_DDR_CAPACITY_LOG2_BYTES=36 riscv_pkg.sv
wide: read -formal -sv -DFROST_DDR_CAPACITY_LOG2_BYTES=36 ptw.sv
noalias: read -formal -sv -DFROST_DDR_CAPACITY_LOG2_BYTES=31 riscv_pkg.sv
noalias: read -formal -sv -DFROST_DDR_CAPACITY_LOG2_BYTES=31 ptw.sv
# A small walk cache (two level-1 and two root entries) reaches fills, hits,
# replacement and discards within the depth; bmc_nopwc checks the walker
# without it.
bmc: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
cover: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
bmc_nopwc: chparam -set PWC_L1_ENTRIES 0 -set PWC_ROOT_ENTRIES 0 ptw
bmc_replace: chparam -set PWC_L1_ENTRIES 1 -set PWC_ROOT_ENTRIES 1 ptw
wide: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
noalias: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
prep -top ptw

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/ptw.sv
