[tasks]
bmc
cover
bmc_nopwc

[options]
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 26
bmc_nopwc: mode bmc
bmc_nopwc: depth 16

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv ptw.sv
# A small walk cache (two level-1 and two root entries) reaches fills, hits,
# replacement and discards within the depth; bmc_nopwc checks the walker
# without it.
bmc: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
cover: chparam -set PWC_L1_ENTRIES 2 -set PWC_ROOT_ENTRIES 2 ptw
bmc_nopwc: chparam -set PWC_L1_ENTRIES 0 -set PWC_ROOT_ENTRIES 0 ptw
prep -top ptw

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/ptw.sv
