[tasks]
bmc
vector_bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv instr_decoder.sv instr_operand_classifier.sv
read -formal -sv instr_operand_classifier_equiv.sv
# bmc is the default build; vector_bmc adds the vector floating-point decode.
vector_bmc: chparam -set VECTOR 1 instr_operand_classifier_equiv
hierarchy -top instr_operand_classifier_equiv
script free_undefined.ys
prep -top instr_operand_classifier_equiv
select -assert-count 26 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/id_stage/instr_decoder.sv
../hw/rtl/cpu_and_mem/cpu/id_stage/instr_operand_classifier.sv
instr_operand_classifier_equiv.sv
free_undefined.ys
