[tasks]
line_link0_bmc
line_link1_bmc
line_link1_four_bmc
line_link1_eight_bmc
line_link1_cover

[options]
~line_link1_cover: mode bmc
line_link0_bmc: depth 16
line_link1_bmc: depth 14
line_link1_four_bmc: depth 12
line_link1_eight_bmc: depth 10
line_link0_bmc: timeout 5280
line_link1_bmc: timeout 4200
line_link1_four_bmc: timeout 4200
line_link1_eight_bmc: timeout 4200
line_link1_cover: mode cover
line_link1_cover: depth 24

[engines]
smtbmc boolector

[script]
read -sv coherence_pkg.sv
read -formal -sv -D COHERENCE_ARBITER_COMPOSED coherence_d_arbiter.sv
read -formal -sv coherence_dma_ingress.sv
read -formal -sv coherence_link.sv
read -formal -sv line_client_link.sv
line_link0_bmc: chparam -set STAGES 0 line_client_link
line_link1_bmc: chparam -set STAGES 1 line_client_link
line_link1_four_bmc: chparam -set STAGES 1 -set IDS 4 line_client_link
line_link1_eight_bmc: chparam -set STAGES 1 -set IDS 8 line_client_link
# The client's own simultaneous-handshake cover needs three live slots.
line_link1_cover: chparam -set STAGES 1 -set IDS 8 line_client_link
hierarchy -top line_client_link
script free_undefined.ys
prep -top line_client_link
memory_map
opt
line_link0_bmc: select -assert-count 131 t:$check r:FLAVOR=assert %i
select -assert-count 7 t:$check r:FLAVOR=cover %i
line_link1_bmc: select -assert-count 137 t:$check r:FLAVOR=assert %i
line_link1_four_bmc: select -assert-count 201 t:$check r:FLAVOR=assert %i
line_link1_eight_bmc: select -assert-count 353 t:$check r:FLAVOR=assert %i
line_link1_cover: select -assert-count 353 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_dma_ingress.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_link.sv
line_client_link.sv
free_undefined.ys
