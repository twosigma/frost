[tasks]
coh_l0_flags_prove flags flags_small
coh_l0_flags256_prove flags
coh_l0_bmc cache bmc small
coh_l0256_bmc cache bmc large
coh_l0_cover cache cover small
coh_l0256_cover cache cover large

[options]
timeout 180
flags: mode prove
flags: depth 1
bmc: mode bmc
bmc: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv sdp_dist_ram.sv
flags: read -formal -sv coherent_l0_flags.sv
flags_small: chparam -set DEPTH 128 coherent_l0_flags
flags: prep -top coherent_l0_flags
cache: read -sv coherent_l0_flags.sv
cache: read -formal -sv -D FROST_COHERENT_CLUSTER lq_l0_cache.sv
cache: chparam -set COHERENT_CLUSTER 1 lq_l0_cache
small: chparam -set DEPTH 128 lq_l0_cache
large: chparam -set DEPTH 256 lq_l0_cache
cache: prep -top lq_l0_cache

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/coherent_l0_flags.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
