[tasks]
csr_twin csr
csr_twin_vector csr vector

[options]
mode bmc
depth 1
timeout 60

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS riscv_pkg.sv csr_file.sv
vector: chparam -set VECTOR 1 -set VLEN 256 csr_file
hierarchy -check -top csr_file
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
~vector: select -assert-count 105 t:$dff
vector: select -assert-count 114 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut csr_file/w:*
select -assert-none csr_file/t:$dff %co:+[Q] csr_file/w:* %i %co1 csr_file/t:* %i
select -assert-count 250 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS riscv_pkg.sv csr_file.sv
vector: chparam -set VECTOR 1 -set VLEN 256 csr_file
hierarchy -check -top csr_file
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
~vector: select -assert-count 105 t:$dff
vector: select -assert-count 114 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut csr_file/w:*
select -assert-none csr_file/t:$dff %co:+[Q] csr_file/w:* %i %co1 csr_file/t:* %i
select -assert-count 250 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists, including declared indices.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
select -assert-count 500 t:$anyseq
select -assert-count 250 t:$anyseq n:*_gold %i
select -assert-count 250 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
csr: select -assert-min 2 @blk
~vector: select -assert-min 14717 t:$equiv
vector: select -assert-min 14949 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/csr/csr_file.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
