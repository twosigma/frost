[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 5
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 5

[engines]
smtbmc boolector

[script]
read_slang --top backing_btb_twin_side --single-unit -DSYNTHESIS riscv_pkg.original.sv backing_btb_twin_pkg.sv backing_btb.original.sv sdp_dist_ram.sv sdp_block_ram.sv backing_btb_twin_side.sv
hierarchy -top backing_btb_twin_side
script free_undefined.ys
prep -top backing_btb_twin_side -flatten
select -assert-none t:$mem_v2
design -stash reference
design -reset
read_slang --top backing_btb_twin_side --single-unit -DSYNTHESIS riscv_pkg.sv backing_btb_twin_pkg.sv backing_btb.sv sdp_dist_ram.sv sdp_block_ram.sv backing_btb_twin_side.sv
hierarchy -top backing_btb_twin_side
script free_undefined.ys
prep -top backing_btb_twin_side -flatten
select -assert-none t:$mem_v2
design -stash candidate
design -reset
read_slang --top backing_btb_twin --single-unit -DSYNTHESIS riscv_pkg.sv backing_btb_twin_pkg.sv backing_btb_twin.sv
design -copy-from reference -as backing_reference backing_btb_twin_side
design -copy-from candidate -as backing_candidate backing_btb_twin_side
hierarchy -check -top backing_btb_twin
script free_undefined.ys
prep -flatten -top backing_btb_twin
select -assert-count 13 t:$check r:FLAVOR=assert %i
select -assert-count 1 t:$check r:FLAVOR=assume %i
select -assert-count 3 t:$check r:FLAVOR=cover %i
bmc: chformal -cover -remove
prove: chformal -cover -remove
cover: chformal -assert -remove

[files]
predictor_reference/riscv_pkg.original.sv
predictor_reference/backing_btb.original.sv
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/backing_btb.sv
predictor_twin_ram/sdp_dist_ram.sv
predictor_twin_ram/sdp_block_ram.sv
backing_btb_twin_pkg.sv
backing_btb_twin_side.sv
backing_btb_twin.sv
free_undefined.ys
