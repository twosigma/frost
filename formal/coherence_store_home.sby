[tasks]
bmc_siblings bmc siblings ordinary first_watch direct_bmc
bmc_siblings_second bmc siblings ordinary second_watch direct_bmc
bmc_rows bmc rows ordinary first_watch direct_bmc
bmc_rows_second bmc rows ordinary second_watch direct_bmc
bmc_conflict bmc conflict deep first_watch direct_bmc
bmc_conflict_second bmc conflict deep second_watch direct_bmc
cover_siblings covers siblings ordinary
cover_rows covers rows ordinary
cover_conflict covers conflict deep compact_covers
bmc_pressure bmc pressure deep first_watch direct_bmc
bmc_pressure_second bmc pressure deep second_watch direct_bmc
cover_pressure covers pressure deep compact_covers
link_bmc_siblings bmc siblings linked ordinary_link first_watch linked_bmc
link_bmc_siblings_second bmc siblings linked ordinary_link second_watch linked_bmc
link_bmc_pressure bmc pressure deep_link linked first_watch
link_bmc_pressure_second bmc pressure deep_link linked second_watch
link_cover_pressure covers pressure deep_link linked compact_covers

[options]
bmc: mode bmc
covers: mode cover
covers: vcd_sim on
ordinary: depth 240
deep: depth 360
ordinary_link: depth 300
deep_link: depth 420
cover_conflict: depth 233
cover_pressure: depth 235
link_cover_pressure: depth 250
timeout 2400
compact_covers: timeout 900
bmc: timeout 900
bmc: aigsmt boolector

[engines]
direct_bmc: abc bmc3
linked_bmc: abc bmc3 -c
link_bmc_pressure: abc bmc3
link_bmc_pressure_second: abc bmc3
covers: btor btormc

[script]
read -sv coherence_read_stream.sv
read -sv cache_perf_pkg.sv coherence_pkg.sv coherence_request_endpoint.sv coherence_home_endpoint.sv coherence_put_endpoint.sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv coherence_grant_select.sv coherence_read_select.sv coherence_read_payload.sv coherence_store_buffer.sv coherence_array.sv coherence_l1d.sv coherence_home_array.sv coherence_seat_select.sv coherence_work_select.sv coherence_home_completions.sv coherence_home_engine.sv coherence_home.sv coherence_d_arbiter.sv coherence_dma_ingress.sv coherence_cmo_agent.sv coherence_cluster_test_harness.sv sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv
# The links' own checks (always-taken receivers take every message,
# mirrored offers hold until their handshake returns, credit counts) are
# simulation checks, which a formal read keeps.
read -formal -sv coherence_link.sv
read -formal -sv coherence_store_home_formal.sv
rows: chparam -set SECTOR_CASE 1 coherence_store_home_formal
conflict: chparam -set SECTOR_CASE 2 coherence_store_home_formal
pressure: chparam -set PRESSURE 1 coherence_store_home_formal
covers: chparam -set COVER_MODE 1 coherence_store_home_formal
linked: chparam -set LINK_STAGES 1 coherence_store_home_formal
hierarchy -top coherence_store_home_formal
script free_undefined.ys
prep -flatten -top coherence_store_home_formal
check -assert
# Partition only the one-bit constant watch choice; both byte values stay arbitrary.
bmc: select -module coherence_store_home_formal
bmc: select -assert-count 3 t:$anyconst
bmc: select -set watch_choice w:watch_second %ci* t:$anyconst %i
bmc: select -assert-count 1 @watch_choice
bmc: select -assert-count 1 t:$anyconst r:WIDTH=1 %i
bmc: delete @watch_choice
first_watch: connect -nomap -set watch_second 1'b0
second_watch: connect -nomap -set watch_second 1'b1
bmc: select -assert-count 2 t:$anyconst r:WIDTH=8 %i
bmc: select -assert-none t:$anyconst r:WIDTH=1 %i
bmc: select -clear
memory_map -keepdc
opt -keepdc
# Canonicalize packed word selections in the bounded checks.
bmc: peepopt
bmc: techmap
bmc: opt -fast -keepdc
bmc: select -assert-none t:$check r:FLAVOR=assume %i
bmc: select -assert-none t:$assume
bmc: select -clear
bmc_siblings: select -assert-count 16 t:$check r:FLAVOR=assert %i
bmc_siblings_second: select -assert-count 16 t:$check r:FLAVOR=assert %i
bmc_rows: select -assert-count 16 t:$check r:FLAVOR=assert %i
bmc_rows_second: select -assert-count 16 t:$check r:FLAVOR=assert %i
bmc_conflict: select -assert-count 17 t:$check r:FLAVOR=assert %i
bmc_conflict_second: select -assert-count 17 t:$check r:FLAVOR=assert %i
bmc_pressure: select -assert-count 16 t:$check r:FLAVOR=assert %i
bmc_pressure_second: select -assert-count 16 t:$check r:FLAVOR=assert %i
link_bmc_siblings: select -assert-count 33 t:$check r:FLAVOR=assert %i
link_bmc_siblings_second: select -assert-count 33 t:$check r:FLAVOR=assert %i
link_bmc_pressure: select -assert-count 33 t:$check r:FLAVOR=assert %i
link_bmc_pressure_second: select -assert-count 33 t:$check r:FLAVOR=assert %i
# Optimize the cover and its assumptions before undefined bits become inputs.
# The optimizations keep the unknown starting values of registers and
# memories (-full would resolve undefined multiplexer inputs); -fine and the
# merging steps can fuse undefined constants, and abc reads an undefined
# constant as zero. For a cover such narrowing cannot create a witness.
compact_covers: chformal -assert -remove
compact_covers: setattr -unset keep
compact_covers: techmap
compact_covers: opt -fast -keepdc
compact_covers: abc
compact_covers: opt -keepdc -mux_bool -fine
compact_covers: setundef -undriven -anyseq
compact_covers: select -assert-count 1 t:$check r:FLAVOR=cover %i
compact_covers: select -assert-count 1 t:$check r:FLAVOR=assume %i
compact_covers: select -clear
setundef -anyseq
opt_clean
check -assert
cover_siblings: select -assert-count 16 t:$check r:FLAVOR=assert %i
cover_rows: select -assert-count 16 t:$check r:FLAVOR=assert %i
cover_siblings: select -assert-count 1 t:$check r:FLAVOR=cover %i
cover_rows: select -assert-count 1 t:$check r:FLAVOR=cover %i

