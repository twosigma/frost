[tasks]
pf_agent64_prove wide safety
pf_agent32_prove narrow safety
pf_agent1_prove wide single safety
pf_agent2_prove wide pair safety
pf_agent4_prove wide full safety
pf_agent64_cover wide reach
pf_agent32_cover narrow reach

[options]
safety: mode prove
safety: depth 12
reach: mode cover
reach: depth 40

[engines]
smtbmc boolector

[script]
read -define COHERENCE_ARBITER_COMPOSED
read -formal -sv coherence_pkg.sv coherence_d_arbiter.sv coherence_request_endpoint.sv l2_stream_prefetcher.sv coherence_prefetch_agent.sv
narrow: chparam -set L2_LINE_BYTES 32 coherence_prefetch_agent
single: chparam -set MAX_INFLIGHT 1 coherence_prefetch_agent
pair: chparam -set MAX_INFLIGHT 2 coherence_prefetch_agent
full: chparam -set MAX_INFLIGHT 4 -set IF_STREAMS 0 coherence_prefetch_agent
prep -top coherence_prefetch_agent
memory_map
opt_clean

[files]
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_request_endpoint.sv
../hw/rtl/lib/cache/l2_stream_prefetcher.sv
../hw/rtl/lib/cache/coherence_prefetch_agent.sv
