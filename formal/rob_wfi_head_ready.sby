[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
prove: timeout 90
cover: mode cover
cover: depth 8
cover: timeout 90

[engines]
smtbmc boolector

[script]
read_slang --top reorder_buffer --single-unit -DSYNTHESIS riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rob_link_value_ram.sv rob_serializer.sv sfence_operand_store.sv reorder_buffer.sv rob_wfi_head_ready_formal.sv
hierarchy -top reorder_buffer
script free_undefined.ys
setattr -unset keep
delete -output w:*
prep -top reorder_buffer -flatten
select -assert-count 5 t:$check r:FLAVOR=assert %i
select -assert-count 4 t:$check r:FLAVOR=assume %i
select -assert-count 2 t:$check r:FLAVOR=cover %i
prove: chformal -cover -remove
cover: chformal -assert -remove

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_link_value_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/sfence_operand_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
rob_wfi_head_ready_formal.sv
free_undefined.ys
