[tasks]
bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read -formal -D SYNTHESIS -D ROB_RETIRE_STALL_LOCAL_PROOF -sv rob_serializer.sv reorder_buffer.sv
hierarchy -top reorder_buffer
delete t:sdp_dist_ram t:mwp_dist_ram t:mwp_dist_ram_ohread
proc
setundef -undriven -anyseq
opt
prep -top reorder_buffer -flatten
select -assert-count 13 t:$check r:FLAVOR=assert %i
select -assert-none t:$assume a:init
select -assert-none t:$check r:FLAVOR=assume %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
