[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
# Under FORMAL the shim replaces fp_engine with a model that completes an
# arbitrary number of cycles after its start, so fp_engine.sv is not read.
read -formal -sv fp_shim.sv
prep -top fp_shim

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/fu_shims/fp_shim.sv
