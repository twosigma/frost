[tasks]
bmc
bmc_line32
bmc_xilinx

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
# The engine's line-image byte enables and DMA selects, formed for both
# values of the write-ack ready and selected by it last, equal the original
# ordered writes for any register state and input.
read -sv -D SYNTHESIS cache_perf_pkg.sv coherence_pkg.sv
bmc_xilinx: read_verilog -formal +/xilinx/cells_sim.v
bmc_xilinx: read -formal -sv -D SYNTHESIS -D FROST_XILINX_PRIMS -D ENGINE_IMAGE_NEXT_LOCAL_PROOF coherence_home_engine.sv
~bmc_xilinx: read -formal -sv -D SYNTHESIS -D ENGINE_IMAGE_NEXT_LOCAL_PROOF coherence_home_engine.sv
bmc_line32: chparam -set LINE_BYTES 32 coherence_home_engine
prep -top coherence_home_engine
select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 1 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_home_engine.sv
../hw/rtl/lib/cache/cache_perf_pkg.sv
