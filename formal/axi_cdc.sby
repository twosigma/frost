[tasks]
prove_aw prf
prove_w prf
prove_b prf
prove_ar prf
prove_r prf
cover

[options]
multiclock on
prf: mode prove
prf: depth 3
cover: mode cover
cover: depth 60

[engines]
smtbmc boolector

[script]
prove_aw: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=1 -GCOVER_MODE=0 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
prove_w: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=2 -GCOVER_MODE=0 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
prove_b: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=4 -GCOVER_MODE=0 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
prove_ar: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=8 -GCOVER_MODE=0 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
prove_r: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=16 -GCOVER_MODE=0 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
cover: read_slang --top axi_cdc_formal --single-unit -GCHECK_MASK=31 -GCOVER_MODE=1 cdc_sync.sv cdc_reset_sync.sv cdc_reset_pair.sv sdp_block_ram_dc.sv async_fifo.sv axi_cdc.sv axi_cdc_formal.sv
hierarchy -top axi_cdc_formal
script free_undefined.ys
prep -top axi_cdc_formal -flatten
dffunmap w:gclk %co
formalff -clk2ff w:gclk %co
~cover: chformal -cover -remove
cover: chformal -assert -remove
memory_map
opt -full
opt_clean -purge

[files]
../hw/rtl/lib/cdc/cdc_sync.sv
../hw/rtl/lib/cdc/cdc_reset_sync.sv
../hw/rtl/lib/cdc/cdc_reset_pair.sv
../hw/rtl/lib/ram/sdp_block_ram_dc.sv
../hw/rtl/lib/fifo/async_fifo.sv
../hw/rtl/lib/axi/axi_cdc.sv
axi_cdc_formal.sv
free_undefined.ys
