[tasks]
bp_twin bp

[options]
mode bmc
depth 1
timeout 900

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS riscv_pkg.sv sdp_dist_ram.sv sdp_block_ram.sv backing_btb.sv branch_predictor.sv direction_predictor.sv tage_predictor.sv return_address_stack.sv
hierarchy -check -top branch_predictor
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 3840 a:init
select -assert-none i:* o:* %i
select -assert-count 4882 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut branch_predictor/w:*
select -assert-none branch_predictor/t:$dff %co:+[Q] branch_predictor/w:* %i %co1 branch_predictor/t:* %i
select -assert-count 60 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS riscv_pkg.sv sdp_dist_ram.sv sdp_block_ram.sv backing_btb.sv branch_predictor.sv direction_predictor.sv tage_predictor.sv return_address_stack.sv
hierarchy -check -top branch_predictor
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 3840 a:init
select -assert-none i:* o:* %i
select -assert-count 4882 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut branch_predictor/w:*
select -assert-none branch_predictor/t:$dff %co:+[Q] branch_predictor/w:* %i %co1 branch_predictor/t:* %i
select -assert-count 60 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -delete gold
design -copy-from gate -as gate gate
design -delete gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists and matching initial values.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
bp_twin: select -assert-count 124 t:$anyseq
select -assert-count 60 t:$anyseq n:*_gold %i
select -assert-count 60 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
bp_twin: select -assert-min 220 @blk
bp_twin: select -assert-min 126988 t:$equiv
equiv_struct -icells
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/sdp_block_ram.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/backing_btb.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/branch_predictor.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/direction_predictor.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/tage_predictor.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/return_address_stack.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
