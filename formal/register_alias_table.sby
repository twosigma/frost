[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 6
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv register_alias_table.sv
hierarchy -top register_alias_table
script free_undefined.ys
prep -top register_alias_table
select -assert-count 20 t:$check r:FLAVOR=assert %i
select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/register_alias_table/register_alias_table.sv
free_undefined.ys
