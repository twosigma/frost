[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 5
cover: mode cover
cover: depth 8

[engines]
smtbmc boolector

[script]
read_slang --top ras_flush_checkpoint_formal --single-unit -D SYNTHESIS riscv_pkg.sv sdp_dist_ram.sv ras_flush_checkpoint.sv ras_flush_checkpoint_formal.sv
hierarchy -top ras_flush_checkpoint_formal
script free_undefined.ys
prep -top ras_flush_checkpoint_formal -flatten
select -assert-count 3 t:$check r:FLAVOR=assert %i
select -assert-count 5 t:$check r:FLAVOR=cover %i
select -assert-none t:$assume
select -assert-none t:$check r:FLAVOR=assume %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/cpu_ooo/branch_recovery/ras_flush_checkpoint.sv
ras_flush_checkpoint_formal.sv
free_undefined.ys
