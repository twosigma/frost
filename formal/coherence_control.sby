[tasks]
coh_atomic_select_prove arm_select
coh_atomic_select_wide_prove arm_select arm_select_wide
coh_atomic_pair_prove arm_pair
coh_atomic_pair_wide_prove arm_pair arm_pair_wide
coh_c_payload_prove payload
coh_c_payload_wide_prove payload payload_wide
coh_arbiter_prove arbiter
coh_arbiter19_prove arbiter large_arbiter
coh_arbiter_held_prove arbiter large_arbiter held_arbiter
coh_reader_prove reader early
coh_reader_cover reader early covers
coh_reader_slot1_prove reader early slot1
coh_reader_slot1_cover reader early slot1 covers
coh_ptw_reader_prove reader early ptw
coh_ptw_reader_cover reader early ptw covers
coh_reader_late_prove reader
coh_ingress_prove reader dma
coh_atomic_guard_prove guard
coh_read_flags_prove flags
coh_read_select_prove select
coh_read_select64_prove select wide
coh_grant_select2_prove grant_select grant2
coh_grant_select4_prove grant_select grant4
coh_grant_select8_prove grant_select
coh_read_owners1_prove owners owners1
coh_read_owners3_prove owners owners3
coh_read_owners4_prove owners owners4
coh_read_owners8_prove owners owners8
coh_miss_credit1_prove credit credit1
coh_miss_credit3_prove credit credit3
coh_miss_credit4_prove credit credit4
coh_miss_credit8_prove credit credit8

[options]
mode prove
arm_select: depth 1
arm_pair: depth 4
arm_select: timeout 180
arm_pair: timeout 180
arbiter: depth 12
large_arbiter: timeout 180
reader: depth 12
covers: mode cover
covers: depth 20
guard: depth 12
flags: depth 12
select: depth 1
payload: depth 1
select: timeout 180
grant_select: depth 1
grant_select: timeout 180
owners: depth 1
owners: timeout 180
credit: depth 1
credit: timeout 180

[engines]
smtbmc boolector

[script]
arm_select: read -formal -sv coherent_atomic_select.sv
arm_pair: read -formal -sv coherent_atomic_select.sv coherent_atomic_select_formal.sv
arm_select_wide: chparam -set TAG_BITS 9 coherent_atomic_select
arm_pair_wide: chparam -set TAG_BITS 9 coherent_atomic_select_formal
read -formal -sv coherence_c_payload.sv coherence_pkg.sv coherence_d_arbiter.sv coherence_line_bridge.sv coherent_atomic_guard.sv coherence_read_flags.sv coherence_read_select.sv
arm_select: prep -top coherent_atomic_select
arm_pair: prep -flatten -top coherent_atomic_select_formal
payload_wide: chparam -set WIDTH 74 coherence_c_payload
payload: prep -top coherence_c_payload
arbiter: chparam -set WIDTH 12 -set PORTS 3 coherence_d_arbiter
large_arbiter: chparam -set PORTS 19 coherence_d_arbiter
held_arbiter: chparam -set HOLD_VALID 1 coherence_d_arbiter
arbiter: prep -top coherence_d_arbiter
dma: chparam -set SOURCE 2 -set PORT_CLASS 3 -set ID_BITS 4 coherence_line_bridge
early: chparam -set EARLY_RESPONSE 1 coherence_line_bridge
slot1: chparam -set SLOT 1 coherence_line_bridge
ptw: chparam -set PORT_CLASS 2 coherence_line_bridge
reader: prep -top coherence_line_bridge
guard: prep -top coherent_atomic_guard
flags: prep -top coherence_read_flags
wide: chparam -set ADDR_WIDTH 64 coherence_read_select
select: prep -top coherence_read_select
grant_select: read -formal -sv coherence_grant_select.sv
grant2: chparam -set SLOTS 2 coherence_grant_select
grant4: chparam -set SLOTS 4 coherence_grant_select
grant_select: prep -top coherence_grant_select
owners: read -formal -sv coherence_read_owners.sv
owners1: chparam -set SLOTS 1 coherence_read_owners
owners3: chparam -set SLOTS 3 coherence_read_owners
owners4: chparam -set SLOTS 4 coherence_read_owners
owners8: chparam -set SLOTS 8 coherence_read_owners
owners: prep -top coherence_read_owners
credit: read -formal -sv coherence_miss_credit.sv
credit1: chparam -set SLOTS 1 coherence_miss_credit
credit3: chparam -set SLOTS 3 coherence_miss_credit
credit4: chparam -set SLOTS 4 coherence_miss_credit
credit8: chparam -set SLOTS 8 coherence_miss_credit
credit: prep -top coherence_miss_credit

[files]
coherent_atomic_select_formal.sv
../hw/rtl/cpu_and_mem/cpu/cpu_ooo/memory_if/coherent_atomic_select.sv
../hw/rtl/lib/cache/coherence_c_payload.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_line_bridge.sv
../hw/rtl/cpu_and_mem/cpu/cpu_ooo/memory_if/coherent_atomic_guard.sv
../hw/rtl/lib/cache/coherence_read_flags.sv
../hw/rtl/lib/cache/coherence_read_select.sv
../hw/rtl/lib/cache/coherence_grant_select.sv
../hw/rtl/lib/cache/coherence_read_owners.sv
../hw/rtl/lib/cache/coherence_miss_credit.sv
