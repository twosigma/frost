[tasks]
bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv -D SC_HEAD_QUERY_LOCAL_PROOF sc_pending_unit.sv
prep -top sc_pending_unit -flatten
select -assert-count 1 t:$check
select -assert-none t:$assume a:init
write_json prepared_model.json

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/tomasulo_wrapper/atomics/sc_pending_unit.sv
