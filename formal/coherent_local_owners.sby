[tasks]
prove
cover

[options]
prove: mode prove
prove: aigsmt boolector
cover: mode cover
depth 24
timeout 120

[engines]
prove: abc pdr
cover: smtbmc boolector

[script]
read -formal -sv coherent_local_owners_formal.sv
hierarchy -top coherent_local_owners_formal
script free_undefined.ys
prep -top coherent_local_owners_formal
select -assert-count 9 t:$check r:FLAVOR=assert %i
select -assert-count 6 t:$check r:FLAVOR=cover %i

[files]
coherent_local_owners_formal.sv
free_undefined.ys
