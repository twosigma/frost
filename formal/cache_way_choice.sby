[tasks]
bmc
bmc_ways1
bmc_delayed

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv cache_perf_pkg.sv sdp_block_ram.sv sdp_ram_byte_en.sv sdp_packed_tag_uram.sv
read -formal -D SYNTHESIS -D CACHE_WAY_PROOF -sv frost_cache.sv
bmc: chparam -set CACHE_SIZE_BYTES 256 -set LINE_BYTES 8 -set WAYS 4 -set NUM_PROBE 2 frost_cache
bmc_ways1: chparam -set CACHE_SIZE_BYTES 256 -set LINE_BYTES 8 -set WAYS 1 -set NUM_PROBE 2 frost_cache
bmc_delayed: chparam -set CACHE_SIZE_BYTES 256 -set LINE_BYTES 8 -set WAYS 4 -set TAG_MEMORY_PRIMITIVE "ultra" -set TAG_READ_LATENCY 3 -set DATA_MEMORY_PRIMITIVE "ultra" -set DATA_READ_LATENCY 6 -set DATA_WRITE_LATENCY 2 frost_cache
prep -top frost_cache -flatten
memory_map
opt
select -assert-none t:$assume
bmc: select -assert-count 6 t:$check
bmc_ways1: select -assert-count 3 t:$check
bmc_delayed: select -assert-count 6 t:$check

[files]
../hw/rtl/lib/cache/cache_perf_pkg.sv
../hw/rtl/lib/cache/frost_cache.sv

../hw/rtl/lib/ram/sdp_block_ram.sv
../hw/rtl/lib/ram/sdp_ram_byte_en.sv
../hw/rtl/lib/ram/sdp_packed_tag_uram.sv
