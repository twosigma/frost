[tasks]
capture_pins_prove portable
capture_pins_xilinx_prove xilinx

[options]
mode prove
depth 2

[engines]
abc pdr

[script]
read -sv riscv_pkg.sv
xilinx: read_verilog -formal +/xilinx/cells_sim.v
portable: read -sv -D SYNTHESIS load_queue.sv
xilinx: read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS load_queue.sv
read -formal -sv lq_capture_pins.sv
prep -top lq_capture_pins -flatten
select -assert-count 8 t:$check r:FLAVOR=assert %i
select -assert-none t:$assume t:$*ff* t:$*latch* t:$sr t:$mem* a:init
select -assert-none t:$check r:FLAVOR=assume %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
lq_capture_pins.sv
