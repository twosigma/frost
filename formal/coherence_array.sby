[tasks]
coh_array_bmc bram bounded
coh_array_uram_bmc uram bounded
coh_array4_bmc bram bounded four undefined fourbram
coh_array4_uram_bmc uram bounded four undefined
coh_array_port_bmc bram bounded port
coh_array4_port_bmc bram bounded four undefined port fourbram fourport
coh_array_cover bram covers
coh_array_uram_cover uram covers
coh_array4_port_cover bram covers four port

coh_array_select_prove selection
coh_array_select4_prove selection four
coh_array_select56_prove selection wide
coh_array_select4_56_prove selection four wide

[options]
bounded: mode bmc
covers: mode cover
selection: mode prove
~selection: depth 32
selection: depth 2
# Four-way block RAM frames take about 1.35 times longer than the one before.
fourbram: depth 24
timeout 180
bounded: timeout 1200
four: timeout 1800
port: timeout 1800
# The four-way hit-port BMC takes about 50 minutes for its 24 frames and
# has twice that; CI runs it beside the free-input L1D stream BMC.
fourport: timeout 6000
bounded: aigsmt boolector

[engines]
bounded: abc bmc3
covers: smtbmc boolector
selection: smtbmc boolector

[script]
read -formal -sv sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv
chparam -set CACHE_BYTES 64 -set WAYS 1 coherence_array
uram: chparam -set ULTRA 1 coherence_array
four: chparam -set CACHE_BYTES 256 -set WAYS 4 coherence_array
wide: chparam -set ADDR_WIDTH 56 coherence_array
port: chparam -set HIT_PORT 1 coherence_array
~selection: prep -top coherence_array
# Out-of-range bits of the four-way selections are unreachable constants.
undefined: memory_map
undefined: opt
undefined: techmap
undefined: opt -fast
undefined: setundef -anyseq
undefined: opt_clean
selection: hierarchy -check -top coherence_array
selection: proc -noopt
selection: flatten
selection: opt_expr -keepdc -noclkinv
selection: select -assert-count 1 c:p_data_select_exact t:$check %i r:FLAVOR=assert %i
selection: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_data_select_exact %d
selection: chformal -assume -remove
selection: chformal -cover -remove
selection: memory_map
selection: select -assert-min 1 t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
selection: cutpoint t:$dff t:$dffe t:$adff t:$adffe t:$sdff t:$sdffe t:$ff
selection: select -assert-none t:*ff* t:*FF* t:*latch*
selection: setattr -unset init w:*
selection: delete -output w:*
selection: opt_clean
selection: opt
selection: chformal -lower
selection: select -assert-count 1 t:$assert
selection: select -assert-none t:$assume
selection: sat -prove-asserts -verify -timeout 60

[files]
../hw/rtl/lib/ram/sdp_block_ram.sv
../hw/rtl/lib/ram/sdp_packed_tag_uram.sv
../hw/rtl/lib/ram/sdp_ram_byte_en.sv
../hw/rtl/lib/cache/coherence_array.sv
