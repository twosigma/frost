[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 1

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv alu.sv
read -formal -sv alu_shift_hint.sv
hierarchy -top alu_shift_hint
script free_undefined.ys
prep -top alu_shift_hint
select -assert-count 52 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/ex_stage/alu/alu.sv
alu_shift_hint.sv
free_undefined.ys
