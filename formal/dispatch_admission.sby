[tasks]
bmc
bmc_queued

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read_verilog -formal -D SYNTHESIS -D DISPATCH_ADMISSION_LOCAL_PROOF -sv dispatch.sv
bmc_queued: chparam -set SLOT2_VALID_FROM_BUNDLE 1 dispatch
prep -top dispatch

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/dispatch/dispatch.sv
