[tasks]
bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv
read_verilog -formal -D SYNTHESIS -D UNCACHED_READ_CAPTURE_LOCAL_PROOF -sv cpu_uncached_adapter.sv
prep -top cpu_uncached_adapter -flatten
select -assert-count 1 t:$check
select -assert-none t:$assume a:init

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_top/cpu_uncached_adapter.sv
