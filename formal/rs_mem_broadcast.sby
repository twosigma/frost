[tasks]
prove proof
prove_prims proof
cover

[options]
proof: mode prove
proof: depth 2
proof: timeout 300
cover: mode cover
cover: depth 8
cover: timeout 90

[engines]
smtbmc boolector

[script]
prove: read_slang --top rs_mem_broadcast_formal --single-unit riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv coherent_rs_capacity.sv coherent_rs_issue2_selector.sv coherent_rs_payload_store.sv reservation_station.sv rs_mem_broadcast_formal.sv
prove_prims: read_slang --top rs_mem_broadcast_formal --single-unit -DFROST_XILINX_PRIMS xilinx_primitives.sv riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv coherent_rs_capacity.sv coherent_rs_issue2_selector.sv coherent_rs_payload_store.sv reservation_station.sv rs_mem_broadcast_formal.sv
cover: read_slang --top rs_mem_broadcast_formal --single-unit -GCOVER_TRACES=1 riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv coherent_rs_capacity.sv coherent_rs_issue2_selector.sv coherent_rs_payload_store.sv reservation_station.sv rs_mem_broadcast_formal.sv
# Slang reads the parameterized primitive pins. Replace their declarations
# with the Yosys LUT models before specializing the INITs and flattening.
prove_prims: read_verilog -formal +/xilinx/cells_sim.v
hierarchy -top rs_mem_broadcast_formal
script free_undefined.ys
prep -top rs_mem_broadcast_formal -flatten
proof: memory_map -keepdc
proof: opt -keepdc
select -assert-count 34 t:$check r:FLAVOR=assert %i
cover: select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../tests/slang/xilinx_primitives.sv
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/coherent_rs_capacity.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/coherent_rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/coherent_rs_payload_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
rs_mem_broadcast_formal.sv
free_undefined.ys
