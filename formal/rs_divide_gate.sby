[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 10

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv rs_issue2_selector.sv
read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -D RS_DIVIDE_GATE_LOCAL_PROOF -sv reservation_station.sv
# Exercise the MUL station's divide gate.
chparam -set DEPTH 4 -set HAS_SRC3 0 -set DISPATCH_REPAIR_BYPASS 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set SPECULATIVE_DATA_WRITES 1 -set DIVIDE_ISSUE_GATE 1 reservation_station
hierarchy -top reservation_station
# The gate proof holds whatever the payload RAMs return, initial contents included.
delete t:sdp_dist_ram t:mwp_dist_ram t:mwp_dist_ram_ohread
proc
setundef -undriven -anyseq
# Drop output ports so opt can prune logic unused by the properties.
delete -port reservation_station/o:*
opt_clean -purge
opt
prep -top reservation_station -flatten
select -assert-count 3 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
