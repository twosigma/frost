[tasks]
bmc
cover

[options]
bmc: mode bmc
# Depth 6 reaches a commit-time recovery from a mispredicted branch and a
# checked commit after it; each further step adds much more solver time.
bmc: depth 6
# Allow an hour for the bounded check on slower CI runners.
bmc: timeout 3600
cover: mode cover
cover: depth 14
cover: timeout 300

[engines]
bmc: btor btormc
cover: smtbmc boolector

[script]
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv riscv_pkg.sv
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv sdp_dist_ram.sv
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv mwp_dist_ram.sv
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv mwp_dist_ram_ohread.sv
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv rob_serializer.sv sfence_operand_store.sv
read -formal -D ROB_RETIRE_SUCCESSOR_PROOF -sv reorder_buffer.sv
hierarchy -top reorder_buffer
script free_undefined.ys
# Keep the module's dispatch, CDB and flush assumptions; check only the
# successor properties (bmc) or reach only their covers (cover).
bmc: chformal -assert -remove t:$check r:FLAVOR=assert %i c:p_retire_successor c:p_retire_successor_slot2 c:p_retire_successor_barrier %u %u %d
bmc: chformal -cover -remove
cover: chformal -assert -remove
cover: chformal -cover -remove t:$check r:FLAVOR=cover %i c:p_retire_successor_cover_* %d
delete -port reorder_buffer/o:*
prep -top reorder_buffer
bmc: select -assert-count 3 t:$check r:FLAVOR=assert %i
cover: select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/rob_serializer.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/sfence_operand_store.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reorder_buffer/reorder_buffer.sv
free_undefined.ys
