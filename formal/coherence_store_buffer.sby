[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
prove: depth 4
cover: depth 16
timeout 2400

[engines]
smtbmc boolector

[script]
read -formal -sv coherence_store_buffer.sv
chparam -set ADDR_WIDTH 8 -set TAG_BITS 2 -set EP_BITS 2 coherence_store_buffer
prep -top coherence_store_buffer

[files]
../hw/rtl/lib/cache/coherence_store_buffer.sv
