[tasks]
bmc

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv rvc_decompressor.sv
read -formal -sv rvc_predecode_equiv.sv
hierarchy -top rvc_predecode_equiv
script free_undefined.ys
prep -top rvc_predecode_equiv
select -assert-count 8 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/c_extension/rvc_decompressor.sv
rvc_predecode_equiv.sv
free_undefined.ys
