[tasks]
home_engine_twin32 narrow
home_engine_twin64 wide
home_engine_twin40 addr40

[options]
mode bmc
depth 1
timeout 240

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS coherence_pkg.sv coherence_home_engine.sv
chparam -set LINE_BYTES 32 -set WAYS 1 coherence_home_engine
wide: chparam -set LINE_BYTES 64 coherence_home_engine
addr40: chparam -set ADDR_WIDTH 40 coherence_home_engine
hierarchy -check -top coherence_home_engine
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 16 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut coherence_home_engine/w:*
select -assert-none coherence_home_engine/t:$dff %co:+[Q] coherence_home_engine/w:* %i %co1 coherence_home_engine/t:* %i
~wide: select -assert-count 144 t:$anyseq
wide: select -assert-count 149 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS coherence_pkg.sv coherence_home_engine.sv
chparam -set LINE_BYTES 32 -set WAYS 1 coherence_home_engine
wide: chparam -set LINE_BYTES 64 coherence_home_engine
addr40: chparam -set ADDR_WIDTH 40 coherence_home_engine
hierarchy -check -top coherence_home_engine
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 16 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut coherence_home_engine/w:*
select -assert-none coherence_home_engine/t:$dff %co:+[Q] coherence_home_engine/w:* %i %co1 coherence_home_engine/t:* %i
~wide: select -assert-count 144 t:$anyseq
wide: select -assert-count 149 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists, including declared indices.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
~wide: select -assert-count 288 t:$anyseq
~wide: select -assert-count 144 t:$anyseq n:*_gold %i
~wide: select -assert-count 144 t:$anyseq n:*_gate %i
wide: select -assert-count 298 t:$anyseq
wide: select -assert-count 149 t:$anyseq n:*_gold %i
wide: select -assert-count 149 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
select -assert-min 1 @blk
home_engine_twin32: select -assert-min 2751 t:$equiv
home_engine_twin64: select -assert-min 3295 t:$equiv
home_engine_twin40: select -assert-min 2840 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_home_engine.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
