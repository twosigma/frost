[tasks]
prove prove_mode equal
cover cover_mode equal
bmc_unequal bmc_mode unequal
cover_unequal cover_mode unequal

[options]
prove_mode: mode prove
prove_mode: depth 1
# The first training write can come in step 1 (train_valid_q starts at 0),
# from any table contents and any training registers; step 2 checks it.
bmc_mode: mode bmc
bmc_mode: depth 3
cover_mode: mode cover
cover_mode: depth 4

[engines]
smtbmc boolector

[script]
equal: read_slang --top tage_copy_convergence_formal --single-unit -GEQUAL_START=1 riscv_pkg.sv sdp_dist_ram.sv tage_predictor.sv tage_copy_convergence_formal.sv
unequal: read_slang --top tage_copy_convergence_formal --single-unit -GEQUAL_START=0 riscv_pkg.sv sdp_dist_ram.sv tage_predictor.sv tage_copy_convergence_formal.sv
hierarchy -top tage_copy_convergence_formal
script free_undefined.ys
prep -top tage_copy_convergence_formal -flatten
prove_mode: chformal -cover -remove
bmc_mode: chformal -cover -remove
cover_mode: chformal -assert -remove
# The two copies of a bank have the same write port, so a plain opt_merge
# would fold each lookup-copy word into its training-copy word and the model
# could not hold copies that differ. opt passes -keepdc to opt_expr and
# opt_dff only, so the passes run one by one.
memory_map -keepdc
# Table contents start arbitrary: sdp_dist_ram's zero initializer, which the
# FPGA image and simulations without random power-up start from, is removed.
# Each task constrains only the watched entry.
setattr -unset init w:*_copy.ram*
opt_expr -keepdc
opt_merge -keepdc
opt_clean -purge

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/branch_prediction/tage_predictor.sv
tage_copy_convergence_formal.sv
free_undefined.ys
