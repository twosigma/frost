# Merged-valid candidate tags and exported ready-vector equivalence.
[tasks]
bmc
bmc_tag_indexed
bmc_export
bmc_export_tag_indexed
bmc_ready_vector

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rs_issue2_selector.sv
~bmc_ready_vector: read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -sv reservation_station.sv
bmc_ready_vector: read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -D RS_PRETAG_READY_VECTOR_PROOF -sv reservation_station.sv
bmc: chparam -set PREISSUE_VALID_COFACTOR 1 -set HAS_SRC3 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set DISPATCH_REPAIR_BYPASS 0 reservation_station
bmc_tag_indexed: chparam -set PREISSUE_VALID_COFACTOR 1 -set ISSUE_CDB_TAG_SHADOW 1 -set ISSUE_CDB_META_ANCHORS 1 reservation_station
bmc_export: chparam -set PREISSUE_READY_EXPORT 1 -set PREISSUE_VALID_COFACTOR 1 -set HAS_SRC3 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set DISPATCH_REPAIR_BYPASS 0 reservation_station
bmc_ready_vector: chparam -set PREISSUE_READY_EXPORT 1 -set PREISSUE_VALID_COFACTOR 1 -set HAS_SRC3 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set DISPATCH_REPAIR_BYPASS 0 reservation_station
bmc_export_tag_indexed: chparam -set PREISSUE_READY_EXPORT 1 -set PREISSUE_VALID_COFACTOR 1 -set ISSUE_CDB_TAG_SHADOW 1 -set ISSUE_CDB_META_ANCHORS 1 reservation_station
prep -top reservation_station
select -assert-none t:$assume
bmc: select -assert-count 1 t:$check
bmc_tag_indexed: select -assert-count 1 t:$check
bmc_export: select -assert-count 7 t:$check
bmc_export_tag_indexed: select -assert-count 7 t:$check
bmc_ready_vector: select -assert-count 8 t:$check

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram_ohread.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
