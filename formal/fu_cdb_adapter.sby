[tasks]
bmc
cover
bmc_registered
cover_registered
bmc_no_refill
cover_no_refill
bmc_precomputed
bmc_always_granted

[options]
bmc: mode bmc
bmc: depth 8
cover: mode cover
cover: depth 12
bmc_registered: mode bmc
bmc_registered: depth 8
cover_registered: mode cover
cover_registered: depth 12
bmc_no_refill: mode bmc
bmc_no_refill: depth 8
cover_no_refill: mode cover
cover_no_refill: depth 12
bmc_precomputed: mode bmc
bmc_precomputed: depth 8
bmc_always_granted: mode bmc
bmc_always_granted: depth 8

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv fu_cdb_adapter.sv
bmc_registered: chparam -set REGISTER_OUTPUT 1 -set ALLOW_GRANT_REFILL 0 fu_cdb_adapter
cover_registered: chparam -set REGISTER_OUTPUT 1 -set ALLOW_GRANT_REFILL 0 fu_cdb_adapter
# The FP pipe's adapter: no grant refill, combinational output.
bmc_no_refill: chparam -set ALLOW_GRANT_REFILL 0 fu_cdb_adapter
cover_no_refill: chparam -set ALLOW_GRANT_REFILL 0 fu_cdb_adapter
# The second ALU's adapter: unqualified payload write, precomputed age.
bmc_precomputed: chparam -set ALLOW_GRANT_REFILL_PAYLOAD_WRITE 0 -set INPUT_YOUNGER_PRECOMPUTED 1 fu_cdb_adapter
# The memory adapter: always granted, precomputed age.
bmc_always_granted: chparam -set ALLOW_GRANT_REFILL 0 -set ALWAYS_GRANTED 1 -set INPUT_YOUNGER_PRECOMPUTED 1 fu_cdb_adapter
hierarchy -top fu_cdb_adapter
script free_undefined.ys
prep -top fu_cdb_adapter

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/fu_cdb_adapter/fu_cdb_adapter.sv
free_undefined.ys
