[tasks]
prove resume proof
cover resume witness
retirement_prove retirement proof
retirement_cover retirement witness

[options]
prove: mode prove
prove: depth 3
prove: timeout 90
cover: mode cover
cover: depth 7
cover: timeout 120
retirement_prove: mode prove
retirement_prove: depth 5
retirement_prove: timeout 90
retirement_cover: mode cover
retirement_cover: depth 7
retirement_cover: timeout 120

[engines]
smtbmc boolector

[script]
# Elaborate the production core, wrapper, ROB and recovery controllers.
# Use arbitrary values at the named blackboxes' output ports.
read_slang --top cpu_ooo --single-unit -DSYNTHESIS --blackboxed-module branch_resolution --blackboxed-module cdb_arbiter --blackboxed-module cdb_live_value_restore --blackboxed-module coherent_atomic_guard --blackboxed-module coherent_atomic_select --blackboxed-module commit_actions --blackboxed-module commit_bus_pipeline --blackboxed-module csr_file --blackboxed-module data_mem_request_router --blackboxed-module decoded_bundle_queue --blackboxed-module dispatch --blackboxed-module dispatch_rs_router --blackboxed-module dmmu --blackboxed-module ex_comb_synthesizer --blackboxed-module fp_shim --blackboxed-module frontend_validity_tracker --blackboxed-module fu_cdb_adapter --blackboxed-module id_stage --blackboxed-module if_stage --blackboxed-module imsic_file --blackboxed-module int_alu_shim --blackboxed-module int_muldiv_shim --blackboxed-module l2tlb --blackboxed-module load_queue --blackboxed-module lq_coherence_port --blackboxed-module mem_wakeup_merge --blackboxed-module ooo_pipeline_control --blackboxed-module ooo_register_files --blackboxed-module pd_stage --blackboxed-module ptw --blackboxed-module ras_flush_checkpoint --blackboxed-module register_alias_table --blackboxed-module reservation_station --blackboxed-module rob_link_value_ram --blackboxed-module sc_pending_unit --blackboxed-module sq_early_addr_pipeline --blackboxed-module store_queue --blackboxed-module tage_history --blackboxed-module trap_unit --blackboxed-module vec_lmul_legality --blackboxed-module walk_request_select cache_perf_pkg.sv riscv_pkg.sv ma_pkg.sv rvc_decompressor.sv c_ext_state.sv instruction_aligner.sv branch_predictor.sv direction_predictor.sv tage_predictor.sv ittage_predictor.sv backing_btb.sv return_address_stack.sv branch_prediction_controller.sv prediction_metadata_tracker.sv control_flow_tracker.sv pc_reg_precompute.sv pc_increment_calculator.sv pc_controller.sv served_window_coverage.sv fetch_redirect.sv pd_target_candidate.sv slot2_prediction_capture.sv immu.sv if_stage.sv pd_target_high_precompute.sv pd_redirect_next.sv pd_stage.sv instr_decoder.sv instr_operand_classifier.sv immediate_decoder.sv instruction_type_decoder.sv branch_target_precompute.sv id_stage.sv generic_regfile.sv vec_hold_rows.sv sdp_dist_ram.sv mwp_dist_ram.sv mwp_dist_ram_ohread.sv rob_serializer.sv sfence_operand_store.sv reorder_buffer.sv rob_link_value_ram.sv register_alias_table.sv rs_issue2_selector.sv coherent_rs_capacity.sv coherent_rs_issue2_selector.sv coherent_rs_payload_store.sv reservation_station.sv cdb_arbiter.sv fu_cdb_adapter.sv dsp_tiled_multiplier_unsigned.sv multiplier.sv divider.sv alu.sv int_alu_shim.sv cl_multiplier.sv int_muldiv_shim.sv fp_engine.sv fp_pipe_lzc.sv fp_fma_pipe.sv fp_div_unit.sv fp_shim.sv load_unit.sv coherent_l0_flags.sv lq_l0_cache.sv lq_issue_selector.sv coherent_lq_issue_selector.sv coherent_lq_candidate_select.sv coherent_lq_address_store.sv load_queue.sv sq_forwarding_unit.sv store_queue.sv dtlb.sv dmmu.sv tomasulo_perf_counters.sv sq_early_addr_pipeline.sv commit_bus_pipeline.sv dispatch_rs_router.sv sc_pending_unit.sv lq_coherence_port.sv mem_wakeup_merge.sv coherent_atomic_select.sv tomasulo_wrapper.sv dispatch.sv branch_jump_unit.sv csr_file.sv vec_pkg.sv vec_int_lane.sv vec_mul_lane.sv vec_mask_unit.sv vec_red_unit.sv vec_xbar.sv vec_clmul_lane.sv vec_aes_group.sv vec_sha2_group.sv vec_ghash_group.sv vec_vrf.sv vec_fma.sv vec_fp_misc.sv vec_f2i.sv vec_i2f.sv vec_f2f.sv vec_fdivsqrt.sv vec_fp_estimate.sv vec_fp_lane.sv vec_fp_exec.sv vec_cfg_unit.sv vec_fixed_lane.sv vec_div_lane.sv vec_int_exec.sv vec_crypto_exec.sv vec_engine.sv vec_vtype_tracker.sv vec_lmul_legality.sv vec_arith_legality.sv vec_dispatch_legality.sv vec_head_mmu.sv vec_vmu.sv vec_unit.sv vec_vmt.sv imsic_priority.sv imsic_file.sv trap_unit.sv ptw.sv l2tlb.sv walk_request_select.sv line_align.sv ma_engine.sv ooo_pipeline_control.sv ooo_register_files.sv data_mem_request_router.sv ex_comb_synthesizer.sv perf_counter_aggregator.sv frontend_validity_tracker.sv decoded_bundle_queue.sv commit_actions.sv branch_resolution.sv early_misprediction_recovery.sv misprediction_flush_controller.sv ras_flush_checkpoint.sv tage_history.sv coherent_atomic_guard.sv cpu_ooo.sv stall_capture_reg.sv sdp_block_ram.sv wfi_commit_guard_formal.sv
hierarchy -top cpu_ooo
script free_undefined.ys
select -assert-count 1 w:u_tomasulo.u_rob.commit_ready_early
select -assert-count 1 w:resume_wfi_q
cutpoint -blackbox
setundef -undriven -anyseq

resume: chformal -assert -remove c:wfi_guard.p_retirement_*
resume: chformal -cover -remove c:wfi_guard.c_retirement_*

# The retirement reference permits arbitrary holds and WFI completion state.
retirement: chformal -assert -remove c:wfi_guard.p_wfi_arm_passes_slot1_gate
retirement: chformal -assume -remove c:wfi_guard.a_*
retirement: chformal -cover -remove c:wfi_guard.c_wfi_*

prep -top cpu_ooo -flatten
resume: select -assert-count 1 t:$check r:FLAVOR=assert %i
resume: select -assert-count 2 t:$check r:FLAVOR=assume %i
resume: select -assert-count 3 t:$check r:FLAVOR=cover %i
retirement: select -assert-count 2 t:$check r:FLAVOR=assert %i
retirement: select -assert-none t:$check r:FLAVOR=assume %i
retirement: select -assert-none t:$assume
retirement: select -assert-count 4 t:$check r:FLAVOR=cover %i

proof: chformal -cover -remove
witness: chformal -assert -remove

