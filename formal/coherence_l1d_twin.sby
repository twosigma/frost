[tasks]
l1d_twin_single single
l1d_twin_multi multi
# Stream prefetching sets the credited read turn, the operation LUT6's other
# half of rows.
l1d_twin_stream stream

[options]
mode bmc
depth 1
timeout 600

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS cache_perf_pkg.sv coherence_pkg.sv
read -sv -D SYNTHESIS coherence_read_stream.sv coherence_request_endpoint.sv
read -sv -D SYNTHESIS coherence_put_endpoint.sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv coherence_grant_select.sv coherence_read_payload.sv coherence_store_buffer.sv
read -sv -D SYNTHESIS coherence_read_select.sv
read -sv -D SYNTHESIS sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv coherence_l1d.sv
single: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 coherence_l1d
multi: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
stream: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 8 -set STREAM_PREFETCH 1 coherence_l1d
hierarchy -check -top coherence_l1d
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 4 a:init
select -assert-none i:* o:* %i
single: select -assert-count 299 t:$dff
multi: select -assert-count 334 t:$dff
stream: select -assert-count 433 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut coherence_l1d/w:*
select -assert-none coherence_l1d/t:$dff %co:+[Q] coherence_l1d/w:* %i %co1 coherence_l1d/t:* %i
single: select -assert-count 570 t:$anyseq
multi: select -assert-count 599 t:$anyseq
stream: select -assert-count 635 t:$anyseq
autoname t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS cache_perf_pkg.sv coherence_pkg.sv
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS coherence_read_stream.sv coherence_request_endpoint.sv
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS coherence_put_endpoint.sv coherence_read_owners.sv coherence_miss_credit.sv coherence_read_flags.sv coherence_grant_select.sv coherence_read_payload.sv coherence_store_buffer.sv
read -sv -D SYNTHESIS coherence_read_select.sv
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv coherence_array.sv coherence_l1d.sv
single: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 coherence_l1d
multi: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 3 coherence_l1d
stream: chparam -set CACHE_BYTES 64 -set WAYS 1 -set TAG_BITS 2 -set MISSES 8 -set STREAM_PREFETCH 1 coherence_l1d
hierarchy -check -top coherence_l1d
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 4 a:init
select -assert-none i:* o:* %i
single: select -assert-count 299 t:$dff
multi: select -assert-count 334 t:$dff
stream: select -assert-count 433 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut coherence_l1d/w:*
select -assert-none coherence_l1d/t:$dff %co:+[Q] coherence_l1d/w:* %i %co1 coherence_l1d/t:* %i
single: select -assert-count 570 t:$anyseq
multi: select -assert-count 599 t:$anyseq
stream: select -assert-count 635 t:$anyseq
autoname t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists and matching initial values.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
single: select -assert-count 713 t:$anyseq
single: select -assert-count 103 t:$anyseq n:*_gold %i
single: select -assert-count 103 t:$anyseq n:*_gate %i
multi: select -assert-count 679 t:$anyseq
multi: select -assert-count 52 t:$anyseq n:*_gold %i
multi: select -assert-count 52 t:$anyseq n:*_gate %i
stream: select -assert-count 694 t:$anyseq
stream: select -assert-count 56 t:$anyseq n:*_gold %i
stream: select -assert-count 56 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
l1d_twin_single: select -assert-min 9 @blk
l1d_twin_multi: select -assert-min 12 @blk
l1d_twin_stream: select -assert-min 14 @blk
l1d_twin_single: select -assert-min 31352 t:$equiv
l1d_twin_multi: select -assert-min 40269 t:$equiv
l1d_twin_stream: select -assert-min 62327 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/lib/cache/coherence_read_stream.sv
../hw/rtl/lib/ram/sdp_block_ram.sv
../hw/rtl/lib/ram/sdp_packed_tag_uram.sv
../hw/rtl/lib/ram/sdp_ram_byte_en.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_array.sv
../hw/rtl/lib/cache/coherence_request_endpoint.sv
../hw/rtl/lib/cache/coherence_put_endpoint.sv
../hw/rtl/lib/cache/coherence_l1d.sv
../hw/rtl/lib/cache/coherence_read_owners.sv
../hw/rtl/lib/cache/coherence_miss_credit.sv
../hw/rtl/lib/cache/coherence_read_flags.sv
../hw/rtl/lib/cache/coherence_grant_select.sv
../hw/rtl/lib/cache/coherence_read_select.sv
../hw/rtl/lib/cache/coherence_read_payload.sv
../hw/rtl/lib/cache/cache_perf_pkg.sv
../hw/rtl/lib/cache/coherence_store_buffer.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
