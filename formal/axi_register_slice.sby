[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
read_slang --top axi_register_slice_formal --single-unit --no-synthesis-define -DFORMAL axi_register_slice.sv axil_register_slice.sv axi_register_slice_formal.sv
hierarchy -top axi_register_slice_formal
script free_undefined.ys
prep -top axi_register_slice_formal -flatten
~cover: chformal -cover -remove
opt_clean
select -assert-count 130 t:$check r:FLAVOR=assert %i
cover: select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/lib/axi/axi_register_slice.sv
../hw/rtl/lib/axi/axil_register_slice.sv
axi_register_slice_formal.sv
free_undefined.ys
