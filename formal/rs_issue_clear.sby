[tasks]
bmc
bmc4
bmc8
bmc16
bmc32

[options]
mode bmc
depth 1

[engines]
smtbmc boolector

[script]
read -sv riscv_pkg.sv rs_issue2_selector.sv
read -formal -D SYNTHESIS -D RS_PRETAG_LOCAL_PROOF -D RS_ISSUE_CLEAR_LOCAL_PROOF -sv reservation_station.sv
bmc: chparam -set DEPTH 16 -set DUAL_ISSUE 0 reservation_station
bmc4: chparam -set DEPTH 4 -set DUAL_ISSUE 1 reservation_station
bmc8: chparam -set DEPTH 8 -set DUAL_ISSUE 1 -set HAS_SRC3 0 -set DISPATCH_REPAIR_BYPASS 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set TRACK_INT_WRITEBACK_HINT 1 -set SPECULATIVE_DATA_WRITES 1 -set BROADCAST_FREE_SOURCE_VALUES 1 -set ISSUE_CDB_TAG_SHADOW 1 -set ISSUE_CDB_META_ANCHORS 1 -set CAPTURE_PRIMARY_EFFECTIVE_OPERANDS 1 -set BRANCH_PREDICATE_TAG_ANCHOR 1 -set TRUST_DISPATCH_VALID 1 -set TAG_INDEXED_BRANCH_PAYLOAD 1 -set FORMAL_STANDALONE_ENV 0 reservation_station
bmc16: chparam -set DEPTH 16 -set DUAL_ISSUE 1 -set ISSUE2_WINDOW 8 -set HAS_SRC3 0 -set DISPATCH_REPAIR_BYPASS 0 -set ISSUE_REPAIR_BYPASS 0 -set ALLOC_INDEXED_REPAIR 1 -set TRACK_INT_WRITEBACK_HINT 1 -set SPECULATIVE_DATA_WRITES 1 -set BROADCAST_FREE_SOURCE_VALUES 1 -set ISSUE_CDB_TAG_SHADOW 1 -set ISSUE_CDB_META_ANCHORS 1 -set CAPTURE_PRIMARY_EFFECTIVE_OPERANDS 1 -set BRANCH_PREDICATE_TAG_ANCHOR 1 -set TRUST_DISPATCH_VALID 1 -set TAG_INDEXED_BRANCH_PAYLOAD 1 -set FORMAL_STANDALONE_ENV 0 reservation_station
bmc32: chparam -set DEPTH 32 -set DUAL_ISSUE 1 reservation_station
hierarchy -top reservation_station
# The clear proof holds whatever the payload RAMs return, initial contents included.
delete t:sdp_dist_ram t:mwp_dist_ram t:mwp_dist_ram_ohread
proc
setundef -undriven -anyseq
opt
prep -top reservation_station -flatten
select -assert-none t:$assume a:init
select -assert-none t:$check r:FLAVOR=assume %i
select -assert-count 2 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/rs_issue2_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/reservation_station/reservation_station.sv
