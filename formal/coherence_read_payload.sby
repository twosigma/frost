[tasks]
coh_read_payload_prove normal
coh_read_payload64_prove wide

[options]
mode prove
depth 4
timeout 180

[engines]
smtbmc boolector

[script]
read -formal -sv coherence_read_payload.sv coherence_read_payload_formal.sv
wide: chparam -set WIDTH 74 coherence_read_payload_formal
hierarchy -top coherence_read_payload_formal
script free_undefined.ys
prep -flatten -top coherence_read_payload_formal
select -assert-count 19 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/lib/cache/coherence_read_payload.sv
coherence_read_payload_formal.sv
free_undefined.ys
