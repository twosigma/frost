[tasks]
prove_int_active prove
prove_int_ckpt_lo prove
prove_int_ckpt_mid prove
prove_int_ckpt_hi prove
prove_fp_active prove
prove_fp_ckpt_lo prove
prove_fp_ckpt_mid prove
prove_fp_ckpt_hi prove
cover

[options]
prove: mode prove
prove: depth 1
cover: mode cover
cover: depth 15

[engines]
prove: smtbmc --nopresat boolector -- --noincr
cover: smtbmc boolector

[script]
prove_int_active: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=1 -GCHECK_FP=0 -GCHECK_ACTIVE=1 -GCHECK_CKPT_MASK=0 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_int_ckpt_lo: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=1 -GCHECK_FP=0 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=15 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_int_ckpt_mid: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=1 -GCHECK_FP=0 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=240 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_int_ckpt_hi: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=1 -GCHECK_FP=0 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=3840 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_fp_active: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=0 -GCHECK_FP=1 -GCHECK_ACTIVE=1 -GCHECK_CKPT_MASK=0 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_fp_ckpt_lo: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=0 -GCHECK_FP=1 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=15 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_fp_ckpt_mid: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=0 -GCHECK_FP=1 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=240 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
prove_fp_ckpt_hi: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=0 -GCHECK_FP=1 -GCHECK_ACTIVE=0 -GCHECK_CKPT_MASK=3840 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
cover: read_slang --top rat_checkpoint_restore_formal --single-unit -GCHECK_INT=1 -GCHECK_FP=1 -GCHECK_ACTIVE=1 -GCHECK_CKPT_MASK=4095 riscv_pkg.sv sdp_dist_ram.sv register_alias_table.sv rat_checkpoint_restore_formal.sv
hierarchy -top rat_checkpoint_restore_formal
script free_undefined.ys
prep -top rat_checkpoint_restore_formal -flatten
~cover: chformal -cover -remove
memory_map
opt_muxtree
opt -full
opt_clean -purge
prove_int_active: select -assert-count 26 t:$check r:FLAVOR=assert %i
prove_int_ckpt_lo: select -assert-count 20 t:$check r:FLAVOR=assert %i
prove_int_ckpt_mid: select -assert-count 20 t:$check r:FLAVOR=assert %i
prove_int_ckpt_hi: select -assert-count 20 t:$check r:FLAVOR=assert %i
prove_fp_active: select -assert-count 17 t:$check r:FLAVOR=assert %i
prove_fp_ckpt_lo: select -assert-count 16 t:$check r:FLAVOR=assert %i
prove_fp_ckpt_mid: select -assert-count 16 t:$check r:FLAVOR=assert %i
prove_fp_ckpt_hi: select -assert-count 16 t:$check r:FLAVOR=assert %i
cover: select -assert-count 116 t:$check r:FLAVOR=assert %i
cover: select -assert-count 6 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/register_alias_table/register_alias_table.sv
rat_checkpoint_restore_formal.sv
free_undefined.ys
