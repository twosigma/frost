[tasks]
sq_twin sq
# The CPU's store-queue settings, as sq_next_same's bmc_cpu sets them.
sq_twin_cpu sq cpu

[options]
mode bmc
depth 1
timeout 120

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS riscv_pkg.sv vec_hold_rows.sv sdp_dist_ram.sv sq_forwarding_unit.sv store_queue.sv
cpu: chparam -set TRUST_DISPATCH_VALID 1 -set PRECISE_UNCACHED 1 -set CACHE_NORMAL_MEMORY 1 store_queue
hierarchy -check -top store_queue
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 16 a:init
select -assert-none i:* o:* %i
~cpu: select -assert-count 166 t:$dff
cpu: select -assert-count 170 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut store_queue/w:*
select -assert-none store_queue/t:$dff %co:+[Q] store_queue/w:* %i %co1 store_queue/t:* %i
~cpu: select -assert-count 536 t:$anyseq
cpu: select -assert-count 539 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS riscv_pkg.sv vec_hold_rows.sv sdp_dist_ram.sv sq_forwarding_unit.sv store_queue.sv
cpu: chparam -set TRUST_DISPATCH_VALID 1 -set PRECISE_UNCACHED 1 -set CACHE_NORMAL_MEMORY 1 store_queue
hierarchy -check -top store_queue
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
rename -hide w:*$func$* w:*$fordecl_block$*
opt_clean
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-count 16 a:init
select -assert-none i:* o:* %i
~cpu: select -assert-count 166 t:$dff
cpu: select -assert-count 170 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut store_queue/w:*
select -assert-none store_queue/t:$dff %co:+[Q] store_queue/w:* %i %co1 store_queue/t:* %i
~cpu: select -assert-count 536 t:$anyseq
cpu: select -assert-count 539 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists and matching initial values.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
~cpu: select -assert-count 1072 t:$anyseq
~cpu: select -assert-count 536 t:$anyseq n:*_gold %i
~cpu: select -assert-count 536 t:$anyseq n:*_gate %i
cpu: select -assert-count 1078 t:$anyseq
cpu: select -assert-count 539 t:$anyseq n:*_gold %i
cpu: select -assert-count 539 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
# o_cache_invalidate_valid ORs two registers (Zicbom's pulse), so it is no point.
select -assert-min 104 @blk
~cpu: select -assert-min 15796 t:$equiv
cpu: select -assert-min 16717 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_hold_rows.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/store_queue/sq_forwarding_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/store_queue/store_queue.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
