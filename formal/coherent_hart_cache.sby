[tasks]
coh_hart_maint_prove proof unbounded plain
coh_hart_maint_owned_prove owned unbounded plain
coh_hart_maint_owned_reset_prove owned unbounded resetstate
coh_hart_maint_cover covers base
coh_hart_maint_four_bmc four bounded fourbmc base
coh_hart_maint_four_cover four covers base

[options]
proof: mode prove
proof: depth 32
proof: aigsmt boolector
owned: mode prove
owned: depth 8
owned: timeout 1200
covers: mode cover
covers: depth 160
covers: vcd_sim on
proof: timeout 7200
covers: timeout 1200
four: depth 240
bounded: mode bmc
bounded: timeout 2400
# With every register starting free, the four-record bounded task takes
# about 18 minutes for its 240 frames with the Glucose backend.
fourbmc: timeout 7200
bounded: aigsmt boolector

[engines]
proof: abc pdr -r
owned: smtbmc boolector
covers: btor btormc
bounded: abc bmc3 -g

[script]
read -formal -sv riscv_pkg.sv cache_perf_pkg.sv coherence_pkg.sv
# Component targets prove the service engine and walker properties separately.
base: read -sv coherence_home_engine.sv ptw.sv
base: read -sv coherence_store_buffer.sv coherence_request_endpoint.sv coherence_d_arbiter.sv
unbounded: read -sv -D COH_MAINT_OWNED ptw.sv
unbounded: read -sv -D COH_MAINT_OWNED coherence_home_engine.sv coherence_store_buffer.sv coherence_request_endpoint.sv coherence_d_arbiter.sv
# Reader assertions apply here without the standalone environment assumptions.
base: read -sv -nosynthesis coherence_line_bridge.sv
unbounded: read -sv -nosynthesis -D COH_MAINT_OWNED coherence_line_bridge.sv
unbounded: read -formal -D COH_MAINT_OWNED -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
coh_hart_maint_cover: read -formal -D COH_MAINT_COVER -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
four: read -formal -D COH_MAINT_COVER -D COH_MAINT_FOUR -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
covers: chparam -set COVER_MODE 1 coherent_hart_cache_formal
bounded: chparam -set COVER_MODE 1 coherent_hart_cache_formal
prep -flatten -top coherent_hart_cache_formal
check -assert
# The induction task assumes nothing and proves all facts consumed by PDR.
unbounded: select -assert-none t:$check r:FLAVOR=assume %i
unbounded: select -assert-count 373 t:$check r:FLAVOR=assert %i
owned: chformal -assert -remove t:$check r:FLAVOR=assert %i c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_* %u %u %u %u %u %u %u %d
owned: select -assert-count 285 t:$check r:FLAVOR=assert %i
proof: select -assert-count 285 t:$check r:FLAVOR=assert %i c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_* %u %u %u %u %u %u %u %i
proof: chformal -assert2assume c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_*
proof: select -assert-count 285 t:$check r:FLAVOR=assume %i
proof: select -assert-count 88 t:$check r:FLAVOR=assert %i
unbounded: chformal -cover -remove
base: chformal -cover -remove c:*flatten_home* c:*flatten_walker* c:walker.* c:*bridge* c:*endpoint* c:*arbiter*
four: chformal -cover -remove c:* c:*p_four_records* %d
# The unbounded pair runs a plain opt (ROADMAP.md): with every register
# starting free its induction does not finish in its limit, and from the state
# after the reset cycle its PDR proof leaves one assertion unresolved.
plain: memory_map
~plain: memory_map -keepdc
# coh_hart_maint_owned_reset_prove proves the pair's 285 facts by the same
# induction from the state after the reset cycle, where it finishes in its
# limit, and no task assumes them from it. A register that the reset cycle
# defines (by its reset or a constant load) starts with that value, and opt
# -keepdc folds it when that is the only value it can hold; every other
# register starts free. async2sync also lowers the properties, as sim
# requires. sim treats an undefined enable or synchronous reset as inactive
# and compares undefined bits literally in $eqx and $nex, so no opt_dff runs
# before it (prep runs opt with -noff), only plain $dff cells reach it, and
# the comparisons take the meaning they have in the proof.
resetstate: async2sync
resetstate: select -assert-none t:$ff t:$dffe t:$adff* t:$aldff* t:$sdff* t:$dffsr* t:$dlatch* t:$adlatch t:$sr t:$mem* t:$_*DFF* t:$_*LATCH* t:$_SR_* t:$_FF_ t:$anyinit t:$fsm
resetstate: chtype -map $eqx $eq
resetstate: chtype -map $nex $ne
resetstate: sim -clock i_clk -n 1 -w
plain: opt
~plain: opt -keepdc
unbounded: techmap
plain: opt -fast
resetstate: opt -fast -keepdc
unbounded: setundef -anyseq
bounded: techmap
bounded: opt -fast -keepdc
bounded: setundef -anyseq
covers: setundef -zero
opt_clean

