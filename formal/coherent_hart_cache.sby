[tasks]
coh_hart_maint_prove proof unbounded
coh_hart_maint_owned_prove owned unbounded
coh_hart_maint_cover covers base
coh_hart_maint_four_bmc four bounded fourbmc base
coh_hart_maint_four_cover four covers base

[options]
proof: mode prove
proof: depth 32
proof: aigsmt boolector
owned: mode prove
owned: depth 8
owned: timeout 1200
covers: mode cover
covers: depth 160
covers: vcd_sim on
proof: timeout 7200
covers: timeout 1200
four: depth 240
bounded: mode bmc
bounded: timeout 2400
# The four-record bounded task needs more than 40 minutes for its 240 frames.
fourbmc: timeout 7200
bounded: aigsmt boolector

[engines]
proof: abc pdr -r
owned: smtbmc boolector
covers: btor btormc
bounded: abc bmc3 -c

[script]
read -formal -sv riscv_pkg.sv cache_perf_pkg.sv coherence_pkg.sv
# Component targets prove the service engine and walker properties separately.
base: read -sv coherence_home_engine.sv ptw.sv
base: read -sv coherence_store_buffer.sv coherence_request_endpoint.sv coherence_d_arbiter.sv
unbounded: read -sv -D COH_MAINT_OWNED ptw.sv
unbounded: read -sv -D COH_MAINT_OWNED coherence_home_engine.sv coherence_store_buffer.sv coherence_request_endpoint.sv coherence_d_arbiter.sv
# Reader assertions apply here without the standalone environment assumptions.
base: read -sv -nosynthesis coherence_line_bridge.sv
unbounded: read -sv -nosynthesis -D COH_MAINT_OWNED coherence_line_bridge.sv
unbounded: read -formal -D COH_MAINT_OWNED -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
coh_hart_maint_cover: read -formal -D COH_MAINT_COVER -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
four: read -formal -D COH_MAINT_COVER -D COH_MAINT_FOUR -sv coherent_hart_cache_models.sv coherent_hart_cache.sv coherent_hart_cache_formal.sv
covers: chparam -set COVER_MODE 1 coherent_hart_cache_formal
bounded: chparam -set COVER_MODE 1 coherent_hart_cache_formal
prep -flatten -top coherent_hart_cache_formal
check -assert
# The induction task assumes nothing and proves all facts consumed by PDR.
unbounded: select -assert-none t:$check r:FLAVOR=assume %i
unbounded: select -assert-count 372 t:$check r:FLAVOR=assert %i
owned: chformal -assert -remove t:$check r:FLAVOR=assert %i c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_* %u %u %u %u %u %u %u %d
owned: select -assert-count 284 t:$check r:FLAVOR=assert %i
proof: select -assert-count 284 t:$check r:FLAVOR=assert %i c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_* %u %u %u %u %u %u %u %i
proof: chformal -assert2assume c:*p_maint_owned_* c:p_maint_data_* c:*p_maint_ledger_* c:*p_maint_seq_* c:*p_maint_if_* c:*p_maint_ppn_* c:*p_maint_fact_* c:*p_maint_ptw_*
proof: select -assert-count 284 t:$check r:FLAVOR=assume %i
proof: select -assert-count 88 t:$check r:FLAVOR=assert %i
unbounded: chformal -cover -remove
base: chformal -cover -remove c:*flatten_home* c:*flatten_walker* c:walker.* c:*bridge* c:*endpoint* c:*arbiter*
four: chformal -cover -remove c:* c:*p_four_records* %d
memory_map
opt
unbounded: techmap
unbounded: opt -fast
unbounded: setundef -anyseq
bounded: techmap
bounded: opt -fast
bounded: setundef -anyseq
covers: setundef -zero
opt_clean

[files]
coherent_hart_cache_models.sv
coherent_hart_cache_formal.sv
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/ptw.sv
../hw/rtl/lib/cache/cache_perf_pkg.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_request_endpoint.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_line_bridge.sv
../hw/rtl/lib/cache/coherence_home_engine.sv
../hw/rtl/lib/cache/coherent_hart_cache.sv
../hw/rtl/lib/cache/coherence_store_buffer.sv
