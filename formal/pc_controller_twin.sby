[tasks]
pc_controller_twin pc
pc_controller_twin_slot2 slot2

[options]
mode bmc
depth 1
timeout 120

[engines]
smtbmc boolector

[script]
# Compare every named point with arbitrary inputs and paired register state.
read -sv -D SYNTHESIS riscv_pkg.sv control_flow_tracker.sv pc_reg_precompute.sv pc_increment_calculator.sv pc_controller.sv
slot2: chparam -set PENDING_HANDOFF_EXCLUDES_SLOT2 1 pc_controller
hierarchy -check -top pc_controller
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 28 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut pc_controller/w:*
select -assert-none pc_controller/t:$dff %co:+[Q] pc_controller/w:* %i %co1 pc_controller/t:* %i
select -assert-count 80 t:$anyseq
rename -top gold
design -stash gold
design -reset
read_verilog -formal +/xilinx/cells_sim.v
read -sv -D SYNTHESIS -D FROST_XILINX_PRIMS riscv_pkg.sv control_flow_tracker.sv pc_reg_precompute.sv pc_increment_calculator.sv pc_controller.sv
slot2: chparam -set PENDING_HANDOFF_EXCLUDES_SLOT2 1 pc_controller
hierarchy -check -top pc_controller
script free_undefined.ys
select -assert-none a:init t:$initstate t:$anyinit
setattr -mod -unset keep_hierarchy *
setattr -set from_prim 1 $paramod*LUT*/* $paramod*MUXF*/* $paramod*CARRY*/* $paramod*FD*/* LUT*/* MUXF*/* CARRY*/* FD*/*
flatten
memory_map -keepdc
dffunmap
setundef -undriven -anyseq
setattr -set keep 1 w:* w:$* %d
opt_clean
check -assert
select -assert-none a:init t:$initstate t:$anyinit t:$anyconst t:$allseq t:$allconst t:$sr t:$*latch* t:$*ff* t:$dff %d
select -assert-none i:* o:* %i
select -assert-count 28 t:$dff
select -assert-none t:$dff i:i_clk %co1:+$dff[CLK] %d
expose -dff -cut pc_controller/w:*
select -assert-none pc_controller/t:$dff %co:+[Q] pc_controller/w:* %i %co1 pc_controller/t:* %i
select -assert-count 75 t:$anyseq
rename -top gate
design -stash gate
design -reset
read -sv twin_both.sv
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
hierarchy -top twin_both
script free_undefined.ys
# The runner checks the two compiled port lists, including declared indices.
write_json twin_ports.json
equiv_make gold gate equiv
delete gold gate twin_both
setundef -anyseq
select -assert-none i:*_gold i:*_gate o:*_gold o:*_gate
select -assert-count 155 t:$anyseq
select -assert-count 80 t:$anyseq n:*_gold %i
select -assert-count 75 t:$anyseq n:*_gate %i
select -set prim t:* a:from_prim %i
select -set blk @prim %co*:-$equiv[Y] t:$equiv %i
select -assert-min 3708 @blk
select -assert-min 11638 t:$equiv
equiv_simple
equiv_status -assert
design -reset
read -formal -sv prim_twin_done.sv
hierarchy -top prim_twin_done
script free_undefined.ys
prep -top prim_twin_done

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/control_flow_tracker.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_reg_precompute.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_increment_calculator.sv
../hw/rtl/cpu_and_mem/cpu/if_stage/pc_controller.sv
prim_twin_done.sv
free_undefined.ys
twin_both.sv
