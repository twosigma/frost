[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 4
cover: mode cover
cover: depth 8

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv cdb_arbiter.sv
hierarchy -top cdb_arbiter
script free_undefined.ys
prep -top cdb_arbiter
select -assert-count 31 t:$check r:FLAVOR=assert %i
select -assert-count 6 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/cdb_arbiter/cdb_arbiter.sv
free_undefined.ys
