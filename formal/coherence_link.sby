[tasks]
link_zero_prove zero proof
link_always1_prove always s1 proof
link_always2_prove always s2 proof
link_credit1_bmc credit s1 bounded
link_credit2_bmc credit s2 bounded
link_one1_prove one s1 proof
link_one2_prove one s2 proof
link_mirror1_prove mirror s1 proof
link_mirror2_prove mirror s2 proof
link_credit1_cover credit s1 reach
link_mirror1_cover mirror s1 reach

[options]
proof: mode prove
proof: depth 16
proof: aigsmt boolector
reach: mode cover
bounded: mode bmc
bounded: depth 40
reach: depth 24

[engines]
proof: abc pdr
reach: smtbmc boolector
bounded: smtbmc boolector

[script]
read -formal -D COHERENCE_LINK_PROOF coherence_link.sv
link_zero_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 0 -chparam CREDITS 1
link_always1_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 0 -chparam STAGES 1 -chparam CREDITS 3
link_always2_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 0 -chparam STAGES 2 -chparam CREDITS 5
link_credit1_bmc: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 1 -chparam CREDITS 3
link_credit2_bmc: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 2 -chparam CREDITS 5
link_one1_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 1 -chparam CREDITS 1
link_one2_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 2 -chparam CREDITS 1
link_mirror1_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 2 -chparam STAGES 1 -chparam CREDITS 3
link_mirror2_prove: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 2 -chparam STAGES 2 -chparam CREDITS 5
link_credit1_cover: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 1 -chparam STAGES 1 -chparam CREDITS 3
link_mirror1_cover: hierarchy -top coherence_link -chparam WIDTH 4 -chparam KIND 2 -chparam STAGES 1 -chparam CREDITS 3
prep -top coherence_link

[files]
../hw/rtl/lib/cache/coherence_link.sv
