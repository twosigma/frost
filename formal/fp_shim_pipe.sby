# Copyright (c) 2026 John Goodacre.
# fp_shim with PIPELINE=1: tracker, forward wake, result FIFO and credits.
# The datapath and the engine are abstracted (arbitrary results, arbitrary
# engine latency); fp_fma_pipe_equiv checks the arithmetic.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 32

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv sdp_dist_ram.sv
read -formal -sv fp_shim.sv
chparam -set PIPELINE 1 -set LAUNCH_SQUASH 1 fp_shim
hierarchy -top fp_shim
script free_undefined.ys
prep -top fp_shim
select -assert-count 38 t:$check r:FLAVOR=assert %i
select -assert-count 10 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/fu_shims/fp_shim.sv
free_undefined.ys
