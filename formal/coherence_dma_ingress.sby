[tasks]
coh_dma_ingress_prove small
coh_dma_ingress_cover small
coh_dma_ingress_soc_prove soc
coh_dma_ingress_soc_cover soc
coh_line_client_prove line small
coh_line_client_eight_prove line
coh_line_client_cover line small
coh_line_client_eight_cover line

[options]
coh_dma_ingress_prove: mode prove
coh_dma_ingress_cover: mode cover
coh_dma_ingress_prove: depth 6
coh_dma_ingress_cover: depth 16
coh_dma_ingress_soc_prove: mode prove
coh_dma_ingress_soc_prove: depth 6
coh_dma_ingress_soc_cover: mode cover
coh_dma_ingress_soc_cover: depth 48
coh_dma_ingress_soc_prove: timeout 3120
coh_dma_ingress_soc_cover: timeout 600
coh_line_client_prove: mode prove
coh_line_client_prove: depth 6
coh_line_client_eight_prove: mode prove
coh_line_client_eight_prove: depth 6
coh_line_client_eight_prove: timeout 2100
coh_line_client_cover: mode cover
coh_line_client_cover: depth 16
coh_line_client_eight_cover: mode cover
coh_line_client_eight_cover: depth 16
coh_line_client_eight_cover: timeout 600
small: timeout 600

[engines]
smtbmc boolector

[script]
read -sv coherence_pkg.sv
read -formal -sv -D COHERENCE_ARBITER_COMPOSED coherence_d_arbiter.sv
~coh_dma_ingress_soc_cover: read -formal -sv -D COHERENCE_DMA_INGRESS_CONTRACT coherence_dma_ingress.sv
coh_dma_ingress_soc_cover: read -formal -sv -D COHERENCE_DMA_INGRESS_CONTRACT -D COHERENCE_DMA_SOC_COVER coherence_dma_ingress.sv
soc: chparam -set SLOTS 8 coherence_dma_ingress
# The simultaneous response, request, demand and release cover needs three
# live slots, so the line client's cover uses four.
coh_line_client_prove: chparam -set SOURCE 0 -set SLOTS 2 coherence_dma_ingress
coh_line_client_eight_prove: chparam -set SOURCE 0 -set SLOTS 8 coherence_dma_ingress
coh_line_client_cover: chparam -set SOURCE 0 -set SLOTS 4 coherence_dma_ingress
coh_line_client_eight_cover: chparam -set SOURCE 0 -set SLOTS 8 coherence_dma_ingress
coh_dma_ingress_soc_cover: chformal -assert -remove
hierarchy -top coherence_dma_ingress
script free_undefined.ys
prep -top coherence_dma_ingress
memory_map
opt

[files]
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_dma_ingress.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
free_undefined.ys
