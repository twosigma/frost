[tasks]
home_small home small
home_four home four
home_default home
array_bram array bram
array_bram_four array bram bram_four
array_uram array uram
array_uram32 array uram uram32
array_uram_row array uram row_read
endpoint32 endpoint
endpoint56 endpoint wide
arbiter_default arbiter
arbiter_idle arbiter idle
completions_two completions two
completions_three completions three
completions_default completions

[options]
mode prove
depth 6
timeout 120

[engines]
smtbmc boolector

[script]
read -sv -D SYNTHESIS cache_perf_pkg.sv coherence_pkg.sv
read -sv -D SYNTHESIS sdp_block_ram.sv sdp_packed_tag_uram.sv sdp_ram_byte_en.sv
read -sv -D SYNTHESIS coherence_seat_select.sv coherence_work_select.sv coherence_home_engine.sv
read -formal -sv -D SYNTHESIS -D HOME_CAPTURE_LOCAL_PROOF coherence_home_completions.sv coherence_d_arbiter.sv coherence_home_endpoint.sv coherence_home_array.sv coherence_home.sv
small: chparam -set CACHE_BYTES 128 -set WAYS 1 -set ULTRA 0 -set COMPLETIONS 2 -set RESULTS 2 -set FILLS 2 -set PREFETCH_SLOTS 0 coherence_home
four: chparam -set CACHE_BYTES 1024 -set WAYS 4 -set COMPLETIONS 4 -set RESULTS 3 -set FILLS 3 -set PREFETCH_RESERVE 1 -set PREFETCH_SLOTS 0 coherence_home
array: chparam -set CACHE_BYTES 128 -set WAYS 1 -set LINE_BYTES 32 coherence_home_array
bram: chparam -set ULTRA 0 coherence_home_array
bram_four: chparam -set CACHE_BYTES 512 -set WAYS 4 -set LINE_BYTES 64 coherence_home_array
uram: chparam -set CACHE_BYTES 512 -set WAYS 4 -set LINE_BYTES 64 coherence_home_array
uram32: chparam -set CACHE_BYTES 256 -set LINE_BYTES 32 coherence_home_array
row_read: chparam -set DATA_READ_LATENCY 4 coherence_home_array
wide: chparam -set ADDR_WIDTH 56 -set L2_NUM_MSHR 16 coherence_home_endpoint
arbiter: chparam -set WIDTH 12 -set PORTS 3 -set HOLD_VALID 1 coherence_d_arbiter
idle: chparam -set IDLE_PAYLOAD_LOAD 1 coherence_d_arbiter
two: chparam -set SLOTS 2 -set RESULT_SLOTS 2 -set PREFETCH_SLOTS 0 coherence_home_completions
three: chparam -set SLOTS 3 -set RESULT_SLOTS 2 -set PREFETCH_SLOTS 0 coherence_home_completions
home: hierarchy -check -top coherence_home
array: hierarchy -check -top coherence_home_array
endpoint: hierarchy -check -top coherence_home_endpoint
arbiter: hierarchy -check -top coherence_d_arbiter
completions: hierarchy -check -top coherence_home_completions
# The capture proof keeps the DUT's phase, valid and payload flops. Other
# modules' outputs and the home's producer values are arbitrary each cycle.
home: delete t:*coherence_home_array t:*coherence_home_endpoint t:*coherence_d_arbiter t:*coherence_home_completions t:*coherence_home_engine t:*coherence_seat_select t:*coherence_work_select
array: delete t:*sdp_block_ram t:*sdp_packed_tag_uram t:*sdp_ram_byte_en
completions: delete t:*coherence_home_endpoint t:*coherence_d_arbiter
script free_undefined.ys
setattr -mod -unset keep_hierarchy
setattr -unset keep
flatten
chformal -remove t:$check c:*p_capture* %d
home: cutpoint w:memory_payload w:memory_pick w:memory_found w:run w:update_selected w:update_request_ready w:gen_fill*.allocate w:gen_fill*.fill_phase_hold
# The selector retains its legal slot encoding. Eligibility, ready priority,
# buffer availability and forward events are arbitrary in the capture model.
completions: cutpoint w:work_eligible w:work_position_ready w:free_buffer w:forwarded
# Only the capture properties are observable in this local model. Reset is
# unrestricted. State comparisons start after the first observed reset;
# the completion next-state comparison is unconditional.
delete -output w:*
opt -purge -keepdc
setundef -undriven -anyseq
home: prep -top coherence_home
array: prep -top coherence_home_array
endpoint: prep -top coherence_home_endpoint
arbiter: prep -top coherence_d_arbiter
completions: prep -top coherence_home_completions
select -assert-none t:$check r:FLAVOR=assume %i
home: select -assert-count 3 t:$check r:FLAVOR=assert %i
array: select -assert-count 6 t:$check r:FLAVOR=assert %i
endpoint: select -assert-count 3 t:$check r:FLAVOR=assert %i
arbiter: select -assert-count 1 t:$check r:FLAVOR=assert %i
completions: select -assert-count 9 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/lib/cache/cache_perf_pkg.sv
../hw/rtl/lib/cache/coherence_pkg.sv
../hw/rtl/lib/cache/coherence_types.svh
../hw/rtl/lib/cache/coherence_seat_select.sv
../hw/rtl/lib/cache/coherence_work_select.sv
../hw/rtl/lib/cache/coherence_home_completions.sv
../hw/rtl/lib/cache/coherence_home_engine.sv
../hw/rtl/lib/cache/coherence_d_arbiter.sv
../hw/rtl/lib/cache/coherence_home_endpoint.sv
../hw/rtl/lib/cache/coherence_home_array.sv
../hw/rtl/lib/cache/coherence_home.sv
../hw/rtl/lib/ram/sdp_block_ram.sv
../hw/rtl/lib/ram/sdp_packed_tag_uram.sv
../hw/rtl/lib/ram/sdp_ram_byte_en.sv
free_undefined.ys
