[tasks]
prove
prove_wide
prove_predecoded

[options]
mode prove
depth 2

[engines]
smtbmc boolector

[script]
read -formal -D IMSIC_TOP_EQUIV -sv imsic_priority.sv imsic_file.sv
prove_wide: chparam -set NUM_IDS 191 imsic_file
prove_predecoded: chparam -set PREDECODED_SELECT 1 -set PREDECODED_MSI 1 imsic_file
prep -top imsic_file

[files]
../hw/rtl/peripherals/imsic/imsic_priority.sv
../hw/rtl/peripherals/imsic/imsic_file.sv
