[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 25
prove: mode prove
prove: depth 1

[engines]
smtbmc z3

[script]
read -formal -sv riscv_pkg.sv
bmc: read -formal -sv trap_unit.sv
cover: read -formal -sv trap_unit.sv
# Entry-enable identities and atomic exception selection use arbitrary state.
prove: read -formal -D TRAP_ENTRY_ENABLE_LOCAL_PROOF -sv trap_unit.sv
hierarchy -top trap_unit
script free_undefined.ys
prep -top trap_unit
prove: select -assert-count 11 t:$check r:FLAVOR=assert %i
prove: select -assert-none t:$assume
prove: select -assert-none t:$check r:FLAVOR=assume %i
~prove: select -assert-count 86 t:$check r:FLAVOR=assert %i
~prove: select -assert-count 28 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/control/trap_unit.sv
free_undefined.ys
