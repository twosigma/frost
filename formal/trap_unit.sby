[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 25
prove: mode prove
prove: depth 1

[engines]
smtbmc z3

[script]
read -formal -sv riscv_pkg.sv
bmc: read -formal -sv trap_unit.sv
cover: read -formal -sv trap_unit.sv
# Only the entry-enable identities, from arbitrary register values.
prove: read -formal -D TRAP_ENTRY_ENABLE_LOCAL_PROOF -sv trap_unit.sv
prep -top trap_unit
prove: select -assert-count 3 t:$check
prove: select -assert-none t:$assume

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/control/trap_unit.sv
