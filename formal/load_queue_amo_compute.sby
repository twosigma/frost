[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 4
cover: mode cover
cover: depth 4

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -sv sdp_dist_ram.sv
read -sv mwp_dist_ram.sv
read -sv load_unit.sv
read -sv lq_l0_cache.sv
read -sv lq_issue_selector.sv
read -formal -sv -D LQ_AMO_COMPUTE_LOCAL_PROOF load_queue.sv
prep -top load_queue
# Count only the named checks this proof relies on (p_local_*, cover_local_*,
# p_lq_*_free_tree_*), so other assertions in load_queue.sv do not change the
# counts. Every check still runs.
select -assert-count 22 t:$check r:FLAVOR=assert %i load_queue/p_local_* %i
select -assert-count 1 t:$check r:FLAVOR=cover %i load_queue/cover_local_* %i
select -assert-count 4 t:$check load_queue/p_lq_*_free_tree_* %i
select -assert-none t:$assume

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/lib/ram/sdp_dist_ram.sv
../hw/rtl/lib/ram/mwp_dist_ram.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_unit.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_l0_cache.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/lq_issue_selector.sv
../hw/rtl/cpu_and_mem/cpu/tomasulo/load_queue/load_queue.sv
