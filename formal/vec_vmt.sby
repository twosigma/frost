[tasks]
vmt_bmc
cover

[options]
vmt_bmc: mode bmc
vmt_bmc: depth 14
cover: mode cover
cover: depth 14
timeout 1800

[engines]
cover: smtbmc boolector
vmt_bmc: abc bmc3

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv vec_vmt.sv
read -formal -sv vec_vmt_formal.sv
hierarchy -top vec_vmt_formal
script free_undefined.ys
prep -top vec_vmt_formal
select -assert-count 24 t:$check r:FLAVOR=assert %i
select -assert-count 9 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/vector/vec_vmt.sv
vec_vmt_formal.sv
free_undefined.ys
