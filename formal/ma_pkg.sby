[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 1

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv ma_pkg.sv
read -formal -sv line_align.sv
read -formal -sv ma_pkg_check.sv
hierarchy -top ma_pkg_check
script free_undefined.ys
prep -top ma_pkg_check
select -assert-count 18 t:$check r:FLAVOR=assert %i

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/misaligned/ma_pkg.sv
../hw/rtl/lib/line_align.sv
ma_pkg_check.sv
free_undefined.ys
