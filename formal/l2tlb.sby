[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 13
cover: mode cover
cover: depth 14

[engines]
smtbmc boolector

[script]
read -formal -sv riscv_pkg.sv
read -formal -sv l2tlb.sv
# A two-set, two-way array reaches fills, evictions and every flush form within
# the depth.
chparam -set SETS 2 -set WAYS 2 l2tlb
prep -top l2tlb

[files]
../hw/rtl/cpu_and_mem/cpu/riscv_pkg.sv
../hw/rtl/cpu_and_mem/cpu/mmu/l2tlb.sv
