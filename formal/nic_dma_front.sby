[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
read -sv nic_dma_front.sv
read -formal -sv nic_dma_front_formal.sv
hierarchy -top nic_dma_front_formal
script free_undefined.ys
prep -top nic_dma_front_formal -flatten
~cover: chformal -cover -remove
opt -fast
opt_clean -purge
select -assert-count 14 t:$check r:FLAVOR=assert %i
cover: select -assert-count 5 t:$check r:FLAVOR=cover %i

[files]
../hw/rtl/peripherals/nic/nic_dma_front.sv
nic_dma_front_formal.sv
free_undefined.ys
